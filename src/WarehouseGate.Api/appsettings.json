{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 15,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // "DefaultConnection": "Server=localhost;Port=3306;Database=WMS_1;User=root;Password=toor;ConnectionTimeout=5;"
   // "Default": "Server=localhost;Port=3306;Database=logivue_warehouse;User=root;Password=toor;ConnectionTimeout=5;"
    "Default": "Server=44.202.185.88;Port=3306;Database=warehousegate;User=gcplappuser;Password=Toor@321;Pooling=true;MinimumPoolSize=5;MaximumPoolSize=100;ConnectionLifeTime=300;ConnectionTimeout=10;"
  },
  // Key below is a dev-only placeholder, fine for local `dotnet run` - it signs nothing anyone
  // relies on. Production MUST override it with the Jwt__Key environment variable (never edit
  // this file with the real value - same reasoning as Storage__Provider above, keeps the secret
  // out of git entirely) or anyone who can read this repo can forge a token for any user/role.
  "Jwt": {
    "Key": "dev-only-signing-key-change-before-any-real-deployment-32bytes+",
    "Issuer": "WarehouseGate",
    "Audience": "WarehouseGateClients",
    "ExpiryHours": 24
  },
  "PhotoStorage": {
    "RootPath": "App_Data/photos"
  },
  // Provider: "LocalDisk" (default, used here for local dev - PhotoStorage above) or "S3".
  // On the production host, either edit Provider to "S3" below or override it with the
  // Storage__Provider=S3 environment variable (no code/file change needed) - no access keys go
  // here or anywhere else, the AWS SDK picks up the EC2/ECS instance role automatically.
  "Storage": {
    "Provider": "LocalDisk",
    "S3": {
      "BucketName": "gcpl-s3-logiflow-images-prod",
      "Region": "us-east-1"
    }
  },
  "Assistant": {
    "OllamaBaseUrl": "http://localhost:11434",
    "ModelId": "qwen2.5:7b-instruct-q4_K_M"
  }
}
