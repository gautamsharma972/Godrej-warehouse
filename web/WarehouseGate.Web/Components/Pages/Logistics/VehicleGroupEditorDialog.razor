<MudDialog>
    <DialogContent>
        <div class="admin-drawer">
            <div class="admin-drawer-header">
                <div>
                    <h2 class="admin-drawer-title">@(IsNew ? "Add Vehicle Dispatch" : IsReadOnly ? "View Vehicle Dispatch" : "Edit Vehicle Dispatch")</h2>
                    <p class="admin-drawer-subtitle">
                        @(IsReadOnly
                            ? "This dispatch has already been picked/loaded and can no longer be edited."
                            : "Maintain vehicle, shipment, route, and warehouse movement information.")
                    </p>
                </div>
                <button class="admin-drawer-close" type="button" @onclick="Cancel"><i class="bx bx-x"></i></button>
            </div>

            <div class="admin-drawer-body">
                <div class="admin-form-grid">
                    <div class="admin-form-field">
                        <label>Vehicle Number (optional)</label>
                        <input class="admin-form-control" @bind="VehicleNumber" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Inward Transaction Id</label>
                        <input class="admin-form-control" @bind="InwardTransactionId" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Transporter Name</label>
                        <input class="admin-form-control" @bind="TransporterName" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Driver Name</label>
                        <input class="admin-form-control" @bind="DriverName" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Driver Phone</label>
                        <input class="admin-form-control" @bind="DriverPhone" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Vehicle Type</label>
                        <input class="admin-form-control" @bind="VehicleType" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>Departure Date (required)</label>
                        <input class="admin-form-control" type="date" @bind="DepartureDate" disabled="@IsReadOnly" />
                    </div>
                    <div class="admin-form-field">
                        <label>From Warehouse</label>
                        <select class="admin-form-select" @bind="FromWarehouseId" disabled="@IsReadOnly">
                            <option value="0">Select warehouse</option>
                            @foreach (var warehouse in Warehouses)
                            {
                                <option value="@warehouse.Id">@warehouse.Name</option>
                            }
                        </select>
                    </div>
                    <div class="admin-form-field">
                        <label>To Warehouse</label>
                        <select class="admin-form-select" @bind="ToWarehouseId" disabled="@IsReadOnly">
                            <option value="0">Select warehouse</option>
                            @foreach (var warehouse in Warehouses)
                            {
                                <option value="@warehouse.Id">@warehouse.Name</option>
                            }
                        </select>
                    </div>
                    @if (FromWarehouseId != 0 && FromWarehouseId == ToWarehouseId)
                    {
                        <div class="admin-form-field full">
                            <p class="admin-form-error">From and To warehouse cannot be the same.</p>
                        </div>
                    }
                </div>

                <div class="admin-drawer-section-title">SKU Lines</div>
                <div class="admin-table-scroll vehicle-sku-edit-table">
                    <table class="admin-table compact">
                        <thead>
                            <tr>
                                <th>SKU (or SKU Code)</th>
                                <th>SKU Code (or SKU)</th>
                                <th>PO</th>
                                <th>Boxes (required)</th>
                                <th>ETA (required)</th>
                                @if (!IsNew)
                                {
                                    <th>Status</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td><input class="admin-form-control" @bind="row.Sku" @bind:event="oninput" disabled="@IsReadOnly" /></td>
                                    <td><input class="admin-form-control" @bind="row.SkuCode" @bind:event="oninput" disabled="@IsReadOnly" /></td>
                                    <td><input class="admin-form-control" @bind="row.PoNumber" @bind:event="oninput" disabled="@IsReadOnly" /></td>
                                    <td><input class="admin-form-control" type="number" min="0" @bind="row.BoxQuantity" disabled="@IsReadOnly" /></td>
                                    <td><input class="admin-form-control" type="date" @bind="row.EtaDateTime" disabled="@IsReadOnly" /></td>
                                    @if (!IsNew)
                                    {
                                        <td>
                                            <select class="admin-form-select" @bind="row.Status" disabled="@IsReadOnly">
                                                <option value="InTransit">In-Transit</option>
                                                <option value="InProgress">In Progress</option>
                                                <option value="Inactive">Inactive</option>
                                                <option value="Completed">Completed</option>
                                                <option value="Deleted">Deleted</option>
                                            </select>
                                        </td>
                                    }
                                    <td class="admin-actions-cell">
                                        @if (!row.Id.HasValue && !IsReadOnly)
                                        {
                                            <button class="admin-icon-btn delete" type="button" title="Remove row" disabled="@(_rows.Count == 1)" @onclick="() => RemoveRow(row)"><i class="bx bx-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!IsReadOnly)
                {
                    <button class="admin-secondary-btn vehicle-sku-add-btn" type="button" @onclick="AddRow"><i class="bx bx-plus"></i>Add SKU</button>
                }
            </div>

            <div class="admin-drawer-actions">
                @if (IsReadOnly)
                {
                    <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Close</button>
                }
                else
                {
                    <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Cancel</button>
                    <button class="admin-drawer-btn primary" type="button" @onclick="Submit" disabled="@(!CanSave)">
                        Save
                    </button>
                }
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public string VehicleNumber { get; set; } = string.Empty;
    [Parameter] public string? InwardTransactionId { get; set; }
    [Parameter] public string? TransporterName { get; set; }
    [Parameter] public string? DriverName { get; set; }
    [Parameter] public string? DriverPhone { get; set; }
    [Parameter] public string? VehicleType { get; set; }
    [Parameter] public DateTime? DepartureDate { get; set; }
    [Parameter] public int FromWarehouseId { get; set; }
    [Parameter] public int ToWarehouseId { get; set; }
    [Parameter] public List<WarehouseDto> Warehouses { get; set; } = new();
    [Parameter] public List<VehicleSkuRowModel> InitialRows { get; set; } = new();

    private List<VehicleSkuRowModel> _rows = new();
    private List<int> _originalRecordIds = new();

    protected override void OnInitialized()
    {
        _rows = InitialRows.Select(Clone).ToList();
        _originalRecordIds = InitialRows.Where(r => r.Id.HasValue).Select(r => r.Id!.Value).ToList();
        if (_rows.Count == 0)
        {
            AddRow();
        }
    }

    private static VehicleSkuRowModel Clone(VehicleSkuRowModel r) => new()
    {
        Id = r.Id,
        Sku = r.Sku,
        SkuCode = r.SkuCode,
        PoNumber = r.PoNumber,
        BoxQuantity = r.BoxQuantity,
        EtaDateTime = r.EtaDateTime,
        Status = r.Status
    };

    private void AddRow() => _rows.Add(new VehicleSkuRowModel { Status = "InTransit" });

    private void RemoveRow(VehicleSkuRowModel row)
    {
        if (_rows.Count > 1)
        {
            _rows.Remove(row);
        }
    }

    // Vehicle Number is intentionally not required here - it's normally supplied later by Office's
    // "Tag Vehicle" action. Everything else matches the Excel upload's own required fields (see
    // VehicleLogisticsExcelParser): PO Number, either SKU or SKU Code, Box Quantity, Departure
    // Date, and ETA are all mandatory per row (Departure Date is a single group-level field here).
    private bool CanSave =>
        FromWarehouseId != 0 &&
        ToWarehouseId != 0 &&
        FromWarehouseId != ToWarehouseId &&
        DepartureDate.HasValue &&
        _rows.Count > 0 &&
        _rows.All(r =>
            (!string.IsNullOrWhiteSpace(r.Sku) || !string.IsNullOrWhiteSpace(r.SkuCode)) &&
            !string.IsNullOrWhiteSpace(r.PoNumber) &&
            r.BoxQuantity > 0 &&
            r.EtaDateTime.HasValue);

    private void Submit()
    {
        var keptIds = _rows.Where(r => r.Id.HasValue).Select(r => r.Id!.Value).ToList();
        var removedIds = _originalRecordIds.Except(keptIds).ToList();

        var result = new VehicleGroupSaveResult(
            VehicleNumber.Trim(), Clean(InwardTransactionId), Clean(TransporterName), Clean(DriverName),
            Clean(DriverPhone), Clean(VehicleType),
            DepartureDate, FromWarehouseId, ToWarehouseId,
            _rows.Select(r => new VehicleSkuRowModel
            {
                Id = r.Id,
                // SKU is the identifier used everywhere downstream - fall back to SKU Code when
                // only that was given, mirroring VehicleLogisticsExcelParser's same fallback.
                Sku = string.IsNullOrWhiteSpace(r.Sku) ? r.SkuCode!.Trim() : r.Sku.Trim(),
                SkuCode = Clean(r.SkuCode),
                PoNumber = Clean(r.PoNumber),
                BoxQuantity = r.BoxQuantity,
                EtaDateTime = r.EtaDateTime,
                Status = r.Status
            }).ToList(),
            removedIds);

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
