@page "/office/dispatch-orders"
@attribute [Authorize(Roles = "Office")]
@implements IAsyncDisposable
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject OfficeRealtimeClient Realtime

<PageTitle>Dispatch Orders - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Office Operations</p>
            <h1 class="admin-page-title">Dispatch Orders</h1>
            <p class="admin-page-subtitle">Review pending outward vehicles from the Dispatch Plan and generate pick lists to start loading.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-file"></i>@(_groups?.Count ?? 0) Pending</span>
        </div>
    </div>

    @if (_groups is null)
    {
        <div class="admin-table-card">
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading dispatch plan</span></div>
        </div>
    }
    else if (_groups.Count == 0)
    {
        <div class="admin-table-card">
            <div class="admin-empty"><i class="bx bx-file"></i><span>No pending outward vehicles. New Dispatch Plan rows for your warehouse will appear here automatically.</span></div>
        </div>
    }
    else
    {
        <div class="admin-table-card">
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search vehicle or warehouse..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_warehouseFilter" ValueChanged="OnWarehouseFilterChanged" Options="_warehouseNames" AllLabel="All Warehouses" />
                </div>
            </div>
        </div>

        @if (_view.Count == 0)
        {
            <div class="admin-table-card">
                <div class="admin-empty"><i class="bx bx-file"></i><span>No pending vehicles match your search or filters.</span></div>
            </div>
        }
        else
        {
        <div class="dispatch-accordion-list">
            @foreach (var group in _view)
            {
                <details class="dispatch-card" @key="group.PoNumber ?? group.VehicleNumber">
                    <summary>
                        <div class="dispatch-card-summary office-dispatch-summary">
                            <div class="dispatch-card-vehicle">
                                <span class="admin-row-icon"><i class="bx bxs-truck"></i></span>
                                <div>
                                    <span>Vehicle</span>
                                    <strong>@(group.VehicleNumber ?? "Not yet assigned")</strong>
                                </div>
                            </div>
                            <div>
                                <span>To Warehouse</span>
                                <strong>@group.CounterpartWarehouseName</strong>
                            </div>
                            <div>
                                <span>ETA</span>
                                <strong>@(group.EtaDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</strong>
                            </div>
                            <div>
                                <span>Lines</span>
                                <strong>@group.Lines.Count line@(group.Lines.Count == 1 ? "" : "s")</strong>
                                <em>@group.Lines.Sum(EffectiveQty) total qty</em>
                            </div>
                            <div class="dispatch-card-actions">
                                <button class="admin-primary-btn" type="button"
                                        disabled="@(_generatingPoNumber is not null || group.PoNumber is null)"
                                        title="@(group.PoNumber is null ? "This dispatch row has no PO Number - fix it in Logistics before generating a pick list." : null)"
                                        @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => GeneratePickListAsync(group)">
                                    @if (_generatingPoNumber == group.PoNumber)
                                    {
                                        <i class="bx bx-loader-alt admin-spin"></i>
                                    }
                                    else
                                    {
                                        <i class="bx bx-list-check"></i>
                                    }
                                    Generate Pick List
                                </button>
                            </div>
                            <div class="dispatch-card-toggle"><i class="bx bx-chevron-down"></i></div>
                        </div>
                    </summary>

                    <div class="dispatch-card-body">
                        <div class="dispatch-sku-table-wrap">
                            <span>SKU Lines</span>
                            <div class="admin-table-scroll">
                                <table class="admin-table compact">
                                    <thead>
                                        <tr>
                                            <th>SKU</th>
                                            <th>SKU Code</th>
                                            <th>PO</th>
                                            <th>Planned Boxes</th>
                                            <th>Pick List Qty</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in group.Lines)
                                        {
                                            <tr>
                                                <td>@line.Sku</td>
                                                <td class="admin-muted">@ValueOrDash(line.SkuCode)</td>
                                                <td>@ValueOrDash(line.PoNumber)</td>
                                                <td>@line.BoxQuantity</td>
                                                <td>
                                                    <input class="admin-form-control dispatch-picklist-qty-input" type="number" min="1"
                                                           value="@EffectiveQty(line)"
                                                           disabled="@(_savingLineId == line.Id)"
                                                           @onchange="e => UpdatePickListQuantityAsync(line, e.Value)" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </details>
            }
        </div>

        <div class="admin-table-card">
            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        </div>
        }
    }
</section>

@code {
    private List<PendingDispatchPlanGroupDto>? _groups;
    private string? _generatingPoNumber;
    private int? _savingLineId;
    private string _search = string.Empty;
    private string? _warehouseFilter;
    private int _page = 1;
    private int _pageSize = 10;

    private static int EffectiveQty(PendingDispatchPlanLineDto line) => line.PickListQuantity ?? line.BoxQuantity;

    private List<string> _warehouseNames => (_groups ?? []).Select(g => g.CounterpartWarehouseName).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<PendingDispatchPlanGroupDto> Filtered => (_groups ?? [])
        .Where(g => string.IsNullOrWhiteSpace(_search) ||
            (g.VehicleNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (g.PoNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            g.CounterpartWarehouseName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(g => _warehouseFilter is null || g.CounterpartWarehouseName == _warehouseFilter);

    private int _filteredCount => Filtered.Count();
    private List<PendingDispatchPlanGroupDto> _view => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnWarehouseFilterChanged(string? value)
    {
        _warehouseFilter = value;
        _page = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        Realtime.VehicleLogisticsRecordChanged += OnVehicleLogisticsRecordChanged;
        await LoadAsync();
    }

    // See InwardJobs.razor's identical OnAfterRenderAsync for why StartAsync moved here -
    // OnInitializedAsync also runs during Blazor's prerender pass (throwaway DI scope, no real
    // circuit yet), and opening a real SignalR connection there was destabilizing the actual
    // circuit once it connected for real.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Realtime.StartAsync();
        }
    }

    // Fires both when Logistics Manager edits/uploads Dispatch Plan data and when this group gets
    // claimed (by this page or another Office session generating its pick list concurrently).
    private void OnVehicleLogisticsRecordChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        Realtime.VehicleLogisticsRecordChanged -= OnVehicleLogisticsRecordChanged;
        return ValueTask.CompletedTask;
    }

    private async Task LoadAsync()
    {
        try
        {
            _groups = await Api.GetAsync<List<PendingDispatchPlanGroupDto>>("api/office/dispatch-plan/outward/pending");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task GeneratePickListAsync(PendingDispatchPlanGroupDto group)
    {
        var poNumber = group.PoNumber!;
        _generatingPoNumber = poNumber;
        try
        {
            var job = await Api.PostAsync<OutwardJobDto>($"api/office/dispatch-plan/outward/{poNumber}/generate-picklist", new { });
            Snackbar.Add($"Pick list generated for PO {poNumber}.", Severity.Success);
            Navigation.NavigateTo($"/office/outward-jobs/{job.Id}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error, config => config.VisibleStateDuration = 8000);
        }
        finally
        {
            _generatingPoNumber = null;
        }
    }

    private async Task UpdatePickListQuantityAsync(PendingDispatchPlanLineDto line, object? rawValue)
    {
        if (!int.TryParse(rawValue?.ToString(), out var quantity) || quantity < 1)
        {
            Snackbar.Add("Pick list quantity must be a whole number of at least 1.", Severity.Error);
            await LoadAsync();
            return;
        }

        if (quantity == EffectiveQty(line))
        {
            return;
        }

        _savingLineId = line.Id;
        try
        {
            await Api.PutAsync($"api/office/dispatch-plan/outward/lines/{line.Id}/picklist-quantity", new UpdatePickListQuantityRequest(quantity));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _savingLineId = null;
        }
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
