@page "/admin/warehouses"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Warehouses - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Warehouses</h1>
            <p class="admin-page-subtitle">Configure warehouse locations, regions, and geography used across operations.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bxs-buildings"></i>@(_warehouses?.Count ?? 0) Warehouses</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)" disabled="@(!CanAdd)"><i class="bx bx-plus"></i>Add Warehouse</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_warehouses is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading warehouses</span></div>
        }
        else if (_warehouses.Count == 0)
        {
            <div class="admin-empty"><i class="bx bxs-buildings"></i><span>No warehouses found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search warehouses..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_regionFilter" ValueChanged="OnRegionFilterChanged" Options="_regionNames" AllLabel="All Regions" />
                    <AdminFilterSelect Value="@_typeFilter" ValueChanged="OnTypeFilterChanged" Options="_typeNames" AllLabel="All Types" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bxs-buildings"></i><span>No warehouses match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Type" Column="Type" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Region" Column="Region" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>State</th>
                                <th>City</th>
                                <th>Country</th>
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var warehouse in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bxs-buildings"></i></span><span>@warehouse.Name</span></div></td>
                                    <td><span class="admin-badge">@warehouse.WarehouseType</span></td>
                                    <td>@warehouse.RegionName</td>
                                    <td>@warehouse.StateName</td>
                                    <td>@warehouse.CityName</td>
                                    <td>@warehouse.CountryName</td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(warehouse)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(warehouse)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<WarehouseDto>? _warehouses;
    private List<RegionDto>? _regions;
    private List<StateDto>? _states;
    private List<CityDto>? _cities;
    private List<CountryDto>? _countries;
    private string _search = string.Empty;
    private string? _regionFilter;
    private string? _typeFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private bool CanAdd => _regions is { Count: > 0 } && _states is { Count: > 0 } && _cities is { Count: > 0 } && _countries is { Count: > 0 };
    private List<string> _regionNames => (_warehouses ?? []).Select(w => w.RegionName).Distinct().OrderBy(n => n).ToList();
    private List<string> _typeNames => (_warehouses ?? []).Select(w => w.WarehouseType).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<WarehouseDto> Filtered => (_warehouses ?? [])
        .Where(w => string.IsNullOrWhiteSpace(_search) || w.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(w => _regionFilter is null || w.RegionName == _regionFilter)
        .Where(w => _typeFilter is null || w.WarehouseType == _typeFilter);

    private IEnumerable<WarehouseDto> Sorted => _sortColumn switch
    {
        "Type" => _sortAscending
            ? Filtered.OrderBy(w => w.WarehouseType, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(w => w.WarehouseType, StringComparer.OrdinalIgnoreCase),
        "Region" => _sortAscending
            ? Filtered.OrderBy(w => w.RegionName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(w => w.RegionName, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(w => w.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<WarehouseDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnRegionFilterChanged(string? value)
    {
        _regionFilter = value;
        _page = 1;
    }

    private void OnTypeFilterChanged(string? value)
    {
        _typeFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _regions = await Api.GetAsync<List<RegionDto>>("api/admin/regions");
            _states = await Api.GetAsync<List<StateDto>>("api/admin/states");
            _cities = await Api.GetAsync<List<CityDto>>("api/admin/cities");
            _countries = await Api.GetAsync<List<CountryDto>>("api/admin/countries");
            _warehouses = await Api.GetAsync<List<WarehouseDto>>("api/admin/warehouses");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(WarehouseDto? existing)
    {
        var defaultCountryId = existing?.CountryId ?? (_countries!.FirstOrDefault(c => c.Name == "India") ?? _countries!.First()).Id;

        var parameters = new DialogParameters<WarehouseEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.WarehouseType, existing?.WarehouseType ?? "Warehouse" },
            { d => d.RegionId, existing?.RegionId ?? _regions!.First().Id },
            { d => d.CountryId, defaultCountryId },
            { d => d.StateId, existing?.StateId ?? _states!.First(s => s.CountryId == defaultCountryId).Id },
            { d => d.CityId, existing?.CityId ?? _cities!.First().Id },
            { d => d.Regions, _regions! },
            { d => d.States, _states! },
            { d => d.Cities, _cities! },
            { d => d.Countries, _countries! },
            { d => d.SlaTargetMinutes, existing?.SlaTargetMinutes },
            { d => d.DockOperatingHoursPerDay, existing?.DockOperatingHoursPerDay },
            { d => d.ShiftHoursPerDay, existing?.ShiftHoursPerDay }
        };
        var dialog = await DialogService.ShowAsync<WarehouseEditorDialog>(existing is null ? "Add Warehouse" : "Edit Warehouse", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        // Tuple literals beyond 7 elements compile to ValueTuple<T1..T7, TRest> with the tail
        // nested in Rest, so a boxed-object cast must name that exact runtime shape.
        var (name, warehouseType, regionId, stateId, cityId, countryId, slaTarget, (dockHours, shiftHours)) =
            ((string, string, int, int, int, int, int?, (decimal?, decimal?)))result.Data!;
        try
        {
            if (existing is null)
            {
                await Api.PostAsync<WarehouseDto>("api/admin/warehouses", new UpsertWarehouseRequest(name, warehouseType, regionId, stateId, cityId, countryId, slaTarget, dockHours, shiftHours));
            }
            else
            {
                await Api.PutAsync<WarehouseDto>($"api/admin/warehouses/{existing.Id}", new UpsertWarehouseRequest(name, warehouseType, regionId, stateId, cityId, countryId, slaTarget, dockHours, shiftHours));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(WarehouseDto warehouse)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete warehouse", $"Delete '{warehouse.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/warehouses/{warehouse.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
