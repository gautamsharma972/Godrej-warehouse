@page "/admin/states"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>States - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">States</h1>
            <p class="admin-page-subtitle">Organize state records under countries for warehouse address mapping.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-map-pin"></i>@(_states?.Count ?? 0) States</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)" disabled="@(_countries is null || _countries.Count == 0)">
                <i class="bx bx-plus"></i>
                Add State
            </button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_states is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading states</span></div>
        }
        else if (_states.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-map-pin"></i><span>No states found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search states..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_countryFilter" ValueChanged="OnCountryFilterChanged" Options="_countryNames" AllLabel="All Countries" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-map-pin"></i><span>No states match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Country" Column="Country" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var state in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-map-pin"></i></span><span>@state.Name</span></div></td>
                                    <td><span class="admin-badge">@state.CountryName</span></td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(state)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(state)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<StateDto>? _states;
    private List<CountryDto>? _countries;
    private string _search = string.Empty;
    private string? _countryFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<string> _countryNames => (_countries ?? []).Select(c => c.Name).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<StateDto> Filtered => (_states ?? [])
        .Where(s => string.IsNullOrWhiteSpace(_search) || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(s => _countryFilter is null || s.CountryName == _countryFilter);

    private IEnumerable<StateDto> Sorted => _sortColumn switch
    {
        "Country" => _sortAscending
            ? Filtered.OrderBy(s => s.CountryName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(s => s.CountryName, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(s => s.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<StateDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _countries = await Api.GetAsync<List<CountryDto>>("api/admin/countries");
            _states = await Api.GetAsync<List<StateDto>>("api/admin/states");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnCountryFilterChanged(string? value)
    {
        _countryFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task OpenEditor(StateDto? existing)
    {
        var parameters = new DialogParameters<StateEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.CountryId, existing?.CountryId ?? _countries!.First().Id },
            { d => d.Countries, _countries! }
        };
        var dialog = await DialogService.ShowAsync<StateEditorDialog>(existing is null ? "Add State" : "Edit State", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, int> data)
        {
            return;
        }

        var (name, countryId) = data;
        try
        {
            if (existing is null)
            {
                await Api.PostAsync<StateDto>("api/admin/states", new UpsertStateRequest(name, countryId));
            }
            else
            {
                await Api.PutAsync<StateDto>($"api/admin/states/{existing.Id}", new UpsertStateRequest(name, countryId));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(StateDto state)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete state", $"Delete '{state.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/states/{state.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
