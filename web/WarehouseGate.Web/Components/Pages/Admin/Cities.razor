@page "/admin/cities"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Cities - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Cities</h1>
            <p class="admin-page-subtitle">Maintain city records linked to states for warehouse location setup.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-buildings"></i>@(_cities?.Count ?? 0) Cities</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)" disabled="@(_states is null || _states.Count == 0)">
                <i class="bx bx-plus"></i>
                Add City
            </button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_cities is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading cities</span></div>
        }
        else if (_cities.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-buildings"></i><span>No cities found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search cities..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_stateFilter" ValueChanged="OnStateFilterChanged" Options="_stateNames" AllLabel="All States" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-buildings"></i><span>No cities match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="State" Column="State" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var city in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-buildings"></i></span><span>@city.Name</span></div></td>
                                    <td><span class="admin-badge">@city.StateName</span></td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(city)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(city)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<CityDto>? _cities;
    private List<StateDto>? _states;
    private string _search = string.Empty;
    private string? _stateFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<string> _stateNames => (_states ?? []).Select(s => s.Name).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<CityDto> Filtered => (_cities ?? [])
        .Where(c => string.IsNullOrWhiteSpace(_search) || c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(c => _stateFilter is null || c.StateName == _stateFilter);

    private IEnumerable<CityDto> Sorted => _sortColumn switch
    {
        "State" => _sortAscending
            ? Filtered.OrderBy(c => c.StateName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(c => c.StateName, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<CityDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _states = await Api.GetAsync<List<StateDto>>("api/admin/states");
            _cities = await Api.GetAsync<List<CityDto>>("api/admin/cities");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnStateFilterChanged(string? value)
    {
        _stateFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task OpenEditor(CityDto? existing)
    {
        var parameters = new DialogParameters<CityEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.StateId, existing?.StateId ?? _states!.First().Id },
            { d => d.States, _states! }
        };
        var dialog = await DialogService.ShowAsync<CityEditorDialog>(existing is null ? "Add City" : "Edit City", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, int> data)
        {
            return;
        }

        var (name, stateId) = data;
        try
        {
            if (existing is null)
            {
                await Api.PostAsync<CityDto>("api/admin/cities", new UpsertCityRequest(name, stateId));
            }
            else
            {
                await Api.PutAsync<CityDto>($"api/admin/cities/{existing.Id}", new UpsertCityRequest(name, stateId));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(CityDto city)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete city", $"Delete '{city.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/cities/{city.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
