@page "/admin/countries"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Countries - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Countries</h1>
            <p class="admin-page-subtitle">Maintain the country master used by warehouse locations and downstream geography.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-map"></i>@(_countries?.Count ?? 0) Countries</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)">
                <i class="bx bx-plus"></i>
                Add Country
            </button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_countries is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading countries</span></div>
        }
        else if (_countries.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-map"></i><span>No countries found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search countries..." />
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-map"></i><span>No countries match your search.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var country in _view)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-name-cell">
                                            <span class="admin-row-icon"><i class="bx bx-map"></i></span>
                                            <span>@country.Name</span>
                                        </div>
                                    </td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(country)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(country)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<CountryDto>? _countries;
    private string _search = string.Empty;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private IEnumerable<CountryDto> Filtered => (_countries ?? [])
        .Where(c => string.IsNullOrWhiteSpace(_search) || c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CountryDto> Sorted => _sortAscending
        ? Filtered.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
        : Filtered.OrderByDescending(c => c.Name, StringComparer.OrdinalIgnoreCase);

    private int _filteredCount => Filtered.Count();
    private List<CountryDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _countries = await Api.GetAsync<List<CountryDto>>("api/admin/countries");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task OpenEditor(CountryDto? existing)
    {
        var parameters = new DialogParameters<CountryEditorDialog> { { d => d.Name, existing?.Name ?? string.Empty } };
        var dialog = await DialogService.ShowAsync<CountryEditorDialog>(existing is null ? "Add Country" : "Edit Country", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string name)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.PostAsync<CountryDto>("api/admin/countries", new UpsertCountryRequest(name));
            }
            else
            {
                await Api.PutAsync<CountryDto>($"api/admin/countries/{existing.Id}", new UpsertCountryRequest(name));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(CountryDto country)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete country", $"Delete '{country.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/countries/{country.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
