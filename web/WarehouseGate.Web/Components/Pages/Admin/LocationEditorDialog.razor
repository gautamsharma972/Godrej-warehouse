<MudDialog>
    <DialogContent>
    <div class="admin-drawer">
        <div class="admin-drawer-header">
            <div><h2 class="admin-drawer-title">Location Details</h2><p class="admin-drawer-subtitle">Map this location to its region, state, and city.</p></div>
            <button class="admin-drawer-close" type="button" @onclick="Cancel"><i class="bx bx-x"></i></button>
        </div>
        <div class="admin-drawer-body">
            <div class="admin-form-grid">
                <div class="admin-form-field full"><label>Name</label><input class="admin-form-control" @bind="Name" @bind:event="oninput" /></div>
                <div class="admin-form-field"><label>Region</label><select class="admin-form-select" @bind="RegionId">@foreach (var region in Regions){<option value="@region.Id">@region.Name</option>}</select></div>
                <div class="admin-form-field"><label>State</label><select class="admin-form-select" value="@StateId" @onchange="OnStateChanged">@foreach (var state in States){<option value="@state.Id">@state.Name</option>}</select></div>
                <div class="admin-form-field"><label>City</label><select class="admin-form-select" @bind="CityId">@foreach (var city in Cities.Where(c => c.StateId == StateId)){<option value="@city.Id">@city.Name</option>}</select></div>
            </div>
        </div>
        <div class="admin-drawer-actions">
            <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Cancel</button>
            <button class="admin-drawer-btn primary" type="button" @onclick="Submit" disabled="@(string.IsNullOrWhiteSpace(Name) || RegionId == 0 || StateId == 0 || CityId == 0)">Save</button>
        </div>
    </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public int RegionId { get; set; }
    [Parameter] public int StateId { get; set; }
    [Parameter] public int CityId { get; set; }
    [Parameter] public List<RegionDto> Regions { get; set; } = new();
    [Parameter] public List<StateDto> States { get; set; } = new();
    [Parameter] public List<CityDto> Cities { get; set; } = new();

    private void OnStateChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var stateId))
        {
            StateId = stateId;
            CityId = Cities.FirstOrDefault(c => c.StateId == StateId)?.Id ?? 0;
        }
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(new UpsertLocationRequest(Name.Trim(), RegionId, StateId, CityId)));
    private void Cancel() => MudDialog.Cancel();
}
