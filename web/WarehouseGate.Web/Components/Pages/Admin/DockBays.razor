@page "/admin/dock-bays"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Dock Bays - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Dock Bays</h1>
            <p class="admin-page-subtitle">Define per-warehouse dock bays used for gate-in bay assignment and dock utilization reporting.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-dock-top"></i>@(_bays?.Count ?? 0) Dock Bays</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)" disabled="@(!CanAdd)"><i class="bx bx-plus"></i>Add Dock Bay</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_bays is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading dock bays</span></div>
        }
        else if (_bays.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-dock-top"></i><span>No dock bays found. Warehouses without a bay master fall back to free-text bay entry on mobile.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search dock bays..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_warehouseFilter" ValueChanged="OnWarehouseFilterChanged" Options="_warehouseNames" AllLabel="All Warehouses" />
                    <AdminFilterSelect Value="@_statusFilter" ValueChanged="OnStatusFilterChanged" Options="_statusOptions" AllLabel="All Statuses" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-dock-top"></i><span>No dock bays match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Warehouse" Column="Warehouse" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Bay Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Status" Column="Status" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bay in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-dock-top"></i></span><span>@bay.WarehouseName</span></div></td>
                                    <td>@bay.Name</td>
                                    <td><span class="admin-badge @(bay.IsActive ? "success" : "warning")">@(bay.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(bay)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(bay)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<DockBayDto>? _bays;
    private List<WarehouseDto>? _warehouses;
    private string _search = string.Empty;
    private string? _warehouseFilter;
    private string? _statusFilter;
    private string _sortColumn = "Warehouse";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private static readonly List<string> _statusOptions = new() { "Active", "Inactive" };

    private bool CanAdd => _warehouses is { Count: > 0 };
    private List<string> _warehouseNames => (_bays ?? []).Select(b => b.WarehouseName).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<DockBayDto> Filtered => (_bays ?? [])
        .Where(b => string.IsNullOrWhiteSpace(_search) ||
            b.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            b.WarehouseName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(b => _warehouseFilter is null || b.WarehouseName == _warehouseFilter)
        .Where(b => _statusFilter is null || (_statusFilter == "Active") == b.IsActive);

    private IEnumerable<DockBayDto> Sorted => _sortColumn switch
    {
        "Name" => _sortAscending
            ? Filtered.OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(b => b.Name, StringComparer.OrdinalIgnoreCase),
        "Status" => _sortAscending
            ? Filtered.OrderBy(b => b.IsActive)
            : Filtered.OrderByDescending(b => b.IsActive),
        _ => _sortAscending
            ? Filtered.OrderBy(b => b.WarehouseName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(b => b.WarehouseName, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<DockBayDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnWarehouseFilterChanged(string? value)
    {
        _warehouseFilter = value;
        _page = 1;
    }

    private void OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _warehouses = await Api.GetAsync<List<WarehouseDto>>("api/admin/warehouses");
            _bays = await Api.GetAsync<List<DockBayDto>>("api/admin/dock-bays");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(DockBayDto? existing)
    {
        var parameters = new DialogParameters<DockBayEditorDialog>
        {
            { d => d.WarehouseId, existing?.WarehouseId ?? _warehouses!.First().Id },
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.IsActive, existing?.IsActive ?? true },
            { d => d.Warehouses, _warehouses! }
        };
        var dialog = await DialogService.ShowAsync<DockBayEditorDialog>(existing is null ? "Add Dock Bay" : "Edit Dock Bay", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<int, string, bool> data)
        {
            return;
        }

        var (warehouseId, name, isActive) = data;
        try
        {
            if (existing is null)
            {
                await Api.PostAsync<DockBayDto>("api/admin/dock-bays", new UpsertDockBayRequest(warehouseId, name, isActive));
            }
            else
            {
                await Api.PutAsync<DockBayDto>($"api/admin/dock-bays/{existing.Id}", new UpsertDockBayRequest(warehouseId, name, isActive));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(DockBayDto bay)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete dock bay", $"Delete '{bay.Name}' from {bay.WarehouseName}?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/dock-bays/{bay.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
