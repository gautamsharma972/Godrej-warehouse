@page "/admin/transporters"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Transporters - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Transporters</h1>
            <p class="admin-page-subtitle">Manage transport partner details used for vehicle and dispatch operations.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-transfer"></i>@(_transporters?.Count ?? 0) Transporters</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)"><i class="bx bx-plus"></i>Add Transporter</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_transporters is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading transporters</span></div>
        }
        else if (_transporters.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-transfer"></i><span>No transporters found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search transporters..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_statusFilter" ValueChanged="OnStatusFilterChanged" Options="_statusOptions" AllLabel="All Statuses" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-transfer"></i><span>No transporters match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Contact Phone</th>
                                <AdminSortHeader Label="Status" Column="Status" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transporter in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-transfer"></i></span><span>@transporter.Name</span></div></td>
                                    <td class="admin-muted">@(!string.IsNullOrWhiteSpace(transporter.ContactPhone) ? transporter.ContactPhone : "-")</td>
                                    <td><span class="admin-badge @(transporter.IsActive ? "success" : "warning")">@(transporter.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(transporter)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(transporter)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<TransporterDto>? _transporters;
    private string _search = string.Empty;
    private string? _statusFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private static readonly List<string> _statusOptions = new() { "Active", "Inactive" };

    private IEnumerable<TransporterDto> Filtered => (_transporters ?? [])
        .Where(t => string.IsNullOrWhiteSpace(_search) ||
            t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            (t.ContactPhone ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(t => _statusFilter is null || (_statusFilter == "Active") == t.IsActive);

    private IEnumerable<TransporterDto> Sorted => _sortColumn switch
    {
        "Status" => _sortAscending
            ? Filtered.OrderBy(t => t.IsActive)
            : Filtered.OrderByDescending(t => t.IsActive),
        _ => _sortAscending
            ? Filtered.OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(t => t.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<TransporterDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _transporters = await Api.GetAsync<List<TransporterDto>>("api/admin/transporters");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(TransporterDto? existing)
    {
        var parameters = new DialogParameters<TransporterEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.ContactPhone, existing?.ContactPhone },
            { d => d.IsActive, existing?.IsActive ?? true }
        };
        var dialog = await DialogService.ShowAsync<TransporterEditorDialog>(existing is null ? "Add Transporter" : "Edit Transporter", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ValueTuple<string, string?, bool> data)
        {
            return;
        }

        var (name, contactPhone, isActive) = data;
        try
        {
            if (existing is null)
            {
                await Api.PostAsync<TransporterDto>("api/admin/transporters", new UpsertTransporterRequest(name, contactPhone, isActive));
            }
            else
            {
                await Api.PutAsync<TransporterDto>($"api/admin/transporters/{existing.Id}", new UpsertTransporterRequest(name, contactPhone, isActive));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(TransporterDto transporter)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete transporter", $"Delete '{transporter.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/transporters/{transporter.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
