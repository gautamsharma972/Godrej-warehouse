@page "/admin/vehicles"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Vehicle Masters - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Vehicle Masters</h1>
            <p class="admin-page-subtitle">Maintain vehicle capacity profiles by type and category.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bxs-truck"></i>@(_masters?.Count ?? 0) Profiles</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)"><i class="bx bx-plus"></i>Add Profile</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_masters is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading vehicles</span></div>
        }
        else if (_masters.Count == 0)
        {
            <div class="admin-empty"><i class="bx bxs-truck"></i><span>No vehicle profiles found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search vehicle profiles..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_typeFilter" ValueChanged="OnTypeFilterChanged" Options="_typeNames" AllLabel="All Types" />
                    <AdminFilterSelect Value="@_categoryFilter" ValueChanged="OnCategoryFilterChanged" Options="_categoryNames" AllLabel="All Categories" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bxs-truck"></i><span>No vehicle profiles match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Vehicle Type" Column="Type" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Vehicle Category" Column="Category" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Max Weight" Column="Weight" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>L x W x H</th>
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var master in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bxs-truck"></i></span><span>@master.VehicleTypeName</span></div></td>
                                    <td>@master.VehicleCategoryName</td>
                                    <td>@FormatWeight(master.MaxWeightKg)</td>
                                    <td>@FormatDimensions(master)</td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(master)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(master)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<VehicleMasterFullDto>? _masters;
    private List<VehicleTypeDto> _vehicleTypes = [];
    private List<VehicleCategoryDto> _vehicleCategories = [];
    private string _search = string.Empty;
    private string? _typeFilter;
    private string? _categoryFilter;
    private string _sortColumn = "Type";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<string> _typeNames => (_masters ?? []).Select(m => m.VehicleTypeName).Distinct().OrderBy(n => n).ToList();
    private List<string> _categoryNames => (_masters ?? []).Select(m => m.VehicleCategoryName).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<VehicleMasterFullDto> Filtered => (_masters ?? [])
        .Where(m => string.IsNullOrWhiteSpace(_search) ||
            m.VehicleTypeName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            m.VehicleCategoryName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(m => _typeFilter is null || m.VehicleTypeName == _typeFilter)
        .Where(m => _categoryFilter is null || m.VehicleCategoryName == _categoryFilter);

    private IEnumerable<VehicleMasterFullDto> Sorted => _sortColumn switch
    {
        "Category" => _sortAscending
            ? Filtered.OrderBy(m => m.VehicleCategoryName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(m => m.VehicleCategoryName, StringComparer.OrdinalIgnoreCase),
        "Weight" => _sortAscending
            ? Filtered.OrderBy(m => m.MaxWeightKg ?? 0)
            : Filtered.OrderByDescending(m => m.MaxWeightKg ?? 0),
        _ => _sortAscending
            ? Filtered.OrderBy(m => m.VehicleTypeName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(m => m.VehicleTypeName, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<VehicleMasterFullDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnTypeFilterChanged(string? value)
    {
        _typeFilter = value;
        _page = 1;
    }

    private void OnCategoryFilterChanged(string? value)
    {
        _categoryFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _vehicleTypes = await Api.GetAsync<List<VehicleTypeDto>>("api/admin/vehicle-types") ?? [];
            _vehicleCategories = await Api.GetAsync<List<VehicleCategoryDto>>("api/admin/vehicle-categories") ?? [];
            _masters = await Api.GetAsync<List<VehicleMasterFullDto>>("api/admin/vehicle-masters");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(VehicleMasterFullDto? existing)
    {
        var parameters = new DialogParameters<VehicleMasterEditorDialog>
        {
            { d => d.VehicleTypeId, existing?.VehicleTypeId ?? _vehicleTypes.FirstOrDefault()?.Id ?? 0 },
            { d => d.VehicleCategoryId, existing?.VehicleCategoryId ?? _vehicleCategories.FirstOrDefault()?.Id ?? 0 },
            { d => d.VehicleTypes, _vehicleTypes },
            { d => d.VehicleCategories, _vehicleCategories },
            { d => d.MaxWeightKg, existing?.MaxWeightKg },
            { d => d.LengthCm, existing?.LengthCm },
            { d => d.WidthCm, existing?.WidthCm },
            { d => d.HeightCm, existing?.HeightCm }
        };
        var dialog = await DialogService.ShowAsync<VehicleMasterEditorDialog>(existing is null ? "Add Vehicle Profile" : "Edit Vehicle Profile", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpsertVehicleMasterRequest request)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.PostAsync<VehicleMasterFullDto>("api/admin/vehicle-masters", request);
            }
            else
            {
                await Api.PutAsync<VehicleMasterFullDto>($"api/admin/vehicle-masters/{existing.Id}", request);
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(VehicleMasterFullDto master)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete vehicle profile", $"Delete '{master.VehicleTypeName} / {master.VehicleCategoryName}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/vehicle-masters/{master.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string FormatWeight(decimal? weight) => weight is null ? "-" : $"{weight:0.##} kg";

    private static string FormatDimensions(VehicleMasterFullDto master) =>
        master.LengthCm is null || master.WidthCm is null || master.HeightCm is null
            ? "-"
            : $"{master.LengthCm:0.##} x {master.WidthCm:0.##} x {master.HeightCm:0.##} cm";
}
