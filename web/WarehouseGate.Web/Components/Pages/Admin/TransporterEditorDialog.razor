<MudDialog>
    <DialogContent>
    <div class="admin-drawer">
        <div class="admin-drawer-header">
            <div><h2 class="admin-drawer-title">Transporter Details</h2><p class="admin-drawer-subtitle">Maintain partner contact and active status.</p></div>
            <button class="admin-drawer-close" type="button" @onclick="Cancel"><i class="bx bx-x"></i></button>
        </div>
        <div class="admin-drawer-body">
            <div class="admin-form-grid">
                <div class="admin-form-field"><label>Name</label><input class="admin-form-control" @bind="Name" @bind:event="oninput" /></div>
                <div class="admin-form-field"><label>Contact Phone</label><input class="admin-form-control" @bind="ContactPhone" @bind:event="oninput" /></div>
                <label class="admin-form-check"><input type="checkbox" @bind="IsActive" /> Active</label>
            </div>
        </div>
        <div class="admin-drawer-actions">
            <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Cancel</button>
            <button class="admin-drawer-btn primary" type="button" @onclick="Submit" disabled="@string.IsNullOrWhiteSpace(Name)">Save</button>
        </div>
    </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? ContactPhone { get; set; }

    [Parameter]
    public bool IsActive { get; set; } = true;

    private void Submit() => MudDialog.Close(DialogResult.Ok((Name.Trim(), ContactPhone, IsActive)));
    private void Cancel() => MudDialog.Cancel();
}
