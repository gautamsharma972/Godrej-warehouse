<MudDialog>
    <DialogContent>
    <div class="admin-drawer">
        <div class="admin-drawer-header">
            <div><h2 class="admin-drawer-title">City Details</h2><p class="admin-drawer-subtitle">Assign the city to its state.</p></div>
            <button class="admin-drawer-close" type="button" @onclick="Cancel"><i class="bx bx-x"></i></button>
        </div>
        <div class="admin-drawer-body">
            <div class="admin-form-grid">
                <div class="admin-form-field"><label>Name</label><input class="admin-form-control" @bind="Name" @bind:event="oninput" /></div>
                <div class="admin-form-field">
                    <label>State</label>
                    <select class="admin-form-select" @bind="StateId">
                        @foreach (var state in States)
                        {
                            <option value="@state.Id">@state.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="admin-drawer-actions">
            <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Cancel</button>
            <button class="admin-drawer-btn primary" type="button" @onclick="Submit" disabled="@(string.IsNullOrWhiteSpace(Name) || StateId == 0)">Save</button>
        </div>
    </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int StateId { get; set; }

    [Parameter]
    public List<StateDto> States { get; set; } = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok((Name.Trim(), StateId)));
    private void Cancel() => MudDialog.Cancel();
}
