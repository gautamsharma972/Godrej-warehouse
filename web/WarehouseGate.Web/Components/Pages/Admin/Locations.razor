@page "/admin/locations"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Locations - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Locations</h1>
            <p class="admin-page-subtitle">Maintain operational locations mapped to region, state, and city.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-map-pin"></i>@(_locations?.Count ?? 0) Locations</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)" disabled="@(!CanAdd)"><i class="bx bx-plus"></i>Add Location</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_locations is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading locations</span></div>
        }
        else if (_locations.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-map-pin"></i><span>No locations found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search locations..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_regionFilter" ValueChanged="OnRegionFilterChanged" Options="_regionNames" AllLabel="All Regions" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-map-pin"></i><span>No locations match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Region" Column="Region" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="State" Column="State" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="City" Column="City" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var location in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-map-pin"></i></span><span>@location.Name</span></div></td>
                                    <td>@location.RegionName</td>
                                    <td>@location.StateName</td>
                                    <td>@location.CityName</td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(location)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(location)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<LocationDto>? _locations;
    private List<RegionDto>? _regions;
    private List<StateDto>? _states;
    private List<CityDto>? _cities;
    private string _search = string.Empty;
    private string? _regionFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private bool CanAdd => _regions is { Count: > 0 } && _states is { Count: > 0 } && _cities is { Count: > 0 };
    private List<string> _regionNames => (_regions ?? []).Select(r => r.Name).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<LocationDto> Filtered => (_locations ?? [])
        .Where(l => string.IsNullOrWhiteSpace(_search) || l.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(l => _regionFilter is null || l.RegionName == _regionFilter);

    private IEnumerable<LocationDto> Sorted => _sortColumn switch
    {
        "Region" => _sortAscending
            ? Filtered.OrderBy(l => l.RegionName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(l => l.RegionName, StringComparer.OrdinalIgnoreCase),
        "State" => _sortAscending
            ? Filtered.OrderBy(l => l.StateName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(l => l.StateName, StringComparer.OrdinalIgnoreCase),
        "City" => _sortAscending
            ? Filtered.OrderBy(l => l.CityName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(l => l.CityName, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(l => l.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<LocationDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _regions = await Api.GetAsync<List<RegionDto>>("api/admin/regions");
            _states = await Api.GetAsync<List<StateDto>>("api/admin/states");
            _cities = await Api.GetAsync<List<CityDto>>("api/admin/cities");
            _locations = await Api.GetAsync<List<LocationDto>>("api/admin/locations");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnRegionFilterChanged(string? value)
    {
        _regionFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task OpenEditor(LocationDto? existing)
    {
        var stateId = existing?.StateId ?? _states!.First().Id;
        var cityId = existing?.CityId ?? _cities!.First(c => c.StateId == stateId).Id;

        var parameters = new DialogParameters<LocationEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.RegionId, existing?.RegionId ?? _regions!.First().Id },
            { d => d.StateId, stateId },
            { d => d.CityId, cityId },
            { d => d.Regions, _regions! },
            { d => d.States, _states! },
            { d => d.Cities, _cities! }
        };

        var dialog = await DialogService.ShowAsync<LocationEditorDialog>(existing is null ? "Add Location" : "Edit Location", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpsertLocationRequest request)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.PostAsync<LocationDto>("api/admin/locations", request);
            }
            else
            {
                await Api.PutAsync<LocationDto>($"api/admin/locations/{existing.Id}", request);
            }

            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(LocationDto location)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete location", $"Delete '{location.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/locations/{location.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
