@page "/admin/products"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Products - WarehouseGate</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Master Data</p>
            <h1 class="admin-page-title">Products</h1>
            <p class="admin-page-subtitle">Maintain SKU dimensions, weight, stacking rules, and visual identifiers.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-package"></i>@(_products?.Count ?? 0) Products</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)"><i class="bx bx-plus"></i>Add Product</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_products is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading products</span></div>
        }
        else if (_products.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-package"></i><span>No products found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search products..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_categoryFilter" ValueChanged="OnCategoryFilterChanged" Options="_categoryNames" AllLabel="All Categories" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-package"></i><span>No products match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="SKU Code" Column="Sku" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Dimensions</th>
                                <AdminSortHeader Label="Weight" Column="Weight" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Category" Column="Category" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Stackable</th>
                                <th>Max Layers</th>
                                <th>Color</th>
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in _view)
                            {
                                <tr>
                                    <td><span class="admin-badge">@product.SkuCode</span></td>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-package"></i></span><span>@product.Name</span></div></td>
                                    <td>@product.LengthCm x @product.WidthCm x @product.HeightCm cm</td>
                                    <td>@product.WeightKg kg</td>
                                    <td>@product.Category</td>
                                    <td><span class="admin-badge @(product.IsStackable ? "success" : "warning")">@(product.IsStackable ? "Yes" : "No")</span></td>
                                    <td>@product.MaxStackLayers</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(product.ColorHex))
                                        {
                                            <span class="admin-color-swatch" style="background:@product.ColorHex"></span>
                                        }
                                        else
                                        {
                                            <span class="admin-muted">-</span>
                                        }
                                    </td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(product)"><i class="bx bx-edit"></i></button>
                                        <button class="admin-icon-btn delete" type="button" title="Delete" @onclick="() => DeleteAsync(product)"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<ProductDto>? _products;
    private string _search = string.Empty;
    private string? _categoryFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<string> _categoryNames => (_products ?? []).Select(p => p.Category).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<ProductDto> Filtered => (_products ?? [])
        .Where(p => string.IsNullOrWhiteSpace(_search) ||
            p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            p.SkuCode.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(p => _categoryFilter is null || p.Category == _categoryFilter);

    private IEnumerable<ProductDto> Sorted => _sortColumn switch
    {
        "Sku" => _sortAscending
            ? Filtered.OrderBy(p => p.SkuCode, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(p => p.SkuCode, StringComparer.OrdinalIgnoreCase),
        "Weight" => _sortAscending ? Filtered.OrderBy(p => p.WeightKg) : Filtered.OrderByDescending(p => p.WeightKg),
        "Category" => _sortAscending
            ? Filtered.OrderBy(p => p.Category, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(p => p.Category, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(p => p.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<ProductDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnCategoryFilterChanged(string? value)
    {
        _categoryFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _products = await Api.GetAsync<List<ProductDto>>("api/admin/products");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(ProductDto? existing)
    {
        var parameters = new DialogParameters<ProductEditorDialog>
        {
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.SkuCode, existing?.SkuCode ?? string.Empty },
            { d => d.WeightKg, existing?.WeightKg ?? 0m },
            { d => d.LengthCm, existing?.LengthCm ?? 0m },
            { d => d.WidthCm, existing?.WidthCm ?? 0m },
            { d => d.HeightCm, existing?.HeightCm ?? 0m },
            { d => d.Category, existing?.Category ?? "Medium" },
            { d => d.IsStackable, existing?.IsStackable ?? true },
            { d => d.MaxStackLayers, existing?.MaxStackLayers ?? 99 },
            { d => d.ColorHex, existing?.ColorHex }
        };
        var dialog = await DialogService.ShowAsync<ProductEditorDialog>(existing is null ? "Add Product" : "Edit Product", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpsertProductRequest request)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.PostAsync<ProductDto>("api/admin/products", request);
            }
            else
            {
                await Api.PutAsync<ProductDto>($"api/admin/products/{existing.Id}", request);
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(ProductDto product)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete product", $"Delete '{product.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync($"api/admin/products/{product.Id}");
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
