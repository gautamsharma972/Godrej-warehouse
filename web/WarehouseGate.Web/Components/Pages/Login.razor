@page "/login"
@layout Layout.MainLayout

<PageTitle>Login - WarehouseGate</PageTitle>

<main class="login-shell">
    <section class="login-brand" aria-label="WarehouseGate overview">
        <div class="brand-mark" aria-hidden="true">
            <span>WG</span>
        </div>

        <div class="brand-copy">
            <p class="eyebrow">Godrej Warehouse Operations</p>
            <h1>WarehouseGate Portal</h1>
            <p class="brand-summary">
                Secure access for management, logistics, and office teams coordinating gated warehouse movement.
            </p>
        </div>

        <div class="operations-panel">
            <div class="panel-header">
                <span>Operations Console</span>
                <strong>Live</strong>
            </div>
            <div class="signal-grid" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <dl class="trust-list">
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Timeline" Class="trust-icon" aria-hidden="true" />
                    <dt>Workflow pace</dt>
                    <dd>Balanced daily movement planning</dd>
                </div>
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="trust-icon" aria-hidden="true" />
                    <dt>Yard visibility</dt>
                    <dd>Clear context across active gates</dd>
                </div>
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Groups" Class="trust-icon" aria-hidden="true" />
                    <dt>Team handoff</dt>
                    <dd>Smoother coordination between shifts</dd>
                </div>
            </dl>
        </div>
    </section>

    <section class="login-panel" aria-label="Sign in">
        <div class="login-card">
            <div class="card-header">
                <div>
                    <p class="eyebrow">Enterprise sign in</p>
                    <h2>Welcome back</h2>
                </div>
                <span class="secure-badge">Secure</span>
            </div>

            <p class="card-intro">
                Use your assigned WarehouseGate account to continue.
            </p>

            @if (ErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="login-alert">
                    @ErrorMessage
                </MudAlert>
            }

            <form method="post" action="/login-handler" class="login-form">
                <div class="field-group">
                    <label for="userName">Username</label>
                    <div class="input-wrap">
                        <span class="input-icon-shell" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="input-icon" />
                        </span>
                        <input id="userName" name="userName" autocomplete="username" placeholder="Enter your username" autofocus />
                    </div>
                </div>

                <div class="field-group">
                    <div class="label-row">
                        <label for="password">Password</label>
                        <a href="mailto:it-support@godrej.com?subject=WarehouseGate%20password%20support">Forgot password?</a>
                    </div>
                    <div class="input-wrap">
                        <span class="input-icon-shell" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="input-icon" />
                        </span>
                        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-option">
                        <input type="checkbox" name="rememberUser" value="true" />
                        <span>Remember username</span>
                    </label>
                    <span class="network-note">Private network recommended</span>
                </div>

                <button type="submit" class="login-button">
                    <span>Log in</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Class="button-icon" aria-hidden="true" />
                </button>
            </form>

            <div class="login-footer">
                <span>Need access?</span>
                <a href="mailto:it-support@godrej.com?subject=WarehouseGate%20portal%20access">Contact IT support</a>
            </div>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "invalid" => "Invalid username or password.",
        "connect" => "Could not reach the server. Check your connection and try again.",
        "role" => "This account isn't provisioned for the web portal.",
        _ => null
    };
}
