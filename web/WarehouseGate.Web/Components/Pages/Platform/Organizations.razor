@page "/platform/organizations"
@attribute [Authorize(Roles = "PlatformAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Organizations - WarehouseGate Platform</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Platform</p>
            <h1 class="admin-page-title">Organizations</h1>
            <p class="admin-page-subtitle">Create tenant organizations, set their user/warehouse limits, and provision each one's first SuperAdmin.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-buildings"></i>@(_organizations?.Count ?? 0) Organizations</span>
            <button class="admin-primary-btn" type="button" @onclick="() => OpenEditor(null)"><i class="bx bx-plus"></i>Add Organization</button>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_organizations is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading organizations</span></div>
        }
        else if (_organizations.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-buildings"></i><span>No organizations found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search organizations..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_statusFilter" ValueChanged="OnStatusFilterChanged" Options="_statusOptions" AllLabel="All Statuses" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-buildings"></i><span>No organizations match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Name" Column="Name" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Code</th>
                                <AdminSortHeader Label="Status" Column="Status" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Users</th>
                                <th>Warehouses</th>
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var org in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-buildings"></i></span><span>@org.Name</span></div></td>
                                    <td class="admin-muted">@org.Code</td>
                                    <td><span class="admin-badge @(org.IsActive ? "success" : "warning")">@(org.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@org.UserCount@(org.MaxUsers > 0 ? $" / {org.MaxUsers}" : "")</td>
                                    <td>@org.WarehouseCount@(org.MaxWarehouses > 0 ? $" / {org.MaxWarehouses}" : "")</td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Edit" @onclick="() => OpenEditor(org)"><i class="bx bx-edit"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<OrganizationDto>? _organizations;
    private string _search = string.Empty;
    private string? _statusFilter;
    private string _sortColumn = "Name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private static readonly List<string> _statusOptions = new() { "Active", "Inactive" };

    private IEnumerable<OrganizationDto> Filtered => (_organizations ?? [])
        .Where(o => string.IsNullOrWhiteSpace(_search) ||
            o.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            o.Code.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(o => _statusFilter is null || (_statusFilter == "Active") == o.IsActive);

    private IEnumerable<OrganizationDto> Sorted => _sortColumn switch
    {
        "Status" => _sortAscending
            ? Filtered.OrderBy(o => o.IsActive)
            : Filtered.OrderByDescending(o => o.IsActive),
        _ => _sortAscending
            ? Filtered.OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(o => o.Name, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<OrganizationDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _organizations = await Api.GetAsync<List<OrganizationDto>>("api/platform/organizations");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditor(OrganizationDto? existing)
    {
        var parameters = new DialogParameters<OrganizationEditorDialog>
        {
            { d => d.IsEdit, existing is not null },
            { d => d.Name, existing?.Name ?? string.Empty },
            { d => d.Code, existing?.Code ?? string.Empty },
            { d => d.IsActive, existing?.IsActive ?? true },
            { d => d.MaxUsers, existing?.MaxUsers ?? 0 },
            { d => d.MaxWarehouses, existing?.MaxWarehouses ?? 0 }
        };
        var dialog = await DialogService.ShowAsync<OrganizationEditorDialog>(existing is null ? "Add Organization" : "Edit Organization", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                if (result.Data is not OrganizationCreateResult create)
                {
                    return;
                }
                await Api.PostAsync<OrganizationDto>("api/platform/organizations", new CreateOrganizationRequest(
                    create.Name, create.Code, create.MaxUsers, create.MaxWarehouses,
                    create.AdminUserName, create.AdminDisplayName, create.AdminPassword));
            }
            else
            {
                if (result.Data is not OrganizationEditResult edit)
                {
                    return;
                }
                await Api.PutAsync<OrganizationDto>($"api/platform/organizations/{existing.Id}", new UpdateOrganizationRequest(
                    edit.Name, edit.IsActive, edit.MaxUsers, edit.MaxWarehouses));
            }
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
