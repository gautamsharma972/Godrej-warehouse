<MudDialog>
    <DialogContent>
    <div class="admin-drawer">
        <div class="admin-drawer-header">
            <div><h2 class="admin-drawer-title">Reset Password</h2><p class="admin-drawer-subtitle">Set a new password for '@UserName'.</p></div>
            <button class="admin-drawer-close" type="button" @onclick="Cancel"><i class="bx bx-x"></i></button>
        </div>
        <div class="admin-drawer-body">
            <div class="admin-form-grid">
                <div class="admin-form-field full"><label>New Password</label><input class="admin-form-control" type="password" @bind="NewPassword" @bind:event="oninput" /></div>
            </div>
        </div>
        <div class="admin-drawer-actions">
            <button class="admin-drawer-btn secondary" type="button" @onclick="Cancel">Cancel</button>
            <button class="admin-drawer-btn primary" type="button" @onclick="Submit" disabled="@string.IsNullOrWhiteSpace(NewPassword)">Reset</button>
        </div>
    </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private string NewPassword { get; set; } = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(NewPassword));
    private void Cancel() => MudDialog.Cancel();
}
