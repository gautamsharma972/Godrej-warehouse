@page "/platform/login"
@layout Layout.MainLayout

<PageTitle>Platform Admin - WarehouseGate</PageTitle>

<main class="login-shell">
    <section class="login-brand" aria-label="WarehouseGate platform overview">
        <div class="brand-mark" aria-hidden="true">
            <span>WG</span>
        </div>

        <div class="brand-copy">
            <p class="eyebrow">WarehouseGate Platform</p>
            <h1>Platform Admin Console</h1>
            <p class="brand-summary">
                Create and manage organizations, their user/warehouse limits, and reset
                passwords across every tenant on WarehouseGate.
            </p>
        </div>

        <div class="operations-panel">
            <div class="panel-header">
                <span>Platform Console</span>
                <strong>Live</strong>
            </div>
            <div class="signal-grid" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <dl class="trust-list">
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Business" Class="trust-icon" aria-hidden="true" />
                    <dt>Organizations</dt>
                    <dd>Onboard and manage every tenant</dd>
                </div>
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Groups" Class="trust-icon" aria-hidden="true" />
                    <dt>Users</dt>
                    <dd>Cross-organization visibility and control</dd>
                </div>
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="trust-icon" aria-hidden="true" />
                    <dt>Access</dt>
                    <dd>Reset any user's password, any org</dd>
                </div>
            </dl>
        </div>
    </section>

    <section class="login-panel" aria-label="Platform admin sign in">
        <div class="login-card">
            <div class="card-header">
                <div>
                    <p class="eyebrow">Platform sign in</p>
                    <h2>Welcome back</h2>
                </div>
                <span class="secure-badge">Secure</span>
            </div>

            <p class="card-intro">
                Use your platform administrator account to continue.
            </p>

            @if (ErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="login-alert">
                    @ErrorMessage
                </MudAlert>
            }

            <form method="post" action="/platform-login-handler" class="login-form">
                <div class="field-group">
                    <label for="userName">Username</label>
                    <div class="input-wrap">
                        <span class="input-icon-shell" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="input-icon" />
                        </span>
                        <input id="userName" name="userName" autocomplete="username" placeholder="Enter your username" autofocus />
                    </div>
                </div>

                <div class="field-group">
                    <div class="label-row">
                        <label for="password">Password</label>
                    </div>
                    <div class="input-wrap">
                        <span class="input-icon-shell" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="input-icon" />
                        </span>
                        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                    </div>
                </div>

                <button type="submit" class="login-button">
                    <span>Log in</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Class="button-icon" aria-hidden="true" />
                </button>
            </form>

            <div class="login-footer">
                <span>Tenant user?</span>
                <a href="/login">Go to the organization sign-in</a>
            </div>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "invalid" => "Invalid username or password.",
        "connect" => "Could not reach the server. Check your connection and try again.",
        "role" => "This account isn't provisioned for the platform console.",
        _ => null
    };
}
