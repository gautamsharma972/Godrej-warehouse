@page "/platform/users"
@attribute [Authorize(Roles = "PlatformAdmin")]
@inject PortalApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users - WarehouseGate Platform</PageTitle>

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Platform</p>
            <h1 class="admin-page-title">Users</h1>
            <p class="admin-page-subtitle">Every user across every organization. Reset any user's password here.</p>
        </div>
        <div class="admin-page-actions">
            <span class="admin-count-pill"><i class="bx bx-group"></i>@(_users?.Count ?? 0) Users</span>
        </div>
    </div>

    <div class="admin-table-card">
        @if (_users is null)
        {
            <div class="admin-loading"><i class="bx bx-loader-alt admin-spin"></i><span>Loading users</span></div>
        }
        else if (_users.Count == 0)
        {
            <div class="admin-empty"><i class="bx bx-group"></i><span>No users found.</span></div>
        }
        else
        {
            <div class="admin-table-toolbar">
                <AdminSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search users..." />
                <div class="admin-table-toolbar-filters">
                    <AdminFilterSelect Value="@_orgFilter" ValueChanged="OnOrgFilterChanged" Options="_orgNames" AllLabel="All Organizations" />
                    <AdminFilterSelect Value="@_roleFilter" ValueChanged="OnRoleFilterChanged" Options="_roleNames" AllLabel="All Roles" />
                </div>
            </div>

            @if (_view.Count == 0)
            {
                <div class="admin-empty"><i class="bx bx-group"></i><span>No users match your search or filters.</span></div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <AdminSortHeader Label="Username" Column="UserName" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th>Display Name</th>
                                <AdminSortHeader Label="Organization" Column="Organization" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <AdminSortHeader Label="Role" Column="Role" ActiveColumn="@_sortColumn" Ascending="_sortAscending" OnSort="SetSort" />
                                <th class="admin-actions-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _view)
                            {
                                <tr>
                                    <td><div class="admin-name-cell"><span class="admin-row-icon"><i class="bx bx-user"></i></span><span>@user.UserName</span></div></td>
                                    <td>@user.DisplayName</td>
                                    <td>@user.OrganizationName</td>
                                    <td><span class="admin-badge success">@user.Role</span></td>
                                    <td class="admin-actions-cell">
                                        <button class="admin-icon-btn edit" type="button" title="Reset Password" @onclick="() => OpenResetPassword(user)"><i class="bx bx-key"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <AdminPager @bind-Page="_page" @bind-PageSize="_pageSize" TotalItems="_filteredCount" />
        }
    </div>
</section>

@code {
    private List<PlatformUserDto>? _users;
    private string _search = string.Empty;
    private string? _orgFilter;
    private string? _roleFilter;
    private string _sortColumn = "UserName";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<string> _orgNames => (_users ?? []).Select(u => u.OrganizationName).Distinct().OrderBy(n => n).ToList();
    private List<string> _roleNames => (_users ?? []).Select(u => u.Role).Distinct().OrderBy(n => n).ToList();

    private IEnumerable<PlatformUserDto> Filtered => (_users ?? [])
        .Where(u => string.IsNullOrWhiteSpace(_search) ||
            u.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            u.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(u => _orgFilter is null || u.OrganizationName == _orgFilter)
        .Where(u => _roleFilter is null || u.Role == _roleFilter);

    private IEnumerable<PlatformUserDto> Sorted => _sortColumn switch
    {
        "Organization" => _sortAscending
            ? Filtered.OrderBy(u => u.OrganizationName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(u => u.OrganizationName, StringComparer.OrdinalIgnoreCase),
        "Role" => _sortAscending
            ? Filtered.OrderBy(u => u.Role, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(u => u.Role, StringComparer.OrdinalIgnoreCase),
        _ => _sortAscending
            ? Filtered.OrderBy(u => u.UserName, StringComparer.OrdinalIgnoreCase)
            : Filtered.OrderByDescending(u => u.UserName, StringComparer.OrdinalIgnoreCase)
    };

    private int _filteredCount => Filtered.Count();
    private List<PlatformUserDto> _view => Sorted.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
    }

    private void OnOrgFilterChanged(string? value)
    {
        _orgFilter = value;
        _page = 1;
    }

    private void OnRoleFilterChanged(string? value)
    {
        _roleFilter = value;
        _page = 1;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _users = await Api.GetAsync<List<PlatformUserDto>>("api/platform/users");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenResetPassword(PlatformUserDto user)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>
        {
            { d => d.UserName, user.UserName }
        };
        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>("Reset Password", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string newPassword)
        {
            return;
        }

        try
        {
            await Api.PostAsync<object>($"api/platform/users/{user.Id}/reset-password", new ResetPasswordRequest(newPassword));
            Snackbar.Add($"Password reset for '{user.UserName}'.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
