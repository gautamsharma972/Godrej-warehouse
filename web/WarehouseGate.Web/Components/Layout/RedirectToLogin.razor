@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var destination = path.StartsWith("platform/", StringComparison.OrdinalIgnoreCase) ? "/platform/login" : "/login";
        Navigation.NavigateTo(destination, forceLoad: true);
    }
}
