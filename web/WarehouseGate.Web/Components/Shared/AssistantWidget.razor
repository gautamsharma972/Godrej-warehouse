    private UpdatePickListQuantityFormSubmitRequest BuildUpdatePickListQuantityFormRequest(UiBlockState block)
    {
        _ = int.TryParse(GetFormValue(block, "lineId"), out var lineId);
        _ = int.TryParse(GetFormValue(block, "quantity"), out var quantity);
        return new UpdatePickListQuantityFormSubmitRequest(lineId, quantity);
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private string CurrentPagePath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relative.Split('?', '#')[0].Trim('/');
        return $"/{path}";
    }

    private string CurrentPageLabel()
    {
        var path = CurrentPagePath();
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 3 && int.TryParse(segments[2], out var id))
        {
            if (segments[1].Equals("inward-jobs", StringComparison.OrdinalIgnoreCase))
            {
                return $"Inward job #{id}";
            }
            if (segments[1].Equals("outward-jobs", StringComparison.OrdinalIgnoreCase))
            {
                return $"Outward job #{id}";
            }
        }

        return path.ToLowerInvariant() switch
        {
            "/office/dashboard" => "Office dashboard",
            "/office/inward-jobs" => "Inward jobs",
            "/office/outward-jobs" => "Outward jobs",
            "/office/dispatch-orders" => "Dispatch orders",
            "/office/follow-ups" => "Follow-ups",
            "/office/reports" => "Office reports",
            "/logistics/dashboard" => "Logistics dashboard",
            "/logistics/vehicle-records" => "Dispatch Plan",
            "/logistics/reports" => "Logistics reports",
            "/admin/dashboard" => "Administration dashboard",
            _ => "Current page"
        };
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _activeRequest?.Cancel();
        _activeRequest?.Dispose();
        if (_assistantModule is not null)
        {
            try
            {
                await _assistantModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already gone.
            }
        }
    }
}
