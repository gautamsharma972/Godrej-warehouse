<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="WarehouseGate.Web.styles.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.warehouseGate = window.warehouseGate || {};
        window.warehouseGate.initTooltips = () => {
            if (!window.bootstrap?.Tooltip) {
                return;
            }

            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((element) => {
                bootstrap.Tooltip.getInstance(element)?.dispose();
                bootstrap.Tooltip.getOrCreateInstance(element, {
                    boundary: document.body,
                    container: 'body',
                    trigger: 'hover focus'
                });
            });
        };
        window.warehouseGate.getTheme = () => localStorage.getItem('warehouseGateTheme') || 'teal';
        window.warehouseGate.setTheme = (theme) => localStorage.setItem('warehouseGateTheme', theme);
        // Client-side file download for server-generated content (e.g. report CSV exports) -
        // needed because plain <a href> can't attach the bearer token the API requires.
        window.warehouseGate.downloadFile = (fileName, contentType, base64Content) => {
            const bytes = Uint8Array.from(atob(base64Content), (c) => c.charCodeAt(0));
            const url = URL.createObjectURL(new Blob([bytes], { type: contentType }));
            const anchor = document.createElement('a');
            anchor.href = url;
            anchor.download = fileName;
            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();
            URL.revokeObjectURL(url);
        };
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
