<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Controls.BackHeaderView"
             x:Name="Root">

    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                Stroke="Transparent" BackgroundColor="{StaticResource CardTint}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Border.GestureRecognizers>
            <Label Text="{x:Static services:IconGlyphs.ArrowLeft}" Style="{StaticResource IconLabel}"
                   FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="8,0,0,0" Spacing="0">
            <Label x:Name="PageTitleLabel" Text="{Binding PageTitle, Source={x:Reference Root}}" IsVisible="False"
                   FontFamily="PoppinsBold" FontSize="17" TextColor="{StaticResource TextPrimaryLight}"
                   LineBreakMode="TailTruncation" MaxLines="1" />
            <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>
        <ContentView Grid.Column="2" x:Name="TrailingContentHost" VerticalOptions="Center" />
    </Grid>
</ContentView>
