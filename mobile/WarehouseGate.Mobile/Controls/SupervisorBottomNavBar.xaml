<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Controls.SupervisorBottomNavBar">

    <Border x:Name="RootBorder" HorizontalOptions="Center" Margin="0,0,0,14" Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 26"
            BackgroundColor="{StaticResource CardLight}" Shadow="{StaticResource CardShadow}">
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="28">

            <Grid WidthRequest="100">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="DashboardPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="DashboardIcon" Text="{x:Static services:IconGlyphs.House}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="DashboardLabel" Text="Home" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid WidthRequest="100">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnJobsTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="JobsPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="JobsIcon" Text="{x:Static services:IconGlyphs.ListCheck}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="JobsLabel" Text="Jobs" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid WidthRequest="100">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="HistoryPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="HistoryIcon" Text="{x:Static services:IconGlyphs.ClockRotateLeft}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="HistoryLabel" Text="History" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

        </HorizontalStackLayout>
    </Border>
</ContentView>
