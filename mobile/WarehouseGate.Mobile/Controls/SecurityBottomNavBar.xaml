<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Controls.SecurityBottomNavBar">

    <Border x:Name="RootBorder" HorizontalOptions="Center" Margin="0,0,0,14" Padding="18,8" StrokeThickness="0" StrokeShape="RoundRectangle 26"
            BackgroundColor="{StaticResource CardLight}" Shadow="{StaticResource CardShadow}">
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="22">

            <Grid WidthRequest="90">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="DashboardPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="DashboardIcon" Text="{x:Static services:IconGlyphs.House}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="DashboardLabel" Text="Home" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid WidthRequest="90">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCheckInTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="CheckInPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="CheckInIcon" Text="{x:Static services:IconGlyphs.Warehouse}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="CheckInLabel" Text="Check-In" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid WidthRequest="90">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStatusTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="StatusPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="StatusIcon" Text="{x:Static services:IconGlyphs.ClipboardList}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="StatusLabel" Text="Status" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <Grid WidthRequest="90">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="ExitPill" BackgroundColor="{StaticResource CardTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" IsVisible="False" />
                <VerticalStackLayout Spacing="2" Padding="0,9" HorizontalOptions="Center">
                    <Label x:Name="ExitIcon" Text="{x:Static services:IconGlyphs.RightFromBracket}" FontFamily="FaSolid" FontSize="17" HorizontalOptions="Center" />
                    <Label x:Name="ExitLabel" Text="Outwards" FontSize="10" FontFamily="PoppinsSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

        </HorizontalStackLayout>
    </Border>
</ContentView>
