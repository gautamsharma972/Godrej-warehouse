<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Controls.AppHeaderView"
             x:Name="Root">

    <Border x:Name="HeaderSurface" StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="Transparent"
            Padding="18,8,18,3">

        <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 12"
                    Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    SemanticProperties.Description="Menu" IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuIconTapped" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static services:IconGlyphs.Bars}" Style="{StaticResource IconLabel}"
                       FontSize="16" TextColor="#344054" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Image Grid.Column="0" Source="logiflow_brand_mark.png" WidthRequest="42" HeightRequest="42"
                   Aspect="AspectFit" VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label x:Name="GreetingLabel" FontFamily="PoppinsRegular" FontSize="10"
                       TextColor="#687387" LineBreakMode="TailTruncation" MaxLines="1" />
                <Label x:Name="UserNameLabel" FontFamily="PoppinsSemiBold" FontSize="14"
                       TextColor="#172033" LineBreakMode="TailTruncation" MaxLines="1" />
            </VerticalStackLayout>

            <controls:LiveBadge x:Name="LiveStatusBadge" Grid.Column="1" VerticalOptions="Center" IsVisible="False" />

            <Grid Grid.Column="2" VerticalOptions="Center">
                <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                        Stroke="#C9DDF1" StrokeThickness="1" BackgroundColor="#EEF5FC"
                        SemanticProperties.Description="Notifications">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificationsIconTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static services:IconGlyphs.Bell}" Style="{StaticResource IconLabel}"
                           FontSize="16" TextColor="#344054" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border x:Name="NotificationCountBadge" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                        StrokeThickness="0" BackgroundColor="{StaticResource StatusException}"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,-4,0" IsVisible="False" InputTransparent="True">
                    <Label x:Name="NotificationCountLabel" FontSize="9" FontFamily="PoppinsBold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,1,0,0" />
                </Border>
            </Grid>

            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 12"
                    Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    SemanticProperties.Description="Account" IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccountIconTapped" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static services:IconGlyphs.User}" Style="{StaticResource IconLabel}"
                       FontSize="16" TextColor="#344054" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Border>
</ContentView>
