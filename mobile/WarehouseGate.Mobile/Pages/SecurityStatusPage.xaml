<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SecurityStatusPage"
             Title="Vehicle Status"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="True">

    <ContentPage.Resources>
        <DataTemplate x:Key="SecurityJobRowTemplate" x:DataType="models:InwardJob">
            <Border Stroke="#DCE5F5" StrokeThickness="1" Padding="12" Margin="0,0,0,10"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,3" Radius="10" Opacity="0.03" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="5,Auto,*,Auto,Auto" ColumnSpacing="14" MinimumHeightRequest="94" Padding="0,14,16,14">
                    <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 16,0,16,0"
                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FF" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                               FontSize="18" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding VehicleNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="15" />
                        <Label Text="{Binding Subtitle}" TextColor="#687387" FontSize="12" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Border Grid.Column="3" Padding="11,6" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Center"
                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                            StrokeShape="RoundRectangle 14">
                        <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                               TextColor="White" FontSize="11" FontFamily="PoppinsSemiBold" />
                    </Border>
                    <Border Grid.Column="4" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                            BackgroundColor="#F4F7FF" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                               FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#687387" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- History rows: status is now implied by which status tab is selected, so the subtitle
             carries the date+time instead (no separate date grouping anymore). -->
        <DataTemplate x:Key="SecurityHistoryJobRowTemplate" x:DataType="models:InwardJob">
            <Border Stroke="#DCE5F5" StrokeThickness="1" Padding="13" Margin="0,0,0,8"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="54">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11" BackgroundColor="#EAF1FF" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.ClockRotateLeft}" Style="{StaticResource IconLabel}"
                               FontSize="13" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding VehicleNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="13" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding SubtitleWithTime}" TextColor="#788395" FontSize="10"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Padding="9,4" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Center"
                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                            StrokeShape="RoundRectangle 10">
                        <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                               TextColor="White" FontSize="9" FontFamily="PoppinsSemiBold" />
                    </Border>
                    <Label Grid.Column="3" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                           FontSize="9" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#8A94A5" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReadyToExitRowTemplate" x:DataType="models:InwardJob">
            <Border Stroke="#DCE5F5" StrokeThickness="1" Padding="14" Margin="0,0,0,8"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReadyToExitJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="56">
                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding VehicleNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="14" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Subtitle}" TextColor="#788395" FontSize="11"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="10,6" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Center"
                            BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 12">
                        <Label Text="{Binding Grn.GrnNumber}" TextColor="{StaticResource StatusSuccess}"
                               FontSize="10" FontFamily="PoppinsSemiBold" LineBreakMode="TailTruncation" MaxLines="1" />
                    </Border>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                           FontSize="10" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#8A94A5" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutwardStatusRowTemplate" x:DataType="models:OutwardJob">
            <Border Stroke="#DCE5F5" StrokeThickness="1" Padding="14,12" Margin="0,0,0,8"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOutwardStatusJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinimumHeightRequest="66">
                    <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11" BackgroundColor="#EAF1FF" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                               FontSize="12" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding DispatchOrderNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Text="{Binding SubtitleWithTime}" TextColor="#788395" FontSize="11"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                        <Border Padding="8,3" Margin="0,2,0,0" StrokeThickness="0" HorizontalOptions="Start"
                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                StrokeShape="RoundRectangle 9">
                            <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                                   TextColor="White" FontSize="9" FontFamily="PoppinsSemiBold" />
                        </Border>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                           FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#8A94A5" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutwardReadyToExitRowTemplate" x:DataType="models:OutwardJob">
            <Border Stroke="#DCE5F5" StrokeThickness="1" Padding="14,12" Margin="0,0,0,8"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOutwardReadyToExitJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinimumHeightRequest="66">
                    <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11" BackgroundColor="{StaticResource StatusSuccessTint}" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" Style="{StaticResource IconLabel}"
                               FontSize="12" TextColor="{StaticResource StatusSuccess}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding VehicleNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Text="{Binding SubtitleWithTime}" TextColor="#788395" FontSize="11"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                        <Border Padding="8,3" Margin="0,2,0,0" StrokeThickness="0" HorizontalOptions="Start"
                                BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 9">
                            <Label Text="{Binding DispatchNote.DispatchNoteNumber}" TextColor="{StaticResource StatusSuccess}"
                                   FontSize="9" FontFamily="PoppinsSemiBold" />
                        </Border>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                           FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#8A94A5" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceLight}">
        <Grid Grid.Row="0" BackgroundColor="Transparent">
            <controls:BackHeaderView PageTitle="Vehicle Status" Title="Track gate movements" ShowBackButton="True"
                                     BackRoute="//SecurityTabs/SecurityDashboardPage" />
        </Grid>
        <RefreshView Grid.Row="1" x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="10,10,10,22" Spacing="12">

                    <Grid x:Name="StatusHeaderGrid" ColumnDefinitions="*" RowDefinitions="Auto"
                          RowSpacing="10" VerticalOptions="Center">
                        <VerticalStackLayout x:Name="StatusHeaderControls" Grid.Column="0" Spacing="8" HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" HeightRequest="36" HorizontalOptions="Start"
                                        BackgroundColor="#EEF5FC" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12" Padding="3">
                                <HorizontalStackLayout Spacing="3">
                                <Border x:Name="InwardModePill" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" Padding="18,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStatusInwardTabClicked" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="StatusInwardRadioLabel" Text="INWARD" FontSize="10"
                                           FontFamily="PoppinsSemiBold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border x:Name="OutwardModePill" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" Padding="18,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStatusOutwardTabClicked" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="StatusOutwardRadioLabel" Text="OUTWARD" FontSize="10"
                                           FontFamily="PoppinsSemiBold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                </HorizontalStackLayout>
                                </Border>

                                <Button x:Name="FilterToggleButton" Grid.Column="2" Text="Filter" Clicked="OnFilterToggleClicked"
                                        Style="{StaticResource IconTextButton}" HorizontalOptions="End"
                                        HeightRequest="36" Padding="12,0" FontSize="11">
                                    <Button.ImageSource>
                                        <!-- Inline glyph avoids a runtime x:Static dependency during XAML hot reload. -->
                                        <FontImageSource FontFamily="FaSolid" Glyph=""
                                                         Color="{StaticResource Primary}" Size="11" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>

                            <Border x:Name="InwardSubTabToggle" Padding="3" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="#EEF5FC"
                                    HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="3">
                                    <Button x:Name="ActiveTabButton" Text="Active" Clicked="OnActiveTabClicked"
                                            CornerRadius="9" FontFamily="PoppinsSemiBold" FontSize="11" Padding="18,0" HeightRequest="36" />
                                    <Button x:Name="ReadyToExitTabButton" Text="Ready to Exit" Clicked="OnReadyToExitTabClicked"
                                            CornerRadius="9" FontFamily="PoppinsSemiBold" FontSize="11" Padding="18,0" HeightRequest="36" />
                                    <Button x:Name="HistoryTabButton" Text="History" Clicked="OnHistoryTabClicked"
                                            CornerRadius="9" FontFamily="PoppinsSemiBold" FontSize="11" Padding="18,0" HeightRequest="36" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="InwardFilterBar" Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18"
                            Padding="18" IsVisible="False">
                        <VerticalStackLayout Spacing="14">
                            <Grid x:Name="SearchFieldsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="12">

                                <VerticalStackLayout x:Name="VehicleSearchSection" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                    <Label Text="SEARCH" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <SearchBar x:Name="VehicleSearchBar" Placeholder="Vehicle number, PO, supplier" SearchButtonPressed="OnSearchClicked" TextChanged="OnFilterTextChanged" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="PoNumberSection" Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <Label Text="PO NUMBER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <Border x:Name="PoNumberEntryBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="42">
                                        <Entry x:Name="PoNumberSearchEntry" Placeholder="Optional" VerticalOptions="Center"
                                               TextChanged="OnFilterTextChanged"
                                               Focused="OnPoNumberFocused" Unfocused="OnPoNumberUnfocused" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="DateSection" Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <Label Text="DATE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="42">
                                            <DatePicker x:Name="HistoryDatePicker" DateSelected="OnHistoryDateSelected" FontSize="13" VerticalOptions="Center" />
                                        </Border>
                                        <Button x:Name="ClearDateButton" SemanticProperties.Description="Clear date filter" Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                                Style="{StaticResource ChipButton}" Clicked="OnClearDateClicked" IsVisible="False">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Xmark}" Color="{StaticResource Primary}" Size="12" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>
                                </VerticalStackLayout>

                                <Grid x:Name="InwardFilterActions" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button x:Name="SearchButtonControl" Grid.Column="0" Text="Apply Filters"
                                            Clicked="OnSearchClicked" Style="{StaticResource SecondaryActionButton}" />
                                    <Button Grid.Column="1" Text="Reset" Clicked="OnResetInwardFiltersClicked"
                                            Style="{StaticResource IconTextButton}" Padding="14,0" />
                                </Grid>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============================ INWARD ============================ -->
                    <VerticalStackLayout x:Name="InwardStatusSection" Spacing="14">

                    <!-- ============================ ACTIVE ============================ -->
                    <VerticalStackLayout x:Name="ActiveSection" Spacing="8">
                        <HorizontalStackLayout x:Name="NoActiveLabel" Spacing="8" HorizontalOptions="Center" IsVisible="False" Margin="0,12">
                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}" FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Text="No vehicles currently in progress." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                        </HorizontalStackLayout>
                        <CollectionView x:Name="ActiveCollectionView" ItemTemplate="{StaticResource SecurityJobRowTemplate}" />
                    </VerticalStackLayout>

                    <!-- ============================ READY TO EXIT ============================ -->
                    <VerticalStackLayout x:Name="ReadyToExitSection" Spacing="8" IsVisible="False">
                        <HorizontalStackLayout x:Name="NoReadyToExitLabel" Spacing="8" HorizontalOptions="Center" IsVisible="False" Margin="0,12">
                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}" FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Text="No completed vehicles waiting to exit." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                        </HorizontalStackLayout>
                        <CollectionView x:Name="ReadyToExitCollectionView" ItemTemplate="{StaticResource ReadyToExitRowTemplate}" />
                    </VerticalStackLayout>

                    <!-- ============================ EXIT CONFIRM ============================ -->
                    <VerticalStackLayout x:Name="StatusExitConfirmSection" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="StatusConfirmVehicleLabel" Style="{StaticResource CardTitleLabel}" LineBreakMode="TailTruncation" />
                                <Label x:Name="StatusConfirmSubtitleLabel" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                                <Label x:Name="StatusConfirmDriverLabel" Style="{StaticResource MetaLabel}" />
                                <Label x:Name="StatusConfirmGrnLabel" Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Exit photo" Style="{StaticResource CardTitleLabel}" />
                                <ScrollView Orientation="Horizontal">
                                    <HorizontalStackLayout x:Name="StatusExitPhotoStrip" Spacing="8" />
                                </ScrollView>
                                <Button Text="Capture Exit Photo" Clicked="OnStatusCaptureExitPhotoClicked" Style="{StaticResource IconTextButton}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Camera}" Color="{StaticResource Primary}" Size="13" />
                                    </Button.ImageSource>
                                </Button>
                            </VerticalStackLayout>
                        </Border>

                        <Button x:Name="StatusConfirmExitButton" Text="Confirm Exit" Clicked="OnStatusConfirmExitClicked" IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}" BackgroundColor="{StaticResource StatusSuccess}"
                                TextColor="White" CornerRadius="14" HeightRequest="50" />
                        <Button Text="Cancel" Clicked="OnStatusCancelExitClicked" Style="{StaticResource IconTextButton}" />
                        <ActivityIndicator x:Name="StatusExitSpinner" IsRunning="False" IsVisible="False" />
                    </VerticalStackLayout>

                    <!-- ============================ EXIT RESULT (GATE PASS TOKEN) ============================ -->
                    <VerticalStackLayout x:Name="StatusExitResultSection" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="28" TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" />
                                <Label Text="Vehicle exited" Style="{StaticResource SectionTitleLabel}" HorizontalOptions="Center" />
                                <Label x:Name="StatusResultVehicleLabel" FontFamily="PoppinsSemiBold" FontSize="15"
                                       HorizontalOptions="Center" TextColor="{StaticResource TextSecondaryLight}" />
                                <Label x:Name="StatusGatePassTokenLabel" FontFamily="PoppinsSemiBold" FontSize="18"
                                       HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Done" Clicked="OnStatusExitDoneClicked" Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>

                    <!-- ============================ HISTORY ============================ -->
                    <VerticalStackLayout x:Name="HistorySection" Spacing="16" IsVisible="False">

                        <!-- Status tabs + content merged into one seamless card, same pattern as
                             Gate Check-in's Vehicle/Documents/Photos tabs. -->
                        <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,14,14,4">
                                    <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 11" BackgroundColor="{StaticResource SurfaceLight}">
                                        <Label Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                               FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Movement history" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                                        <Label Text="Filter records by movement status" Style="{StaticResource MetaLabel}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,2" RowSpacing="0" Margin="12,8,12,0">
                                    <Grid Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHistoryAssignedTabClicked" />
                                        </Grid.GestureRecognizers>
                                        <Label x:Name="HistoryAssignedTabLabel" Text="ASSIGNED" FontFamily="PoppinsSemiBold" FontSize="9" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHistoryDockedTabClicked" />
                                        </Grid.GestureRecognizers>
                                        <Label x:Name="HistoryDockedTabLabel" Text="DOCKED" FontFamily="PoppinsSemiBold" FontSize="9" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHistoryCompletedTabClicked" />
                                        </Grid.GestureRecognizers>
                                        <Label x:Name="HistoryCompletedTabLabel" Text="COMPLETED" FontFamily="PoppinsSemiBold" FontSize="9" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="3" HorizontalOptions="Center" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnHistoryOtherTabClicked" />
                                        </Grid.GestureRecognizers>
                                        <Label x:Name="HistoryOtherTabLabel" Text="OTHER" FontFamily="PoppinsSemiBold" FontSize="9" />
                                    </Grid>

                                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                             BackgroundColor="{StaticResource CardBorderLight}" Color="{StaticResource CardBorderLight}" />

                                    <BoxView x:Name="HistoryAssignedTabIndicator" Grid.Row="1" Grid.Column="0" BackgroundColor="Transparent" Color="Transparent" />
                                    <BoxView x:Name="HistoryDockedTabIndicator" Grid.Row="1" Grid.Column="1" BackgroundColor="Transparent" Color="Transparent" />
                                    <BoxView x:Name="HistoryCompletedTabIndicator" Grid.Row="1" Grid.Column="2" BackgroundColor="Transparent" Color="Transparent" />
                                    <BoxView x:Name="HistoryOtherTabIndicator" Grid.Row="1" Grid.Column="3" BackgroundColor="Transparent" Color="Transparent" />
                                </Grid>

                                <VerticalStackLayout Padding="12">
                                    <ActivityIndicator x:Name="HistoryListSpinner" IsRunning="False" IsVisible="False" Margin="0,12" />
                                    <Border x:Name="NoHistoryLabel" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                            StrokeShape="RoundRectangle 16" Padding="18" IsVisible="False">
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}" FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                            <Label Text="No matching vehicles found." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <CollectionView x:Name="HistoryCollectionView" ItemTemplate="{StaticResource SecurityHistoryJobRowTemplate}" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ============================ OUTWARD ============================ -->
                    <VerticalStackLayout x:Name="OutwardStatusSection" Spacing="14" IsVisible="False">

                    <!-- ============================ SEARCH ============================ -->
                    <VerticalStackLayout x:Name="OutwardSearchSection" Spacing="14">

                        <Border x:Name="OutwardFilterBar" Style="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 18" Padding="16" IsVisible="False">
                            <Grid x:Name="OutwardSearchFieldsGrid" ColumnDefinitions="2*,1.15*,1.25*,Auto"
                                  RowDefinitions="Auto" RowSpacing="12" ColumnSpacing="12">

                                <VerticalStackLayout x:Name="OutwardVehicleSearchSection" Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <Label Text="VEHICLE SEARCH" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <SearchBar x:Name="OutwardVehicleSearchBar" Placeholder="Vehicle number"
                                               HeightRequest="46" SearchButtonPressed="OnOutwardSearchClicked"
                                               TextChanged="OnOutwardFilterTextChanged" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="OutwardDoNumberSection" Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <Label Text="DO NUMBER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <Border x:Name="OutwardDoNumberEntryBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="46">
                                        <Entry x:Name="OutwardDoNumberSearchEntry" Placeholder="Optional" VerticalOptions="Center"
                                               TextChanged="OnOutwardFilterTextChanged"
                                               Focused="OnOutwardDoNumberFocused" Unfocused="OnOutwardDoNumberUnfocused" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="OutwardDateSection" Grid.Row="0" Grid.Column="2" Spacing="6">
                                    <Label Text="DATE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="46">
                                            <DatePicker x:Name="OutwardHistoryDatePicker" DateSelected="OnOutwardHistoryDateSelected" FontSize="13" VerticalOptions="Center" />
                                        </Border>
                                        <Button x:Name="OutwardClearDateButton" SemanticProperties.Description="Clear date filter"
                                                Grid.Column="1" WidthRequest="46" HeightRequest="46"
                                                Style="{StaticResource ChipButton}" Clicked="OnOutwardClearDateClicked" IsVisible="False">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Xmark}" Color="{StaticResource Primary}" Size="12" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>
                                </VerticalStackLayout>

                                <Grid x:Name="OutwardFilterActions" Grid.Row="0" Grid.Column="3"
                                      ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="End">
                                    <Button x:Name="OutwardSearchButtonControl" Grid.Column="0" Text="Search"
                                            Clicked="OnOutwardSearchClicked" Style="{StaticResource SecondaryActionButton}"
                                            HeightRequest="46" />
                                    <Button Grid.Column="1" Text="Reset" Clicked="OnResetOutwardFiltersClicked"
                                            Style="{StaticResource IconTextButton}" HeightRequest="46" Padding="14,0" />
                                </Grid>

                            </Grid>
                        </Border>

                        <ActivityIndicator x:Name="OutwardListSpinner" IsRunning="False" IsVisible="False" Margin="0,12" />
                        <HorizontalStackLayout x:Name="NoOutwardResultsLabel" Spacing="8" HorizontalOptions="Center" IsVisible="False" Margin="0,12">
                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}" FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Text="No matching vehicles found." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                        </HorizontalStackLayout>
                        <CollectionView x:Name="OutwardStatusCollectionView" ItemTemplate="{StaticResource OutwardStatusRowTemplate}" />

                    </VerticalStackLayout>

                    <!-- ============================ EXIT CONFIRM ============================ -->
                    <VerticalStackLayout x:Name="OutwardExitConfirmSection" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="OutwardConfirmVehicleLabel" Style="{StaticResource CardTitleLabel}" LineBreakMode="TailTruncation" />
                                <Label x:Name="OutwardConfirmSubtitleLabel" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                                <Label x:Name="OutwardConfirmDriverLabel" Style="{StaticResource MetaLabel}" />
                                <Label x:Name="OutwardConfirmDispatchNoteLabel" Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Exit photo" Style="{StaticResource CardTitleLabel}" />
                                <ScrollView Orientation="Horizontal">
                                    <HorizontalStackLayout x:Name="OutwardExitPhotoStrip" Spacing="8" />
                                </ScrollView>
                                <Button Text="Capture Exit Photo" Clicked="OnOutwardStatusCaptureExitPhotoClicked" Style="{StaticResource IconTextButton}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Camera}" Color="{StaticResource Primary}" Size="13" />
                                    </Button.ImageSource>
                                </Button>
                            </VerticalStackLayout>
                        </Border>

                        <Button x:Name="OutwardStatusConfirmExitButton" Text="Confirm Exit" Clicked="OnOutwardStatusConfirmExitClicked" IsEnabled="False"
                                Style="{StaticResource PrimaryActionButton}" BackgroundColor="{StaticResource StatusSuccess}"
                                TextColor="White" CornerRadius="14" HeightRequest="50" />
                        <Button Text="Cancel" Clicked="OnOutwardStatusCancelExitClicked" Style="{StaticResource IconTextButton}" />
                        <ActivityIndicator x:Name="OutwardStatusExitSpinner" IsRunning="False" IsVisible="False" />
                    </VerticalStackLayout>

                    <!-- ============================ EXIT RESULT (GATE PASS TOKEN) ============================ -->
                    <VerticalStackLayout x:Name="OutwardExitResultSection" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="28" TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" />
                                <Label Text="Vehicle exited" Style="{StaticResource SectionTitleLabel}" HorizontalOptions="Center" />
                                <Label x:Name="OutwardStatusResultVehicleLabel" FontFamily="PoppinsSemiBold" FontSize="15"
                                       HorizontalOptions="Center" TextColor="{StaticResource TextSecondaryLight}" />
                                <Label x:Name="OutwardStatusGatePassTokenLabel" FontFamily="PoppinsSemiBold" FontSize="18"
                                       HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Done" Clicked="OnOutwardStatusExitDoneClicked" Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Transient live-update banner, overlaid on top of the scroll content -->
        <Border Grid.Row="1" x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="16,12"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14">
            <Label x:Name="LiveBannerLabel" TextColor="{StaticResource PrimaryDarkText}" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
