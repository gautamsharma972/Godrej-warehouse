<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             x:Class="WarehouseGate.Mobile.Pages.JobDetailPage"
             Title="Unloading Job"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource SurfaceLight}">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout x:Name="PageContent" Padding="30,24,30,32" Spacing="18">

            <controls:BackHeaderView Title="Back to jobs">
                <controls:BackHeaderView.TrailingContent>
                    <Border Padding="12,7" StrokeThickness="0" x:Name="StatusBadgeBorder" StrokeShape="RoundRectangle 14"
                            VerticalOptions="Center">
                        <Label x:Name="StatusLabel" TextColor="White" FontFamily="PoppinsSemiBold" FontSize="12" />
                    </Border>
                </controls:BackHeaderView.TrailingContent>
            </controls:BackHeaderView>

            <!-- Compact inbound manifest -->
            <Border Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    StrokeShape="RoundRectangle 22" Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                </Border.Shadow>
                <Grid x:Name="HeroGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20"
                      Padding="24" BackgroundColor="White">
                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                            BackgroundColor="#E9FBF8" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                               FontSize="20" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout x:Name="HeroTextStack" Grid.Column="1" Spacing="7" VerticalOptions="Center">
                        <Label x:Name="HeaderLabel" TextColor="#172033" FontFamily="PoppinsSemiBold"
                               FontSize="23" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static services:IconGlyphs.ClipboardCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="11" TextColor="#687387" VerticalOptions="Center" />
                            <Label x:Name="SubHeaderLabel" TextColor="#687387" FontSize="13" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference TimeTrackingLabel}, Path=IsVisible}">
                            <Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}"
                                   FontSize="11" TextColor="#687387" VerticalOptions="Center" />
                            <Label x:Name="TimeTrackingLabel" TextColor="#687387" FontSize="12" IsVisible="False" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout x:Name="HeroMetaChips" Grid.Column="2" Spacing="8"
                                           HorizontalOptions="End" VerticalOptions="Center">
                        <Border Padding="12,8" Stroke="#DDE8E6" StrokeThickness="1" BackgroundColor="#F4FAF9"
                                StrokeShape="RoundRectangle 12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.LocationDot}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label x:Name="BaySummaryLabel" Text="Bay pending" FontSize="11"
                                       FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="12,8" Stroke="#DDE8E6" StrokeThickness="1" BackgroundColor="#F4FAF9"
                                StrokeShape="RoundRectangle 12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label x:Name="LineSummaryLabel" Text="0 lines" FontSize="11"
                                       FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Workflow and evidence: balanced tablet split -->
            <Grid x:Name="WorkflowEvidenceGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="14" RowSpacing="14">

            <!-- Inbound workflow -->
            <Grid x:Name="HeroSummaryGrid" Grid.Column="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Border Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                        StrokeShape="RoundRectangle 16" Padding="14" MinimumHeightRequest="88">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                BackgroundColor="#123F3D" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Label Text="01" FontFamily="PoppinsSemiBold" FontSize="12" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Unload &amp; inspect" FontSize="13" FontFamily="PoppinsSemiBold"
                                   TextColor="#172033" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusSuccessTint}"
                                    StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label Text="Current work" FontSize="10" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource StatusSuccess}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                        StrokeShape="RoundRectangle 16" Padding="14" MinimumHeightRequest="88">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                BackgroundColor="#123F3D" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Label Text="02" FontFamily="PoppinsSemiBold" FontSize="12" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="PhotoCountLabel" Text="0 photos" FontSize="13"
                                   FontFamily="PoppinsSemiBold" TextColor="#172033" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusAvailableTint}"
                                    StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label Text="Evidence" FontSize="10" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource StatusDocked}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                        StrokeShape="RoundRectangle 16" Padding="14" MinimumHeightRequest="88">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                BackgroundColor="#123F3D" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Label Text="03" FontFamily="PoppinsSemiBold" FontSize="12" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Completion readiness" FontSize="13" FontFamily="PoppinsSemiBold"
                                   TextColor="#172033" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="#FFF1D6"
                                    StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label Text="Closure" FontSize="10" FontFamily="PoppinsSemiBold" TextColor="#B87500" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Dock-in -->
            <Border x:Name="DockInSection" Grid.Row="1" Grid.ColumnSpan="2" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 18" IsVisible="False" Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,5" Radius="16" Opacity="0.05" />
                </Border.Shadow>
                <Grid x:Name="DockInCardGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="14" RowSpacing="14" Padding="18">
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#E9FBF8">
                        <Label Text="{x:Static services:IconGlyphs.LocationDot}" Style="{StaticResource IconLabel}"
                               FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Assign unloading bay" Style="{StaticResource SectionTitleLabel}" FontSize="17" />
                        <Label Text="Map this vehicle to a physical bay before unloading starts." Style="{StaticResource MetaLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Row="0" Grid.Column="2" Padding="12,7" StrokeThickness="0"
                            BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Label Text="Required" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                    </Border>

                    <Grid x:Name="DockInActionGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="12">
                        <Grid Grid.Column="0" x:Name="BayNumberEntryGrid" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18" Padding="16,0" HeightRequest="58"
                                    BackgroundColor="{StaticResource CardTint}" VerticalOptions="Center">
                                <Label Text="Bay-" VerticalOptions="Center" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                            <Border Grid.Column="1" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18" Padding="12,0" HeightRequest="58"
                                    BackgroundColor="{StaticResource CardLight}">
                                <Entry x:Name="BayNumberEntry" Placeholder="Bay number (1-50)"
                                       Keyboard="Numeric" MaxLength="2" TextChanged="OnBayNumberTextChanged"
                                       FontSize="16" FontFamily="PoppinsSemiBold" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <ScrollView Grid.Column="0" x:Name="BayChipsScroll" Orientation="Horizontal" IsVisible="False" VerticalOptions="Center">
                            <FlexLayout x:Name="BayChipsLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" />
                        </ScrollView>
                        <Button Grid.Column="1" x:Name="DockInButton" Text="Dock In" Clicked="OnDockInClicked"
                                Style="{StaticResource PrimaryActionButton}" CornerRadius="18" HeightRequest="56" WidthRequest="220" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Start unloading -->
            <Border x:Name="StartUnloadingSection" Grid.Row="1" Grid.ColumnSpan="2" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 18" IsVisible="False" Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,5" Radius="16" Opacity="0.05" />
                </Border.Shadow>
                <Grid x:Name="StartUnloadingCardGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="14" RowSpacing="14" Padding="18">
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource StatusAvailableTint}">
                        <Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}"
                               FontSize="16" TextColor="{StaticResource StatusAvailable}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Ready to begin unloading?" Style="{StaticResource SectionTitleLabel}" FontSize="17" />
                        <Label Text="Start unloading records the begin time and opens inspection tracking for this inbound job."
                               Style="{StaticResource MetaLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Row="0" Grid.Column="2" Padding="12,7" StrokeThickness="0"
                            BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Label Text="Next step" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                    </Border>

                    <Grid x:Name="StartUnloadingActionGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 18" Padding="14,11">
                            <HorizontalStackLayout Spacing="9">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="Ensure the vehicle is positioned and the unloading team is ready."
                                       Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="1" x:Name="StartUnloadingButton" Text="Start Unloading" Clicked="OnStartUnloadingClicked"
                                Style="{StaticResource PrimaryActionButton}" CornerRadius="18" HeightRequest="56" WidthRequest="240" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Photos -->
            <Border x:Name="PhotoSection" Grid.Column="1" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 18" IsVisible="False" Padding="0"
                    VerticalOptions="Fill">
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="PhotoHeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="10"
                          Padding="18,16" BackgroundColor="#FBFCFE">
                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" BackgroundColor="#E9FBF8">
                            <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                   FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Proof gallery" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                            <Label Text="Review captured unloading proof before closure." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="12,7" StrokeThickness="0" BackgroundColor="White"
                                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label x:Name="PhotoCountHeaderLabel" Text="Evidence" FontSize="12" FontFamily="PoppinsBold" TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Padding="18" Spacing="0">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,14">
                            <Button Grid.Column="0" x:Name="CaptureVehiclePhotoButton" Text="Vehicle" Clicked="OnCaptureVehiclePhotoClicked"
                                    Style="{StaticResource IconTextButton}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Truck}" Color="{StaticResource Primary}" Size="13" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1" x:Name="CaptureMaterialPhotoButton" Text="Material" Clicked="OnCaptureMaterialPhotoClicked"
                                    Style="{StaticResource IconTextButton}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.BoxesStacked}" Color="{StaticResource Primary}" Size="13" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="2" x:Name="CaptureExceptionPhotoButton" Text="Exception" Clicked="OnCaptureExceptionPhotoClicked"
                                    Style="{StaticResource IconTextButton}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.TriangleExclamation}" Color="{StaticResource Primary}" Size="13" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>

                        <Grid Padding="0,2">
                            <HorizontalStackLayout x:Name="NoPhotosLabel" Spacing="8" HorizontalOptions="Center"
                                                   VerticalOptions="Center" IsVisible="False">
                                <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                       FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                <Label Text="No photos yet." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                            </HorizontalStackLayout>

                            <CollectionView x:Name="PhotoCarousel" HeightRequest="162" HorizontalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhotoDisplayItem">
                                        <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" Padding="0"
                                                BackgroundColor="{StaticResource CardLight}"
                                                StrokeShape="RoundRectangle 18" WidthRequest="220" HeightRequest="150">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="100,Auto">
                                                <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceLight}">
                                                    <Image Source="{Binding Source}" Aspect="AspectFill" IsVisible="{Binding HasLocalImage}" />
                                                    <VerticalStackLayout IsVisible="{Binding IsPlaceholder}" VerticalOptions="Center" Spacing="6">
                                                        <Label Text="{x:Static services:IconGlyphs.Camera}" FontFamily="FaSolid" FontSize="22"
                                                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                                        <Label Text="{Binding FriendlyType}" FontSize="12" HorizontalOptions="Center" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="10,9">
                                                    <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Description}" FontSize="10" TextColor="{StaticResource TextPrimaryLight}"
                                                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,10">
                            <Label Text="Gate documents" FontFamily="PoppinsSemiBold" FontSize="13" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="DocumentCountLabel" Text="0 documents" FontSize="11"
                                   TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                        </Grid>

                        <Grid Padding="0,2">
                            <HorizontalStackLayout x:Name="NoDocumentsLabel" Spacing="8" HorizontalOptions="Center"
                                                   VerticalOptions="Center" IsVisible="False">
                                <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                       FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                <Label Text="No documents uploaded at the gate." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                            </HorizontalStackLayout>

                            <CollectionView x:Name="DocumentsCarousel" HeightRequest="162" HorizontalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhotoDisplayItem">
                                        <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" Padding="0"
                                                BackgroundColor="{StaticResource CardLight}"
                                                StrokeShape="RoundRectangle 18" WidthRequest="220" HeightRequest="150">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid RowDefinitions="100,Auto">
                                                <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceLight}">
                                                    <Image Source="{Binding Source}" Aspect="AspectFill" IsVisible="{Binding HasLocalImage}" />
                                                    <VerticalStackLayout IsVisible="{Binding IsPlaceholder}" VerticalOptions="Center" Spacing="6">
                                                        <Label Text="{x:Static services:IconGlyphs.Camera}" FontFamily="FaSolid" FontSize="22"
                                                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                                        <Label Text="{Binding FriendlyType}" FontSize="12" HorizontalOptions="Center" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="10,9">
                                                    <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Description}" FontSize="10" TextColor="{StaticResource TextPrimaryLight}"
                                                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </VerticalStackLayout>

                    <IndicatorView x:Name="PhotoCarouselIndicator" IsVisible="False" HorizontalOptions="Center"
                                   IndicatorColor="{StaticResource CardBorderLight}" SelectedIndicatorColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            </Grid>

            <!-- Original dispatch load plan (read-only reference - only shown when this shipment
                 was actually dispatched through our own Outward flow at the origin warehouse) -->
            <Border x:Name="OutwardReferenceSection" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 18" IsVisible="False" Padding="0"
                    VerticalOptions="Start">
                <VerticalStackLayout Spacing="16">
                    <Grid x:Name="OutwardReferenceHeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                          Padding="18,16" BackgroundColor="#FBFCFE">
                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" BackgroundColor="#E9FBF8">
                            <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                   FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Original dispatch load plan" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                            <Label x:Name="OutwardReferenceSubtitleLabel" Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" x:Name="ToggleReferenceSimulationButton" WidthRequest="40" HeightRequest="40"
                                StrokeShape="RoundRectangle 12" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                BackgroundColor="{StaticResource CardLight}" VerticalOptions="Center"
                                SemanticProperties.Description="Show simulation">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleReferenceSimulationClicked" />
                            </Border.GestureRecognizers>
                            <Label x:Name="ToggleReferenceSimulationIcon" Text="{x:Static services:IconGlyphs.Eye}" Style="{StaticResource IconLabel}"
                                   FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Border x:Name="OutwardReferenceEmptyBorder" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                            StrokeShape="RoundRectangle 16" Padding="14,12" IsVisible="False">
                        <Label Text="No 3D load plan on file for this shipment - it was received without the origin warehouse planning the load in the 3D dispatch flow."
                               Style="{StaticResource MetaLabel}" />
                    </Border>

                    <Grid x:Name="OutwardReferenceContentGrid" ColumnDefinitions="2*,*" ColumnSpacing="16"
                          RowSpacing="14" Padding="18,0,18,18">
                        <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 20"
                                Padding="10" VerticalOptions="Fill">
                            <Grid>
                                <HybridWebView x:Name="ReferenceLoadVizWebView" MinimumHeightRequest="340"
                                               HorizontalOptions="Fill" VerticalOptions="Fill"
                                               HybridRoot="loadviz" DefaultFile="index.html" IsVisible="False" />
                                <Label x:Name="ReferenceLoadVizUnavailableLabel" Text="Loading plan unavailable - vehicle dimensions not on file."
                                       Style="{StaticResource MetaLabel}" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 18" Padding="14"
                                VerticalOptions="Fill">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Loading sequence" FontFamily="PoppinsSemiBold" FontSize="14" />
                                <ScrollView MaximumHeightRequest="300">
                                    <VerticalStackLayout x:Name="OutwardReferenceSequenceContainer" Spacing="8" />
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Inspection -->
            <Border x:Name="InspectionSection" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 18" IsVisible="False" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="InspectionHeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="10"
                          Padding="18,16" BackgroundColor="#FBFCFE">
                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" BackgroundColor="#E9FBF8">
                            <Label Text="{x:Static services:IconGlyphs.ClipboardCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Receiving inspection" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                            <Label Text="Review each product, split received quantities by condition, and capture exceptions."
                                   Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="12,7" StrokeThickness="0" BackgroundColor="White"
                                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label x:Name="InspectionCountLabel" Text="0 lines" FontSize="12" FontFamily="PoppinsBold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="InspectionLinesContainer" Spacing="16" Padding="18,18,18,0" />

                    <VerticalStackLayout Spacing="10" Padding="18,20,18,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Mismatch SKU details" FontFamily="PoppinsSemiBold" FontSize="14"
                                       TextColor="{StaticResource TextPrimaryLight}" />
                                <Label Text="Select any SKU from the SKU Master and enter the quantity actually received in its place. The total across all rows here must match the total Mismatch quantity entered above."
                                       Style="{StaticResource MetaLabel}" FontSize="11" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" x:Name="AddUnplannedLineButton" Text="Add SKU" Clicked="OnAddUnplannedLineClicked"
                                    Style="{StaticResource IconTextButton}" VerticalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.ListCheck}" Color="{StaticResource Primary}" Size="12" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                        <VerticalStackLayout x:Name="UnplannedLinesContainer" Spacing="10" />
                    </VerticalStackLayout>

                    <Grid x:Name="InspectionFooterGrid" ColumnDefinitions="*,Auto" ColumnSpacing="14" RowSpacing="12" Padding="18" BackgroundColor="{StaticResource CardLight}">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 18" Padding="14,11">
                            <HorizontalStackLayout Spacing="9">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="Save inspection once all condition quantities are reviewed."
                                       Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="1" x:Name="SubmitInspectionButton" Text="Save Inspection" Clicked="OnSubmitInspectionClicked"
                                Style="{StaticResource PrimaryActionButton}" CornerRadius="18" HeightRequest="54" WidthRequest="220" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Complete -->
            <VerticalStackLayout x:Name="CompletionSection" Spacing="6">
                <Button x:Name="CompleteButton" Text="Complete Unloading" Clicked="OnCompleteClicked"
                        IsVisible="False" Style="{StaticResource PrimaryActionButton}"
                        BackgroundColor="{StaticResource StatusSuccess}" TextColor="White" CornerRadius="18" HeightRequest="54" />
                <Label x:Name="CompleteHintLabel" Style="{StaticResource MetaLabel}" IsVisible="False"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- GRN -->
            <Border x:Name="GrnBorder" IsVisible="False" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" Padding="16,11" StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Opacity="0.05" Radius="10" Offset="0,3" />
                </Border.Shadow>
                <Grid x:Name="GrnGrid" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Grid Grid.Column="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                        <Border x:Name="GrnIconBadge" StrokeThickness="0" BackgroundColor="#E8F8EF"
                                StrokeShape="RoundRectangle 12" />
                        <Label x:Name="GrnIconLabel" FontFamily="FaSolid" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="GrnTitleLabel" FontFamily="PoppinsSemiBold" FontSize="13"
                               TextColor="{StaticResource TextPrimaryLight}" />
                        <Label x:Name="GrnLabel" FontSize="10" Style="{StaticResource MetaLabel}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
