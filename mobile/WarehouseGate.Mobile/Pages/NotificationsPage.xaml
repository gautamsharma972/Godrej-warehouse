<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.NotificationsPage"
             Title="Notifications"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceLight}">
        <Grid Grid.Row="0" BackgroundColor="Transparent">
            <controls:BackHeaderView x:Name="NotificationHeader" PageTitle="Notifications"
                                     Title="Operational alerts and updates" />
        </Grid>
        <RefreshView Grid.Row="1" x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="12,10,12,22" Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Recent alerts" TextColor="#172033"
                                   FontSize="16" FontFamily="PoppinsSemiBold" />
                            <Label Text="Tap an alert to open the related work."
                                   TextColor="#788395" FontSize="11" />
                        </VerticalStackLayout>
                        <Button x:Name="ClearButton" Grid.Column="1" Text="Clear all" Clicked="OnClearClicked" IsVisible="False"
                                Style="{StaticResource IconTextButton}" TextColor="{StaticResource Primary}"
                                FontSize="11" Padding="12,0" HeightRequest="36"
                                HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout x:Name="NotificationContainer" Spacing="8" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Transient live-update banner, overlaid on top of the scroll content -->
        <Border Grid.Row="1" x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="16,12"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14">
            <Label x:Name="LiveBannerLabel" TextColor="{StaticResource PrimaryDarkText}" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
