<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.AccountPage"
             Title="Account"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceLight}">
    <Grid Grid.Row="0" BackgroundColor="Transparent">
        <controls:BackHeaderView x:Name="PageHeader" PageTitle="Settings"
                                 Title="Account, access, and app information" />
    </Grid>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="12,10,12,22" Spacing="12">

            <Border Stroke="#D4E2FF" StrokeThickness="1" HorizontalOptions="End" Margin="0,0,2,2"
                        StrokeShape="RoundRectangle 14" Padding="11,7"
                        BackgroundColor="#F4F7FF" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                           FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label x:Name="ScopeLabel" Text="Assigned scope" TextColor="{StaticResource Primary}"
                           FontSize="11" FontFamily="PoppinsSemiBold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Profile card -->
            <Border Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    StrokeShape="RoundRectangle 16" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Border Grid.Column="0" WidthRequest="50" HeightRequest="50"
                            StrokeShape="RoundRectangle 15" Stroke="Transparent"
                            BackgroundColor="#EAF1FF">
                        <Label Text="{x:Static services:IconGlyphs.User}" Style="{StaticResource IconLabel}"
                               FontSize="19" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label x:Name="NameLabel" Style="{StaticResource CardTitleLabel}" FontSize="17" />
                        <Label Text="Signed in to LogiFlow" Style="{StaticResource MetaLabel}" />
                        <Label x:Name="RoleLabel" FontFamily="PoppinsSemiBold" FontSize="10"
                               TextColor="{StaticResource Primary}" TextTransform="Uppercase" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Account details -->
            <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*" Padding="16,15,16,8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Account &amp; app" Style="{StaticResource CardTitleLabel}" FontSize="15" />
                            <Label Text="Your access and installed version" Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Padding="16,13" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 11">
                            <Label Text="{x:Static services:IconGlyphs.IdCard}" Style="{StaticResource IconLabel}"
                                   FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="ROLE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                            <Label x:Name="RoleDetailLabel" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource CardBorderLight}" Color="{StaticResource CardBorderLight}" Margin="16,0" />

                    <Grid ColumnDefinitions="Auto,*" Padding="16,13" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 11">
                            <Label Text="{x:Static services:IconGlyphs.Gear}" Style="{StaticResource IconLabel}"
                                   FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="APP VERSION" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                            <Label x:Name="VersionLabel" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,13" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 11">
                            <Label Text="{x:Static services:IconGlyphs.Bell}" Style="{StaticResource IconLabel}"
                                   FontSize="14" TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Live updates" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                            <Label Text="Realtime job and alert sync is enabled." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="10,5" StrokeThickness="0" BackgroundColor="{StaticResource StatusSuccessTint}"
                                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label Text="ON" FontSize="11" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusSuccess}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Log out" Clicked="OnLogoutClicked" Margin="0,6,0,0"
                    BackgroundColor="{StaticResource StatusExceptionTint}" TextColor="{StaticResource StatusException}"
                    FontFamily="PoppinsSemiBold" FontSize="13" CornerRadius="14" Padding="14,10"
                    MinimumHeightRequest="46" BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.RightFromBracket}"
                                     Color="{StaticResource StatusException}" Size="14" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
