<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.TransporterPickerPage"
             Title="Select Transporter"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid>
        <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                StrokeShape="Rectangle" Padding="20,24,20,18"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="SELECT TRANSPORTER" TextColor="{StaticResource Primary}"
                               FontSize="11" CharacterSpacing="1.2" FontFamily="PoppinsRegular" />
                        <Label Text="Transporter" TextColor="#172033"
                               FontSize="26" FontFamily="PoppinsSemiBold" />
                        <Label Text="Choose a saved transporter or enter a new one."
                               TextColor="#687387" FontSize="13" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" StrokeThickness="1"
                            Stroke="#D8DEE9" BackgroundColor="White" StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static services:IconGlyphs.Xmark}" Style="{StaticResource IconLabel}"
                               FontSize="14" TextColor="#687387" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Stroke="#DCE5F5" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" BackgroundColor="White"
                        Padding="8,0" HeightRequest="50">
                    <SearchBar x:Name="SearchBarControl" Placeholder="Search or enter transporter"
                               TextChanged="OnSearchTextChanged" />
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
                    <Border x:Name="UseTypedTransporterCard" Grid.Row="0" Style="{StaticResource CardBorder}"
                            StrokeShape="RoundRectangle 16" Padding="14" IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUseTypedTransporterTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 20">
                                <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                       FontSize="15" TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="UseTypedTransporterLabel" FontFamily="PoppinsSemiBold" FontSize="14"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="Not in records — use as entered" Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}"
                                   Style="{StaticResource IconLabel}" FontSize="12"
                                   TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <HorizontalStackLayout x:Name="NoResultsLabel" Spacing="8"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="False" Margin="0,12">
                        <Label Text="{x:Static services:IconGlyphs.CircleXmark}" Style="{StaticResource IconLabel}"
                               FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                        <Label Text="No matching transporters." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                    </HorizontalStackLayout>

                    <CollectionView x:Name="ResultsCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Stroke="#E4E9F1" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16" BackgroundColor="White"
                                        Padding="14" Margin="0,0,0,10">
                                    <Border.Shadow>
                                        <Shadow Brush="#23344F" Offset="0,6" Radius="18" Opacity="0.04" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                                StrokeThickness="0" BackgroundColor="#EAF1FF"
                                                StrokeShape="RoundRectangle 14">
                                            <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                                   FontSize="15" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding .}" FontFamily="PoppinsSemiBold"
                                                   FontSize="14" TextColor="#172033" />
                                            <Label Text="Registered transporter" Style="{StaticResource MetaLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}"
                                               Style="{StaticResource IconLabel}" FontSize="12"
                                               TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    </Grid>
                </Grid>

                <Button Grid.Row="3" Text="Cancel" Clicked="OnCancelClicked" Style="{StaticResource IconTextButton}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Xmark}"
                                         Color="{StaticResource Primary}" Size="13" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
