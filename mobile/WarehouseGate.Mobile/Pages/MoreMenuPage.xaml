<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.MoreMenuPage"
             Title="More"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#660F172A">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border Grid.Row="1" Margin="14,0,14,24" Padding="10"
                Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                BackgroundColor="White" StrokeShape="RoundRectangle 20">
            <Border.Shadow>
                <Shadow Brush="#1E3A8A" Offset="0,8" Radius="24" Opacity="0.12" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2">
                <Grid x:Name="StatusMenuRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnStatusTapped" /></Grid.GestureRecognizers>
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 11">
                        <Label Text="{x:Static services:IconGlyphs.ClipboardList}" FontFamily="FaSolid" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Vehicle status" FontFamily="PoppinsSemiBold" FontSize="13" />
                        <Label Text="Track gate movements" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" FontFamily="FaSolid" FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsTapped" /></Grid.GestureRecognizers>
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 11">
                        <Label Text="{x:Static services:IconGlyphs.Bell}" FontFamily="FaSolid" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Notifications" FontFamily="PoppinsSemiBold" FontSize="13" />
                        <Label Text="Review operational alerts" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" FontFamily="FaSolid" FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped" /></Grid.GestureRecognizers>
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 11">
                        <Label Text="{x:Static services:IconGlyphs.User}" FontFamily="FaSolid" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Profile &amp; settings" FontFamily="PoppinsSemiBold" FontSize="13" />
                        <Label Text="Account, access, and app information" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" FontFamily="FaSolid" FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" Margin="0,3" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,11">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLogoutTapped" /></Grid.GestureRecognizers>
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="{StaticResource StatusExceptionTint}" StrokeShape="RoundRectangle 11">
                        <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" FontFamily="FaSolid" FontSize="14" TextColor="{StaticResource StatusException}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Log out" FontFamily="PoppinsSemiBold" FontSize="13" TextColor="{StaticResource StatusException}" />
                        <Label Text="End this session securely" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" FontFamily="FaSolid" FontSize="11" TextColor="{StaticResource StatusException}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
