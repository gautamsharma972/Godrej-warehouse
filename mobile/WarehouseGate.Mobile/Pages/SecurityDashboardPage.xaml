<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SecurityDashboardPage"
             Title="Dashboard"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Locked"
             BackgroundColor="#F8FAFC">

    <Grid>
        <RefreshView x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="30,26,30,30" Spacing="18">
                    <controls:AppHeaderView AccountRoute="//SecurityTabs/SecurityAccountPage" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,4,0,2">
                        <VerticalStackLayout Grid.Column="0" Spacing="7">
                            <Label Text="SECURITY OPERATIONS" TextColor="{StaticResource Primary}"
                                   FontSize="11" CharacterSpacing="1.2" FontFamily="PoppinsRegular" />
                            <Label Text="Dashboard" TextColor="#172033"
                                   FontSize="30" FontFamily="PoppinsSemiBold" />
                            <Label Text="Live gate activity, exit queue, and exception signals at a glance."
                                   TextColor="#687387" FontSize="13" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1" Stroke="#CFEEDE" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" Padding="16,10"
                                BackgroundColor="#F4FCF8" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                                       FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label x:Name="ScopeLabel" Text="Mapped warehouse" TextColor="{StaticResource Primary}"
                                       FontSize="13" FontFamily="PoppinsRegular" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Stroke="#E4E9F1" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="White" Padding="22">
                            <Border.Shadow>
                                <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="#E9FBF8" VerticalOptions="Center">
                                    <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                           FontSize="24" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="GATE ACTIVITY" TextColor="#4D596D"
                                           FontSize="11" CharacterSpacing="0.8" FontFamily="PoppinsRegular" />
                                    <Label Text="Active vehicles" TextColor="#172033"
                                           FontSize="15" FontFamily="PoppinsSemiBold" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" x:Name="ActiveCountLabel" TextColor="{StaticResource Primary}"
                                       FontSize="42" FontFamily="PoppinsSemiBold"
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Stroke="#E4E9F1" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="White" Padding="22">
                            <Border.Shadow>
                                <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{StaticResource StatusAvailableTint}" VerticalOptions="Center">
                                    <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" Style="{StaticResource IconLabel}"
                                           FontSize="24" TextColor="{StaticResource StatusAvailable}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="EXIT QUEUE" TextColor="#4D596D"
                                           FontSize="11" CharacterSpacing="0.8" FontFamily="PoppinsRegular" />
                                    <Label Text="Ready to exit" TextColor="#172033"
                                           FontSize="15" FontFamily="PoppinsSemiBold" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" x:Name="ReadyToExitCountLabel" TextColor="{StaticResource StatusAvailable}"
                                       FontSize="42" FontFamily="PoppinsSemiBold"
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Stroke="#E4E9F1" StrokeThickness="1"
                                BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckInQuickActionClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14" BackgroundColor="#E9FBF8">
                                    <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                                           FontSize="18" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Check-In" TextColor="#172033" FontFamily="PoppinsSemiBold" FontSize="14" />
                                    <Label Text="Register incoming vehicles" TextColor="#687387" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                       FontSize="12" TextColor="#A2ADBD" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Stroke="#E4E9F1" StrokeThickness="1"
                                BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStatusQuickActionClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource StatusAvailableTint}">
                                    <Label Text="{x:Static services:IconGlyphs.ClipboardList}" Style="{StaticResource IconLabel}"
                                           FontSize="18" TextColor="{StaticResource StatusAvailable}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Status" TextColor="#172033" FontFamily="PoppinsSemiBold" FontSize="14" />
                                    <Label Text="Monitor active gate flow" TextColor="#687387" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                       FontSize="12" TextColor="#A2ADBD" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Stroke="#E4E9F1" StrokeThickness="1"
                                BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExitQuickActionClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource StatusSuccessTint}">
                                    <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" Style="{StaticResource IconLabel}"
                                           FontSize="18" TextColor="{StaticResource StatusSuccess}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Outwards" TextColor="#172033" FontFamily="PoppinsSemiBold" FontSize="14" />
                                    <Label Text="Process vehicle exits" TextColor="#687387" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                       FontSize="12" TextColor="#A2ADBD" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Stroke="#E4E9F1" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18" BackgroundColor="White" Padding="0">
                        <Border.Shadow>
                            <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="20,18">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        BackgroundColor="#E9FBF8" StrokeShape="RoundRectangle 14">
                                    <Label Text="{x:Static services:IconGlyphs.Bell}" Style="{StaticResource IconLabel}"
                                           FontSize="16" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Needs Your Attention" TextColor="#172033"
                                           FontSize="17" FontFamily="PoppinsSemiBold" />
                                    <Label Text="Signals that may need gate-side follow-up."
                                           TextColor="#687387" FontSize="12" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="7" VerticalOptions="Center">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewAllAttentionTapped" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Text="View all" FontSize="13" FontFamily="PoppinsRegular"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                           FontSize="11" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E4E9F1" />
                            <VerticalStackLayout x:Name="AttentionContainer" Spacing="0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="18,14"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 12">
            <Label x:Name="LiveBannerLabel" TextColor="White" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
