<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.LoginPage"
             Title="WarehouseGate"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8F7">

    <Grid BackgroundColor="#F6F8F7">
        <Grid x:Name="RootGrid" ColumnSpacing="0" RowSpacing="0" VerticalOptions="Fill">

                <Border x:Name="LeftPanel" Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0" Padding="46,34" VerticalOptions="Fill"
                        BackgroundColor="#183F3D">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#102C34" Offset="0" />
                            <GradientStop Color="#18453E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                        <Border Grid.Row="0" WidthRequest="58" HeightRequest="58"
                                Stroke="#66FFFFFF" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#22FFFFFF"
                                HorizontalOptions="Start">
                            <Label Text="WG" TextColor="White" FontFamily="PoppinsSemiBold" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="GODREJ WAREHOUSE OPERATIONS"
                                       TextColor="#D7ECE6" FontFamily="PoppinsSemiBold"
                                       FontSize="12" CharacterSpacing="1.1" />
                                <Label Text="WarehouseGate&#10;Portal"
                                       TextColor="White" FontFamily="PoppinsRegular"
                                       FontSize="50" LineHeight="0.95" />
                                <Label Text="Secure access for management, logistics, and office teams coordinating gated warehouse movement."
                                       TextColor="#C9D8D5" FontFamily="PoppinsSemiBold"
                                       FontSize="15" LineHeight="1.45" MaxLines="2" />
                            </VerticalStackLayout>

                            <GraphicsView x:Name="HeroGraphicsView" HeightRequest="0" IsVisible="False" />
                        </VerticalStackLayout>

                        <Border Grid.Row="2" Stroke="#2EFFFFFF" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="16"
                                BackgroundColor="#1AFFFFFF">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Operations Console"
                                           TextColor="#C9D8D5" FontFamily="PoppinsSemiBold"
                                           FontSize="13" VerticalOptions="Center" />
                                    <Border Grid.Column="1" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13" Padding="12,6"
                                            BackgroundColor="#D9F99D">
                                        <Label Text="LIVE" TextColor="#234018" FontFamily="PoppinsSemiBold"
                                               FontSize="11" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#2DFFFFFF" />
                                    <Border Grid.Column="1" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#B8C52D21" />
                                    <Border Grid.Column="2" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#A65EEAD4" />
                                    <Border Grid.Column="3" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#2DFFFFFF" />
                                    <Border Grid.Column="4" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#B8C52D21" />
                                    <Border Grid.Column="5" HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#2DFFFFFF" />
                                </Grid>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="26,120,*" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                               FontSize="15" TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="WORKFLOW PACE" TextColor="#95AAA5"
                                               FontFamily="PoppinsSemiBold" FontSize="11" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="Balanced daily movement planning" TextColor="White"
                                               FontFamily="PoppinsSemiBold" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="26,120,*" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Eye}" Style="{StaticResource IconLabel}"
                                               FontSize="15" TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="YARD VISIBILITY" TextColor="#95AAA5"
                                               FontFamily="PoppinsSemiBold" FontSize="11" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="Clear context across active gates" TextColor="White"
                                               FontFamily="PoppinsSemiBold" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="26,120,*" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.User}" Style="{StaticResource IconLabel}"
                                               FontSize="15" TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="TEAM HANDOFF" TextColor="#95AAA5"
                                               FontFamily="PoppinsSemiBold" FontSize="11" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="Smoother coordination between shifts" TextColor="White"
                                               FontFamily="PoppinsSemiBold" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="CompactHeader" Grid.Row="0" Grid.Column="0"
                                     Spacing="12" Padding="22,26,22,18" IsVisible="False"
                                     BackgroundColor="#183F3D">
                    <Border x:Name="CompactLogo" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 12" Stroke="#66FFFFFF"
                            BackgroundColor="#22FFFFFF">
                        <Label Text="WG" TextColor="White" FontFamily="PoppinsSemiBold" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="CompactTitle" Text="WarehouseGate Portal" TextColor="White" FontFamily="PoppinsSemiBold"
                           FontSize="27" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label x:Name="CompactSubtitle" Text="Secure warehouse operations access" TextColor="#C9D8D5"
                           FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Grid x:Name="RightPanel" Grid.Row="0" Grid.Column="1" Padding="46" BackgroundColor="#F6F8F7">
                    <Border x:Name="SignInCard"
                            Padding="40" MaximumWidthRequest="520"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Stroke="#DFE7E4" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#162426" Offset="0,18" Radius="44" Opacity="0.13" />
                        </Border.Shadow>

                        <VerticalStackLayout x:Name="CardStack" Spacing="18">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label x:Name="EyebrowLabel" Text="ENTERPRISE SIGN IN"
                                           TextColor="#537069" FontFamily="PoppinsRegular"
                                           FontSize="13" CharacterSpacing="1.2" />
                                    <Label x:Name="WelcomeLabel" Text="Welcome back" FontFamily="PoppinsRegular" FontSize="34"
                                           TextColor="#152024" />
                                </VerticalStackLayout>

                                <Border x:Name="SecureBadge" Grid.Column="1" Stroke="#BFE4D5" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18" Padding="12,7"
                                        BackgroundColor="#EFFBF5" VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="8">
                                        <Ellipse WidthRequest="7" HeightRequest="7" Fill="#21A66A"
                                                 VerticalOptions="Center" />
                                        <Label Text="Secure" TextColor="#17633F"
                                               FontFamily="PoppinsRegular" FontSize="13" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Label x:Name="IntroLabel" Text="Use your assigned WarehouseGate account to continue."
                                   TextColor="#5D6B70" FontSize="13" LineHeight="1.35" />

                            <VerticalStackLayout x:Name="FormStack" Spacing="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Username" FontSize="14" FontFamily="PoppinsRegular"
                                           TextColor="#263238" />
                                    <Border x:Name="UserNameFieldBorder" Stroke="#CFDAD6" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="15,0" HeightRequest="54"
                                            BackgroundColor="#FBFDFC">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.User}" Style="{StaticResource IconLabel}"
                                                   FontSize="16" TextColor="#6C7A80" VerticalOptions="Center" />
                                            <Entry Grid.Column="1" x:Name="UserNameEntry" Placeholder="Enter your username"
                                                   ClearButtonVisibility="WhileEditing"
                                                   VerticalOptions="Center" TextChanged="OnUserNameChanged"
                                                   Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                                            <Label Grid.Column="2" x:Name="UserNameCheckLabel" Text="{x:Static services:IconGlyphs.CircleCheck}"
                                                   Style="{StaticResource IconLabel}" FontSize="17" TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center" IsVisible="False" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Password" FontSize="14" FontFamily="PoppinsRegular"
                                               TextColor="#263238" />
                                        <Label Grid.Column="1" Text="Forgot password?" FontSize="14" FontFamily="PoppinsRegular"
                                               TextColor="#0F766E" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <Border x:Name="PasswordFieldBorder" Stroke="#CFDAD6" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6" Padding="15,0" HeightRequest="54"
                                            BackgroundColor="#FBFDFC">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Lock}" Style="{StaticResource IconLabel}"
                                                   FontSize="16" TextColor="#6C7A80" VerticalOptions="Center" />
                                            <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Enter your password" IsPassword="True"
                                                   VerticalOptions="Center" Completed="OnLoginClicked"
                                                   Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                                            <Label Grid.Column="2" x:Name="PasswordEyeLabel" Text="{x:Static services:IconGlyphs.Eye}"
                                                   Style="{StaticResource IconLabel}" FontSize="16" TextColor="#6C7A80"
                                                   VerticalOptions="Center" Padding="8,12">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                        <CheckBox x:Name="RememberMeCheckBox" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                        <Label Text="Remember username" FontSize="14" TextColor="#263238" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRememberMeLabelTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>

                                <Button x:Name="LoginButton" Text="Log in" Clicked="OnLoginClicked"
                                        HeightRequest="54" CornerRadius="6" Margin="0,4,0,0"
                                        BackgroundColor="#B91C1C" TextColor="White"
                                        FontFamily="PoppinsSemiBold" FontSize="14">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.ArrowRight}" Color="White" Size="14" />
                                    </Button.ImageSource>
                                </Button>
                            </VerticalStackLayout>

                            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />

                            <Border x:Name="ErrorBorder" IsVisible="False" Padding="13,11" StrokeThickness="0"
                                    BackgroundColor="{StaticResource StatusExceptionTint}" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.TriangleExclamation}" Style="{StaticResource IconLabel}"
                                           FontSize="14" TextColor="{StaticResource StatusException}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" x:Name="ErrorLabel" TextColor="{StaticResource StatusException}"
                                           VerticalOptions="Center" LineBreakMode="WordWrap" FontSize="12" />
                                </Grid>
                            </Border>

                            <BoxView x:Name="FooterDivider" HeightRequest="1" Color="#E5ECE9" Margin="0,6,0,0" />

                            <Grid x:Name="CardFooter" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Need access?" TextColor="#627278" FontSize="14" />
                                <Label Grid.Column="1" Text="Contact IT support" TextColor="#0F766E"
                                       FontSize="14" FontFamily="PoppinsRegular" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</ContentPage>
