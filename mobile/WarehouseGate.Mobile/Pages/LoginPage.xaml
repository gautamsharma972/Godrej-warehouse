<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.LoginPage"
             Title="LogiFlow"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{StaticResource SurfaceLight}">

    <Grid x:Name="RootGrid" RowDefinitions="180,*,Auto" RowSpacing="0" BackgroundColor="{StaticResource SurfaceLight}">
        <!-- Brand hero -->
        <Grid Grid.Row="0" Padding="20,12,20,26">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F2FB" Offset="0" />
                    <GradientStop Color="#F8FBFE" Offset="0.58" />
                    <GradientStop Color="#EEF5FC" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="logiflow_brand_lockup.png" WidthRequest="210" HeightRequest="88"
                       Aspect="AspectFit" HorizontalOptions="Center" />
                <Label x:Name="EyebrowLabel" Text="MOBILE OPERATIONS"
                       FontFamily="PoppinsSemiBold" FontSize="9" CharacterSpacing="1.5"
                       TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                <Label Text="Secure warehouse movement, made simple."
                       Margin="0,2,0,0" FontSize="11" TextColor="#687387"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Form sheet -->
        <Border x:Name="SignInCard" Grid.Row="1" Margin="12,-18,12,10" Padding="0"
                MaximumWidthRequest="560" HorizontalOptions="Fill"
                Stroke="#D7E4F2" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                BackgroundColor="#FFFFFF">
            <Border.Shadow>
                <Shadow Brush="#2B5C99" Offset="0,5" Radius="18" Opacity="0.08" />
            </Border.Shadow>
            <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <Grid x:Name="RightPanel" Padding="16,18,16,16">
                    <VerticalStackLayout x:Name="CardStack" Spacing="18" MaximumWidthRequest="420"
                                         HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="WelcomeLabel" Text="Welcome back" FontFamily="PoppinsSemiBold"
                                   FontSize="19" TextColor="#172033" />
                            <Label x:Name="IntroLabel" Text="Sign in with your assigned account."
                                   FontSize="12" TextColor="#687387" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="FormStack" Spacing="14">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Organization code" FontSize="11"
                                       FontFamily="PoppinsMedium" TextColor="#344054" />
                                <Grid HeightRequest="50" ColumnDefinitions="42,*">
                                    <!-- The outline is a sibling behind the Entry, so Android text cannot be clipped by it. -->
                                    <Border x:Name="OrgCodeFieldBorder" Grid.ColumnSpan="2"
                                            Stroke="#D7E4F2" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12" BackgroundColor="#F8FBFE" />
                                    <Image Grid.Column="0" Source="login_building.svg" WidthRequest="17" HeightRequest="17"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" x:Name="OrgCodeEntry" Margin="0,0,14,0"
                                           Text="GCPL" Placeholder="e.g. GCPL" ClearButtonVisibility="Never"
                                           TextColor="#172033" PlaceholderColor="#8A9895"
                                           BackgroundColor="Transparent" FontSize="14"
                                           TranslationY="2"
                                           VerticalTextAlignment="Center" VerticalOptions="Fill"
                                           Focused="OnFieldFocused" Unfocused="OnFieldUnfocused"
                                           HandlerChanged="OnEntryHandlerChanged" Loaded="OnEntryLoaded" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="7">
                                <Label Text="Username" FontSize="11"
                                       FontFamily="PoppinsMedium" TextColor="#344054" />
                                <Grid HeightRequest="50" ColumnDefinitions="42,*,38">
                                    <Border x:Name="UserNameFieldBorder" Grid.ColumnSpan="3"
                                            Stroke="#D7E4F2" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12" BackgroundColor="#F8FBFE" />
                                    <Image Grid.Column="0" Source="login_user.svg" WidthRequest="17" HeightRequest="17"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" x:Name="UserNameEntry"
                                           Placeholder="Enter your username" ClearButtonVisibility="Never"
                                           TextColor="#172033" PlaceholderColor="#8A9895"
                                           BackgroundColor="Transparent" FontSize="14"
                                           TranslationY="2"
                                           VerticalTextAlignment="Center" VerticalOptions="Fill"
                                           TextChanged="OnUserNameChanged" Focused="OnFieldFocused"
                                           Unfocused="OnFieldUnfocused" HandlerChanged="OnEntryHandlerChanged"
                                           Loaded="OnEntryLoaded" />
                                    <Image Grid.Column="2" x:Name="UserNameCheckLabel" Source="login_check.svg"
                                           WidthRequest="17" HeightRequest="17" HorizontalOptions="Center"
                                           VerticalOptions="Center" IsVisible="False" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Password" FontSize="11"
                                           FontFamily="PoppinsMedium" TextColor="#344054" />
                                    <Label Grid.Column="1" Text="Forgot password?" FontSize="12"
                                           FontFamily="PoppinsMedium" TextColor="{StaticResource Primary}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <Grid HeightRequest="50" ColumnDefinitions="42,*,42">
                                    <Border x:Name="PasswordFieldBorder" Grid.ColumnSpan="3"
                                            Stroke="#D7E4F2" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12" BackgroundColor="#F8FBFE" />
                                    <Image Grid.Column="0" Source="login_lock.svg" WidthRequest="17" HeightRequest="17"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" x:Name="PasswordEntry"
                                           Placeholder="Enter your password" IsPassword="True"
                                           TextColor="#172033" PlaceholderColor="#8A9895"
                                           BackgroundColor="Transparent" FontSize="14"
                                           TranslationY="2"
                                           VerticalTextAlignment="Center" VerticalOptions="Fill"
                                           Completed="OnLoginClicked" Focused="OnFieldFocused"
                                           Unfocused="OnFieldUnfocused" HandlerChanged="OnEntryHandlerChanged"
                                           Loaded="OnEntryLoaded" />
                                    <Image Grid.Column="2" x:Name="PasswordEyeLabel" Source="login_eye.svg"
                                           WidthRequest="40" HeightRequest="40" HorizontalOptions="Center"
                                           VerticalOptions="Center" Aspect="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" Margin="-5,-3,0,0">
                                <HorizontalStackLayout Spacing="5">
                                    <CheckBox x:Name="RememberMeCheckBox" Color="{StaticResource Primary}"
                                              VerticalOptions="Center" />
                                    <Label Text="Remember username" FontSize="12"
                                           TextColor="#536078" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRememberMeLabelTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#18A06A" />
                                    <Label Text="Secure access" FontSize="11" TextColor="#5B6980" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Button x:Name="LoginButton" Text="Sign in" Clicked="OnLoginClicked"
                                    HeightRequest="50" CornerRadius="12" Margin="0,2,0,0"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    FontFamily="PoppinsSemiBold" FontSize="14" />
                        </VerticalStackLayout>

                        <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False"
                                           Color="{StaticResource Primary}" />

                        <Border x:Name="ErrorBorder" IsVisible="False" Padding="13,11"
                                StrokeThickness="0" BackgroundColor="{StaticResource StatusExceptionTint}"
                                StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <Label Text="{x:Static services:IconGlyphs.TriangleExclamation}"
                                       Style="{StaticResource IconLabel}" FontSize="14"
                                       TextColor="{StaticResource StatusException}" VerticalOptions="Center" />
                                <Label Grid.Column="1" x:Name="ErrorLabel" FontSize="12"
                                       TextColor="{StaticResource StatusException}"
                                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>

                        <BoxView x:Name="FooterDivider" HeightRequest="1" Color="#E4EAF5" />

                        <Grid x:Name="CardFooter" ColumnDefinitions="*,Auto">
                            <Label Text="Need an account?" TextColor="#687387" FontSize="12" />
                            <Label Grid.Column="1" Text="Contact IT support" TextColor="{StaticResource Primary}"
                                   FontSize="12" FontFamily="PoppinsMedium" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
            </Grid>
        </Border>

        <Image Grid.Row="2" Source="powered_by_logivue.png"
               WidthRequest="76" HeightRequest="31" Aspect="AspectFit"
               Margin="0,1,0,6" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
