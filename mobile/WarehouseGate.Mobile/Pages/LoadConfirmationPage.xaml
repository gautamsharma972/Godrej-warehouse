<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.LoadConfirmationPage"
             Title="Confirm Loading"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceLight}">
        <Grid Grid.Row="0" BackgroundColor="Transparent">
            <controls:BackHeaderView x:Name="PageHeaderView" PageTitle="Confirm loading" Title="Review and confirm load lines">
                <controls:BackHeaderView.TrailingContent>
                    <Border x:Name="TopProgressRing" WidthRequest="42" HeightRequest="42"
                            Stroke="{StaticResource Primary}" StrokeThickness="3"
                            BackgroundColor="#F5F9FD" StrokeShape="RoundRectangle 21"
                            SemanticProperties.Description="Loading progress">
                        <Label x:Name="TopProgressLabel" Text="0%" FontSize="10"
                               FontFamily="PoppinsBold" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </controls:BackHeaderView.TrailingContent>
            </controls:BackHeaderView>
            <BoxView HeightRequest="1" Color="#E4E9F1" VerticalOptions="End" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,10,14,18" Spacing="14">

                <Border x:Name="ProgressActionSection" StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                    <Grid x:Name="HeaderCardGrid" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="12" ColumnSpacing="14">
                        <Border x:Name="HeaderIconBorder" Grid.Row="0" Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start" IsVisible="False">
                            <Label Text="{x:Static services:IconGlyphs.ClipboardCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="18" TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout x:Name="HeaderMessageStack" Grid.Row="0" Grid.Column="1" Spacing="3" IsVisible="False">
                            <Label x:Name="HeaderLabel" Text="Loading progress" Style="{StaticResource CardTitleLabel}" FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="HeaderButtonStack" Grid.Row="0" Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                            <Button x:Name="StartLoadingAllButton" Text="Start Loading  0%" Clicked="OnStartLoadingAllClicked"
                                    Style="{StaticResource PrimaryActionButton}" HeightRequest="46" CornerRadius="15"
                                    FontSize="12" Padding="18,0" MinimumWidthRequest="156">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.CircleCheck}" Color="{StaticResource PrimaryDarkText}" Size="12" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>

                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProgressLabel" Style="{StaticResource MetaLabel}" TextColor="{StaticResource Primary}" IsVisible="False" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProgressBar" HeightRequest="6" IsVisible="False" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="StepsContainer" Spacing="14" />

                <Label x:Name="NoStepsLabel" Text="No load plan selected for this job yet." Style="{StaticResource EmptyStateLabel}" IsVisible="False" />

                <!-- Load lines, photo evidence, exceptions, dispatch-ready and Complete all happen
                     here now, instead of on a separate job-detail screen the supervisor would
                     otherwise have to navigate back out to. Each load line lists its underlying
                     placement group(s) with Loaded/Mismatch/Short/Skip/Photo actions inline. -->
                <VerticalStackLayout x:Name="FinalSection" Spacing="16" IsVisible="False">

                    <Border x:Name="LoadLinesSection" StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,0">
                                <Label Grid.Column="0" Text="Load lines" Style="{StaticResource CardTitleLabel}" FontSize="15" VerticalOptions="Center" />
                                <Border x:Name="LoadLinesSavedBanner" Grid.Column="1" Padding="9,4" StrokeThickness="0"
                                        BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center" IsVisible="False">
                                    <Label Text="Saved" FontSize="11" FontFamily="PoppinsBold" TextColor="{StaticResource StatusSuccess}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout x:Name="LoadLinesContainer" Spacing="12" />

                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1" Color="#E1ECEA" Margin="2,2" />

                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="0">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,0,2,10">
                                <Label Grid.Column="0" Text="Photo evidence" Style="{StaticResource CardTitleLabel}"
                                       FontSize="15" VerticalOptions="Center" />
                                <Border Grid.Column="1" Padding="9,4" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                        StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                    <Label x:Name="PhotoCountLabel" FontSize="11" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="2,10,2,0">
                                    <Border StrokeThickness="0" BackgroundColor="#EAF6FF"
                                            StrokeShape="RoundRectangle 9" Padding="9,6" HorizontalOptions="Start">
                                        <HorizontalStackLayout Spacing="7">
                                            <Label Text="{x:Static services:IconGlyphs.CircleInfo}" Style="{StaticResource IconLabel}"
                                                   FontSize="10" TextColor="#168AC5" VerticalOptions="Center" />
                                            <Label x:Name="PhotoLimitHintLabel" FontSize="10" TextColor="#39738F" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border x:Name="PhotoLimitLabel" StrokeThickness="0" BackgroundColor="{StaticResource StatusExceptionTint}"
                                            StrokeShape="RoundRectangle 16" Padding="12,10" IsVisible="False">
                                            <Label x:Name="PhotoLimitReachedLabel" FontSize="11" FontFamily="PoppinsSemiBold"
                                                   TextColor="{StaticResource StatusException}" HorizontalOptions="Center" />
                                    </Border>

                                    <Border x:Name="NoPhotosLabel" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                            BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 20"
                                            Padding="12,10" IsVisible="False">
                                        <Label Text="No photos captured yet. Use the Add Photo button on a SKU below." Style="{StaticResource MetaLabel}"
                                               FontSize="11" HorizontalOptions="Center" />
                                    </Border>
                            </VerticalStackLayout>

                            <Grid Grid.Row="1" ColumnDefinitions="*" Padding="0">
                                <CollectionView Grid.Column="0" x:Name="PhotoGallery" HeightRequest="122"
                                                HorizontalOptions="Fill" IsVisible="False">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PhotoDisplayItem">
                                            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 12"
                                                    Padding="0" WidthRequest="154" HeightRequest="112">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Image Source="{Binding Source}" Aspect="AspectFill" IsVisible="{Binding HasLocalImage}" />
                                                    <VerticalStackLayout IsVisible="{Binding IsPlaceholder}" VerticalOptions="Center" Spacing="6">
                                                        <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                                               FontSize="24" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                                        <Label Text="{Binding FriendlyType}" FontSize="12" FontFamily="PoppinsSemiBold"
                                                               TextColor="{StaticResource TextPrimaryLight}" HorizontalOptions="Center" />
                                                        <Label Text="Loading preview" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" />
                                                    </VerticalStackLayout>
                                                    <Border VerticalOptions="End" HorizontalOptions="Fill" Padding="9,7"
                                                            StrokeThickness="0" BackgroundColor="#E8F2FB">
                                                        <Label Text="{Binding Description}" FontSize="11"
                                                               TextColor="{StaticResource TextPrimaryLight}" LineBreakMode="TailTruncation" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" Color="#E1ECEA" Margin="2,2" />

                    <Grid x:Name="FinalActionsGrid" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                <Button x:Name="ConfirmDispatchReadyButton" Text="Confirm Dispatch Ready" Clicked="OnConfirmDispatchReadyClicked"
                                        Style="{StaticResource SecondaryActionButton}" HeightRequest="58">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.CircleCheck}" Color="{StaticResource Primary}" Size="14" />
                                    </Button.ImageSource>
                                </Button>
                                <Border x:Name="DispatchReadyConfirmedBanner" IsVisible="False" StrokeThickness="1" Stroke="{StaticResource StatusSuccess}"
                                        BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 12" Padding="11,8">
                                    <HorizontalStackLayout Spacing="7">
                                        <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                               FontSize="11" TextColor="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                                        <Label x:Name="DispatchReadyConfirmedLabel" FontSize="11" FontFamily="PoppinsSemiBold"
                                               TextColor="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button x:Name="CompleteButton" Text="Complete Loading" Clicked="OnCompleteClicked"
                                    IsVisible="False" Style="{StaticResource PrimaryActionButton}" HeightRequest="58"
                                    BackgroundColor="{StaticResource StatusSuccess}" TextColor="White" />
                            <Label x:Name="CompleteHintLabel" Style="{StaticResource MetaLabel}" IsVisible="False" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>

                <BoxView HeightRequest="12" Opacity="0" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False"
                           Color="{StaticResource Primary}" WidthRequest="44" HeightRequest="44"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
