<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             x:Class="WarehouseGate.Mobile.Pages.LoadConfirmationPage"
             Title="Confirm Loading"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid BackgroundColor="{StaticResource SurfaceLight}">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="16">

                <controls:BackHeaderView Title="Back to job" />

                <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" BackgroundColor="{StaticResource CardLight}"
                        StrokeShape="RoundRectangle 18" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#DCEAE8" Offset="0,8" Radius="18" Opacity="0.36" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="12" ColumnSpacing="14">
                        <Border Grid.Row="0" Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">
                            <Label Text="{x:Static services:IconGlyphs.ClipboardCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="18" TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                            <Label x:Name="HeaderLabel" Style="{StaticResource CardTitleLabel}" FontSize="18" />
                            <Label Text="Start Loading confirms every pending group at once." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                            <Button x:Name="StartLoadingAllButton" Text="Start Loading  0%" Clicked="OnStartLoadingAllClicked"
                                    Style="{StaticResource PrimaryActionButton}" HeightRequest="46" CornerRadius="15"
                                    FontSize="12" Padding="18,0" MinimumWidthRequest="156">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.CircleCheck}" Color="{StaticResource PrimaryDarkText}" Size="12" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>

                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProgressLabel" Style="{StaticResource MetaLabel}" TextColor="{StaticResource Primary}" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProgressBar" HeightRequest="6" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="StepsContainer" Spacing="14" />

                <Label x:Name="NoStepsLabel" Text="No load plan selected for this job yet." Style="{StaticResource EmptyStateLabel}" IsVisible="False" />

                <!-- Load lines, photo evidence, exceptions, dispatch-ready and Complete all happen
                     here now, instead of on a separate job-detail screen the supervisor would
                     otherwise have to navigate back out to. Each load line lists its underlying
                     placement group(s) with Loaded/Mismatch/Short/Skip/Photo actions inline. -->
                <VerticalStackLayout x:Name="FinalSection" Spacing="16" IsVisible="False">

                    <Border x:Name="LoadLinesSection" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" BackgroundColor="{StaticResource CardLight}"
                            StrokeShape="RoundRectangle 20" Padding="16">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14">
                                    <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                           FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Load lines" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                                    <Label Text="Swipe products, adjust quantities, and resolve each loading zone." Style="{StaticResource MetaLabel}" />
                                </VerticalStackLayout>
                                <Border x:Name="LoadLinesSavedBanner" Grid.Column="2" Padding="10,5" StrokeThickness="0"
                                        BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center" IsVisible="False">
                                    <Label Text="Saved" FontSize="11" FontFamily="PoppinsBold" TextColor="{StaticResource StatusSuccess}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout x:Name="LoadLinesContainer" Spacing="12" />

                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" BackgroundColor="{StaticResource CardLight}"
                            StrokeShape="RoundRectangle 26" Padding="0">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*" RowSpacing="0">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16">
                                <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                                    <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                           FontSize="18" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Photo evidence" Style="{StaticResource CardTitleLabel}" FontSize="17" />
                                    <Label Text="Captured per SKU below - reviewed here." Style="{StaticResource MetaLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Padding="12,7" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                        StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                    <Label x:Name="PhotoCountLabel" FontSize="11" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="16,0,16,16">
                                    <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                            BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 20"
                                            Padding="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                                    BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14">
                                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                                       FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="Required before completion" FontSize="13" FontFamily="PoppinsSemiBold"
                                                       TextColor="{StaticResource TextPrimaryLight}" />
                                                <Label x:Name="PhotoLimitHintLabel" Style="{StaticResource MetaLabel}" FontSize="11" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="PhotoLimitLabel" StrokeThickness="0" BackgroundColor="{StaticResource StatusExceptionTint}"
                                            StrokeShape="RoundRectangle 16" Padding="12,10" IsVisible="False">
                                            <Label x:Name="PhotoLimitReachedLabel" FontSize="11" FontFamily="PoppinsSemiBold"
                                                   TextColor="{StaticResource StatusException}" HorizontalOptions="Center" />
                                    </Border>

                                    <Border x:Name="NoPhotosLabel" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                            BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 20"
                                            Padding="12,10" IsVisible="False">
                                        <Label Text="No photos captured yet. Use the Add Photo button on a SKU below." Style="{StaticResource MetaLabel}"
                                               FontSize="11" HorizontalOptions="Center" />
                                    </Border>
                            </VerticalStackLayout>

                            <Grid Grid.Row="2" ColumnDefinitions="*" Padding="16,0,16,16">
                                <CollectionView Grid.Column="0" x:Name="PhotoGallery" HeightRequest="142"
                                                HorizontalOptions="Fill" IsVisible="False">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PhotoDisplayItem">
                                            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 16"
                                                    Padding="0" WidthRequest="164" HeightRequest="130">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Image Source="{Binding Source}" Aspect="AspectFill" IsVisible="{Binding HasLocalImage}" />
                                                    <VerticalStackLayout IsVisible="{Binding IsPlaceholder}" VerticalOptions="Center" Spacing="6">
                                                        <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                                               FontSize="24" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                                        <Label Text="{Binding FriendlyType}" FontSize="12" FontFamily="PoppinsSemiBold"
                                                               TextColor="{StaticResource TextPrimaryLight}" HorizontalOptions="Center" />
                                                        <Label Text="Loading preview" FontSize="10" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" />
                                                    </VerticalStackLayout>
                                                    <Border VerticalOptions="End" HorizontalOptions="Fill" Padding="9,7"
                                                            StrokeThickness="0" BackgroundColor="#DDE6F3F1">
                                                        <Label Text="{Binding Description}" FontSize="11"
                                                               TextColor="{StaticResource TextPrimaryLight}" LineBreakMode="TailTruncation" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" BackgroundColor="{StaticResource CardLight}"
                                StrokeShape="RoundRectangle 22" Padding="16">
                            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                <Button x:Name="ConfirmDispatchReadyButton" Text="Confirm Dispatch Ready" Clicked="OnConfirmDispatchReadyClicked"
                                        Style="{StaticResource SecondaryActionButton}" HeightRequest="58">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.CircleCheck}" Color="{StaticResource Primary}" Size="14" />
                                    </Button.ImageSource>
                                </Button>
                                <Border x:Name="DispatchReadyConfirmedBanner" IsVisible="False" StrokeThickness="1" Stroke="{StaticResource StatusSuccess}"
                                        BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 14" Padding="12">
                                    <Label x:Name="DispatchReadyConfirmedLabel" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusSuccess}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button x:Name="CompleteButton" Text="Complete Loading" Clicked="OnCompleteClicked"
                                    IsVisible="False" Style="{StaticResource PrimaryActionButton}" HeightRequest="58"
                                    BackgroundColor="{StaticResource StatusSuccess}" TextColor="White" />
                            <Label x:Name="CompleteHintLabel" Style="{StaticResource MetaLabel}" IsVisible="False" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>

                <BoxView HeightRequest="12" Opacity="0" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False"
                           Color="{StaticResource Primary}" WidthRequest="44" HeightRequest="44"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
