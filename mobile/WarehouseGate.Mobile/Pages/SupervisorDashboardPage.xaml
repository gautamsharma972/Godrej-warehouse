<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SupervisorDashboardPage"
             Title="Dashboard"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Locked">

    <Grid>
        <RefreshView x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="32,28,32,32" Spacing="18">

                    <controls:AppHeaderView AccountRoute="//SupervisorTabs/SupervisorAccountPage" />

                    <Border StrokeThickness="0" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 24"
                            Padding="22,20" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0" WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 18">
                                <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                                       FontSize="20" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Dashboard" Style="{StaticResource PageTitleLabel}" FontSize="30" />
                                <Label Text="Live dock work, claims, and completions at a glance."
                                       Style="{StaticResource MetaLabel}" FontSize="13" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="End" VerticalOptions="Center">
                                <Border Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                        StrokeShape="RoundRectangle 16" WidthRequest="138">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 12">
                                            <Label Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                                   FontSize="13" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="-1" VerticalOptions="Center">
                                            <Label x:Name="ActiveCountLabel" FontFamily="PoppinsBold" FontSize="20"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="Active" FontFamily="PoppinsSemiBold" FontSize="11"
                                                   TextColor="{StaticResource TextSecondaryLight}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Border Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                        StrokeShape="RoundRectangle 16" WidthRequest="150">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                                BackgroundColor="{StaticResource StatusAvailableTint}" StrokeShape="RoundRectangle 12">
                                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                                   FontSize="13" TextColor="{StaticResource StatusAvailable}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="-1" VerticalOptions="Center">
                                            <Label x:Name="CompletedTodayCountLabel" FontFamily="PoppinsBold" FontSize="20"
                                                   TextColor="{StaticResource StatusAvailable}" />
                                            <Label Text="Completed" FontFamily="PoppinsSemiBold" FontSize="11"
                                                   TextColor="{StaticResource TextSecondaryLight}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout x:Name="QuickActionsSection" Spacing="12" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14">
                                <Label Text="{x:Static services:IconGlyphs.ArrowRight}" Style="{StaticResource IconLabel}"
                                       FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Quick actions" Style="{StaticResource SectionTitleLabel}" FontSize="18" />
                                <Label Text="Jump into active work or review movement history." Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="QuickActionsButtonGrid" ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border x:Name="JobsTile" Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 22" Padding="18,18">
                                <Border.Shadow>
                                    <Shadow Brush="#DCEAE8" Offset="0,8" Radius="18" Opacity="0.30" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnJobsQuickActionClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource CardTint}" VerticalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                               FontSize="20" TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Jobs" FontFamily="PoppinsSemiBold" FontSize="15" TextColor="{StaticResource Primary}" />
                                        <Label Text="Claim and continue dock work" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                            BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 12">
                                        <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="HistoryTile" Grid.Column="1" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 22" Padding="18,18">
                                <Border.Shadow>
                                    <Shadow Brush="#DCEAE8" Offset="0,8" Radius="18" Opacity="0.30" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryQuickActionClicked" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource StatusAvailableTint}" VerticalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.ClockRotateLeft}" Style="{StaticResource IconLabel}"
                                               FontSize="20" TextColor="{StaticResource StatusAvailable}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="History" FontFamily="PoppinsSemiBold" FontSize="15" TextColor="{StaticResource StatusAvailable}" />
                                        <Label Text="Review completed movement" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                            BackgroundColor="{StaticResource StatusAvailableTint}" StrokeShape="RoundRectangle 12">
                                        <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                               FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="AttentionSection" Spacing="12" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14">
                                <Label Text="{x:Static services:IconGlyphs.Bell}" Style="{StaticResource IconLabel}"
                                       FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Needs your attention" Style="{StaticResource SectionTitleLabel}" FontSize="18" />
                                <Label Text="Pending items that may need action now." Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1" BackgroundColor="{StaticResource CardLight}"
                                StrokeShape="RoundRectangle 22" Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="#DCEAE8" Offset="0,8" Radius="18" Opacity="0.30" />
                            </Border.Shadow>
                            <VerticalStackLayout x:Name="AttentionContainer" Spacing="0" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Transient live-update banner, overlaid on top of the scroll content -->
        <Border x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="16,12"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14">
            <Label x:Name="LiveBannerLabel" TextColor="{StaticResource PrimaryDarkText}" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
