<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             x:Class="WarehouseGate.Mobile.Pages.OutwardJobDetailPage"
             Title="Loading Job"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F8FAFC">
    <controls:BackHeaderView Grid.Row="0" PageTitle="Dispatch job" Title="Loading and gate-out details">
        <controls:BackHeaderView.TrailingContent>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Border Padding="12,7" StrokeThickness="0" x:Name="StatusBadgeBorder" StrokeShape="RoundRectangle 14"
                        VerticalOptions="Center">
                    <Label x:Name="StatusLabel" TextColor="White" FontFamily="PoppinsSemiBold" FontSize="12" />
                </Border>
            </HorizontalStackLayout>
        </controls:BackHeaderView.TrailingContent>
    </controls:BackHeaderView>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout x:Name="PageContent" Padding="16,12,16,24" Spacing="8">

            <!-- Header -->
            <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                <Grid x:Name="HeroGrid" RowDefinitions="Auto" ColumnDefinitions="*,1,Auto" ColumnSpacing="18" RowSpacing="14"
                      Padding="4,2" BackgroundColor="Transparent">
                    <VerticalStackLayout x:Name="HeroTextStack" Grid.Row="0" Grid.Column="0" Spacing="7" VerticalOptions="Center">
                        <Label x:Name="HeaderLabel" TextColor="#172033" FontFamily="PoppinsSemiBold"
                               FontSize="18" LineBreakMode="WordWrap" MaxLines="2" />
                    </VerticalStackLayout>

                    <BoxView x:Name="HeroDivider" Grid.Column="1" WidthRequest="1" BackgroundColor="#E4E9F1"
                             VerticalOptions="Fill" />

                    <VerticalStackLayout x:Name="HeroMetaStack" Grid.Row="0" Grid.Column="2" Spacing="0" HorizontalOptions="Fill" VerticalOptions="Center">
                        <Label x:Name="CompletionCaptionLabel" IsVisible="False" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6"><Label x:Name="CustomerHeroLabel" Text="Customer" FontSize="11" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" /></Border>
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6"><HorizontalStackLayout Spacing="7"><Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}" FontSize="11" TextColor="{StaticResource Primary}" /><Label x:Name="SubHeaderLabel" FontSize="11" TextColor="{StaticResource Primary}" /></HorizontalStackLayout></Border>
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6" IsVisible="{Binding Source={x:Reference TimeTrackingLabel}, Path=IsVisible}"><HorizontalStackLayout Spacing="7"><Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}" FontSize="11" TextColor="{StaticResource Primary}" /><Label x:Name="TimeTrackingLabel" FontSize="11" TextColor="{StaticResource Primary}" IsVisible="False" /></HorizontalStackLayout></Border>
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6"><HorizontalStackLayout Spacing="7"><Label Text="{x:Static services:IconGlyphs.CalendarDays}" Style="{StaticResource IconLabel}" FontSize="11" TextColor="{StaticResource Primary}" /><Label x:Name="CompletionTimeLabel" Text="Pending completion" FontSize="11" TextColor="{StaticResource Primary}" /></HorizontalStackLayout></Border>
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6"><HorizontalStackLayout Spacing="7"><Label Text="{x:Static services:IconGlyphs.LocationDot}" Style="{StaticResource IconLabel}" FontSize="11" TextColor="{StaticResource Primary}" /><Label x:Name="DockSummaryLabel" Text="Dock pending" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" /></HorizontalStackLayout></Border>
                                <Border Style="{StaticResource TintCardBorder}" Padding="10,6"><HorizontalStackLayout Spacing="7"><Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}" FontSize="11" TextColor="{StaticResource Primary}" /><Label x:Name="OutwardLineSummaryLabel" Text="0 lines" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" /></HorizontalStackLayout></Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button x:Name="RestartLoadingButton" Text="Restart loading" Clicked="OnRestartLoadingClicked"
                    IsVisible="False" HeightRequest="36" Padding="14,0" CornerRadius="12"
                    BackgroundColor="#EAF1FF" BorderWidth="0"
                    TextColor="{StaticResource Primary}" FontFamily="PoppinsSemiBold" FontSize="11"
                    HorizontalOptions="End">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.ClockRotateLeft}"
                                     Color="{StaticResource Primary}" Size="11" />
                </Button.ImageSource>
            </Button>

            <Border Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" Padding="4">
            <Grid>
            <Grid x:Name="HeroSummaryGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="0" RowSpacing="0">
                <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="8" MinimumHeightRequest="64">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="#EEF5FC" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label Text="1" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Loading &amp; Dispatch" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="#172033" LineBreakMode="TailTruncation" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label Text="In Progress" FontSize="10" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusSuccess}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="Transparent" Padding="8" MinimumHeightRequest="64">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="#EEF5FC" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label Text="2" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="PhotoCountLabel" Text="0 photos" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="#172033" LineBreakMode="TailTruncation" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusAvailableTint}" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label Text="In Progress" FontSize="10" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusDocked}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="Transparent" Padding="8" MinimumHeightRequest="64">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="#EEF5FC" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label Text="3" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Dispatch Review" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="#172033" LineBreakMode="TailTruncation" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusAssignedTint}" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label x:Name="ReviewStateLabel" Text="Pending" FontSize="10" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusAssigned}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="Transparent" Padding="8" MinimumHeightRequest="64">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="#EEF5FC" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label Text="4" FontFamily="PoppinsSemiBold" FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="ExceptionSummaryLabel" Text="No Exceptions" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="#172033" LineBreakMode="TailTruncation" />
                            <Border Padding="10,3" StrokeThickness="0" BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                                <Label x:Name="ExceptionStateLabel" Text="Good" FontSize="10" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusSuccess}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
            <BoxView WidthRequest="1" Color="#E4E9F1" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,8" />
            <BoxView x:Name="SummaryHorizontalDivider" HeightRequest="1" Color="#E4E9F1" HorizontalOptions="Fill" VerticalOptions="Center" Margin="8,0" />
            </Grid>
            </Border>

            <!-- Dock-in -->
            <Border x:Name="DockInSection" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="0" IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                </Border.Shadow>
                <Grid x:Name="DockInGrid" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="1.15*,0.85*" RowSpacing="18" ColumnSpacing="18" Padding="22">
                    <Grid x:Name="DockInHeaderGrid" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="12">
                        <Border Grid.Column="0" WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                            <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                                   FontSize="18" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Dock assignment" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                            <Label Text="Select the gated vehicle and assign a loading bay before work begins."
                                   Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="12,7" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label Text="Required" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <Border x:Name="DockVehicleCard" Grid.Row="1" Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                            BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 14">
                                    <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                           FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="Vehicle" TextTransform="Uppercase" Style="{StaticResource MetaLabel}" FontSize="11" />
                                    <Label Text="Choose the vehicle waiting at gate" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Border x:Name="VehicleNumberBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.2"
                                    StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="50"
                                    BackgroundColor="{StaticResource CardLight}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDockVehicleFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="VehicleNumberLabel" Grid.Column="0" Text="Select vehicle" LineBreakMode="TailTruncation"
                                           FontSize="15" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                           FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="DockBayCard" Grid.Row="1" Grid.Column="1" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                            BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 14">
                                    <Label Text="{x:Static services:IconGlyphs.LocationDot}" Style="{StaticResource IconLabel}"
                                           FontSize="15" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Label Text="Loading bay" TextTransform="Uppercase" Style="{StaticResource MetaLabel}" FontSize="11" />
                                    <Label x:Name="BayHelperLabel" Text="Enter bay number between 1 and 50" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Grid x:Name="BayNumberEntryGrid" ColumnDefinitions="Auto,*" ColumnSpacing="0">
                                <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.2"
                                        StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="50"
                                        BackgroundColor="{StaticResource CardTint}" VerticalOptions="Center">
                                    <Label Text="Bay-" VerticalOptions="Center" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource Primary}" />
                                </Border>
                                <Border Grid.Column="1" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.2"
                                        StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50"
                                        BackgroundColor="{StaticResource CardLight}">
                                    <Entry x:Name="BayNumberEntry" Placeholder="1-50"
                                           Keyboard="Numeric" MaxLength="2" TextChanged="OnBayNumberTextChanged"
                                           FontSize="16" FontFamily="PoppinsSemiBold" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <ScrollView x:Name="BayChipsScroll" Orientation="Horizontal" IsVisible="False">
                                <FlexLayout x:Name="BayChipsLayout" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" />
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <Grid x:Name="DockInFooterGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 18" Padding="14,11">
                            <HorizontalStackLayout Spacing="9">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="Dock-in confirms vehicle placement and opens the loading workflow."
                                       Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="1" x:Name="DockInButton" Text="Dock In" Clicked="OnDockInClicked"
                                Style="{StaticResource PrimaryActionButton}" WidthRequest="220" HeightRequest="56"
                                CornerRadius="18" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Start loading -->
            <Border x:Name="StartLoadingSection" Stroke="#E4E9F1" StrokeThickness="1"
                    BackgroundColor="White" StrokeShape="RoundRectangle 16"
                    Padding="0" IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Offset="0,8" Radius="24" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="StartLoadingHeaderGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="12" Padding="22,20"
                          BackgroundColor="#FBFCFE">
                        <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                BackgroundColor="{StaticResource StatusSuccessTint}" StrokeShape="RoundRectangle 16">
                            <Label Text="{x:Static services:IconGlyphs.ClipboardCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="18" TextColor="{StaticResource StatusSuccess}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Ready to begin?" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                            <Label Text="Confirm loading readiness before starting the timer." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="11,7" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                            <Label x:Name="ChecklistProgressLabel" Text="0 / 3" FontSize="12"
                                   FontFamily="PoppinsBold" TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <Grid x:Name="ChecklistGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12" Padding="18">
                        <Border x:Name="PickerCoordinatedOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 18" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickerCoordinatedTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 13"
                                        HorizontalOptions="Start">
                                    <Label Text="{x:Static services:IconGlyphs.User}" Style="{StaticResource IconLabel}"
                                           FontSize="14" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="PickerCoordinatedLabel" Text="Coordinated with picker team"
                                       FontSize="13" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                                <Label Text="Picker confirms order handoff" FontSize="11"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" x:Name="MaterialsVerifiedOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 18" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMaterialsVerifiedTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 13"
                                        HorizontalOptions="Start">
                                    <Label Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                           FontSize="14" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="MaterialsVerifiedLabel" Text="Verified picked materials &amp; quantities"
                                       FontSize="13" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                                <Label Text="Cartons match the pick list" FontSize="11"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" x:Name="MaterialsStagedOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 18" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMaterialsStagedTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 13"
                                        HorizontalOptions="Start">
                                    <Label Text="{x:Static services:IconGlyphs.Warehouse}" Style="{StaticResource IconLabel}"
                                           FontSize="14" TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="MaterialsStagedLabel" Text="Materials arranged at loading bay"
                                       FontSize="13" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                                <Label Text="Bay is clear and staged" FontSize="11"
                                       TextColor="{StaticResource TextSecondaryLight}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid x:Name="StartLoadingFooterGrid" ColumnDefinitions="*,Auto" ColumnSpacing="14" Padding="18" BackgroundColor="{StaticResource CardLight}">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                StrokeShape="RoundRectangle 18" Padding="14,11">
                            <HorizontalStackLayout Spacing="9">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="All three checks are required before loading starts."
                                       Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="1" x:Name="StartLoadingButton" Text="Start Loading" Clicked="OnStartLoadingClicked"
                                Style="{StaticResource PrimaryActionButton}" IsEnabled="False"
                                HeightRequest="56" WidthRequest="220" CornerRadius="18" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid x:Name="TabletDashboardGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">

            <!-- Photos -->
            <Border x:Name="PhotoSection" Grid.Row="0" Grid.Column="0" StrokeThickness="0"
                    BackgroundColor="Transparent" IsVisible="False" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="PhotoHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="8" Padding="16,15,16,8"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPhotoSectionHeaderTapped" /></Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="Photo evidence" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                        </VerticalStackLayout>
                        <Label x:Name="PhotoSectionChevron" Grid.Column="1" Text="{x:Static services:IconGlyphs.ChevronUp}" Style="{StaticResource IconLabel}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout x:Name="PhotoSectionContent" Padding="4,4,4,8" Spacing="0">
                        <VerticalStackLayout IsVisible="False" HeightRequest="0" Spacing="0">
                            <Button x:Name="CapturePhotoButton" Text="Capture Photo" Clicked="OnCapturePhotoClicked"
                                    HeightRequest="0" Padding="0">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Camera}" Color="{StaticResource Primary}" Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Label x:Name="PhotoLimitLabel" Text="5 of 5 photos - limit reached" Style="{StaticResource MetaLabel}"
                                   FontSize="11" HorizontalOptions="Center" IsVisible="False" HeightRequest="0" />
                        </VerticalStackLayout>

                        <Grid Padding="0,2">
                            <Grid>
                                <HorizontalStackLayout x:Name="NoPhotosLabel" Spacing="8" HorizontalOptions="Center"
                                                       VerticalOptions="Center" IsVisible="False">
                                    <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}" FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                    <Label Text="No photos yet." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                </HorizontalStackLayout>

                                <ScrollView x:Name="PhotoScrollView" Orientation="Horizontal" HeightRequest="128"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="PhotoStrip" Spacing="12" />
                                </ScrollView>
                            </Grid>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" Margin="0,10,0,0" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Loading plan (real rule-engine: collision/weight/stack/support/COG/etc.) -->
            <Border x:Name="LoadVisualizationSection" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" StrokeThickness="0"
                    BackgroundColor="Transparent" IsVisible="False" Padding="0">
                <VerticalStackLayout Spacing="10">
                    <Grid x:Name="LoadVizHeaderGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="6" Padding="4,10,4,4" BackgroundColor="Transparent">
                        <VerticalStackLayout Grid.Row="0" Spacing="2" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnLoadSectionHeaderTapped" /></VerticalStackLayout.GestureRecognizers>
                            <Label Text="Dispatch load review" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Center">
                            <Button x:Name="SuggestSequenceButton" Text="Refresh" Clicked="OnCalculateLoadingPlanClicked" Style="{StaticResource SecondaryActionButton}" WidthRequest="84" HeightRequest="36" />
                            <Button x:Name="ViewSimulationButton" Text="View 3D" Clicked="OnViewSimulationClicked"
                                    Style="{StaticResource IconTextButton}" WidthRequest="88" HeightRequest="36">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Eye}" Color="{StaticResource Primary}" Size="12" />
                                </Button.ImageSource>
                            </Button>
                            <Label x:Name="LoadSectionChevron" Text="{x:Static services:IconGlyphs.ChevronUp}" Style="{StaticResource IconLabel}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLoadSectionHeaderTapped" /></Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout x:Name="LoadSectionContent" Spacing="12">
                    <Grid x:Name="LoadVizContentGrid" ColumnDefinitions="2*,*" ColumnSpacing="16" RowSpacing="14" Padding="18,0,18,0">
                        <Border x:Name="InlineSimulationPanel" Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 20"
                                Padding="10" VerticalOptions="Fill" IsVisible="False">
                            <Grid>
                                <HybridWebView x:Name="LoadVizWebView" MinimumHeightRequest="410"
                                               HorizontalOptions="Fill" VerticalOptions="Fill"
                                               HybridRoot="loadviz" DefaultFile="index.html" IsVisible="False" />
                                <Label x:Name="LoadVizUnavailableLabel" Text="Loading plan unavailable - vehicle dimensions not on file."
                                       Style="{StaticResource MetaLabel}" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" x:Name="LoadPlanStatsSection" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" IsVisible="False">
                            <Border Grid.Row="0" x:Name="LoadPlanBannerBorder" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12">
                                <Label x:Name="LoadPlanBannerLabel" FontSize="12" FontFamily="PoppinsSemiBold" />
                            </Border>

                            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="TotalBoxesLabel" FontFamily="PoppinsBold" FontSize="20" TextColor="{StaticResource Primary}" />
                                        <Label Text="Boxes" Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCard}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="TotalWeightLabel" FontFamily="PoppinsBold" FontSize="20" TextColor="{StaticResource Primary}" />
                                        <Label Text="Weight" Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCard}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label x:Name="WeightUtilLabel" FontFamily="PoppinsBold" FontSize="18" TextColor="{StaticResource Primary}" />
                                        <Label Text="Weight use" Style="{StaticResource MetaLabel}" />
                                        <ProgressBar x:Name="WeightUtilBar" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label x:Name="SpaceUtilLabel" FontFamily="PoppinsBold" FontSize="18" TextColor="{StaticResource Primary}" />
                                        <Label Text="Space use" Style="{StaticResource MetaLabel}" />
                                        <ProgressBar x:Name="SpaceUtilBar" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource StatCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Center of gravity" FontFamily="PoppinsSemiBold" FontSize="13" VerticalOptions="Center" />
                                        <Label Grid.Column="1" x:Name="TipRiskBadge" FontFamily="PoppinsBold" FontSize="11" VerticalOptions="Center" />
                                    </Grid>
                                    <Label x:Name="CenterOfGravityLabel" Style="{StaticResource MetaLabel}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="3" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 14" Padding="12">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Loading sequence" FontFamily="PoppinsSemiBold" FontSize="14" />
                                    <ScrollView>
                                        <VerticalStackLayout x:Name="LoadingSequenceContainer" Spacing="8" />
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" Margin="18,0" />
                    <Grid x:Name="LoadLinesHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="12" Padding="18,0,18,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Loaded quantities" FontFamily="PoppinsSemiBold" FontSize="16" />
                            <Label Text="Actual dispatch quantities recorded against each item." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" x:Name="SubmitLoadLinesButton" Text="Save Load Lines" Clicked="OnSubmitLoadLinesClicked"
                                Style="{StaticResource PrimaryActionButton}" WidthRequest="170" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout x:Name="LoadLinesContainer" Spacing="10" Padding="18,0,18,18" />
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" Margin="12,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <!-- Exceptions -->
            <Border x:Name="ExceptionSection" Grid.Row="0" Grid.Column="1" StrokeThickness="0"
                    BackgroundColor="Transparent" Padding="4,10" IsVisible="False">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnExceptionSectionHeaderTapped" /></Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                BackgroundColor="{StaticResource StatusExceptionTint}" StrokeShape="RoundRectangle 11">
                            <Label Text="{x:Static services:IconGlyphs.TriangleExclamation}" Style="{StaticResource IconLabel}"
                                   FontSize="12" TextColor="{StaticResource StatusException}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Exception control" Style="{StaticResource CardTitleLabel}" />
                        </VerticalStackLayout>
                        <Label x:Name="ExceptionSectionChevron" Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronUp}" Style="{StaticResource IconLabel}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout x:Name="ExceptionSectionContent" Spacing="10">
                    <VerticalStackLayout x:Name="ExceptionInputGroup" Spacing="10">
                        <Label Text="Flag an issue for management follow-up (optional)." Style="{StaticResource MetaLabel}" />

                        <Grid x:Name="ExceptionOptionsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border x:Name="PartialLoadOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                    BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPartialLoadTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="PartialLoadLabel" Text="Partial load" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="{StaticResource TextSecondaryLight}" />
                            </Border>
                            <Border x:Name="StockNotAvailableOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                    Grid.Column="1" BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStockNotAvailableTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="StockNotAvailableLabel" Text="Stock not available" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="{StaticResource TextSecondaryLight}" />
                            </Border>
                            <Border x:Name="CapacityExceededOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                    Grid.Row="1" BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCapacityExceededTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="CapacityExceededLabel" Text="Vehicle capacity exceeded" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="{StaticResource TextSecondaryLight}" />
                            </Border>
                            <Border x:Name="MaterialDamagedOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                    Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMaterialDamagedTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="MaterialDamagedLabel" Text="Material damaged" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="{StaticResource TextSecondaryLight}" />
                            </Border>
                            <Border x:Name="WrongMaterialOption" StrokeThickness="1.5" Stroke="{StaticResource CardBorderLight}"
                                    Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="{StaticResource SurfaceLight}" StrokeShape="RoundRectangle 16" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWrongMaterialTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="WrongMaterialLabel" Text="Wrong material loaded" FontSize="13" FontFamily="PoppinsSemiBold" TextColor="{StaticResource TextSecondaryLight}" />
                            </Border>
                        </Grid>

                        <Entry x:Name="ExceptionRemarksEntry" Placeholder="Remarks (optional)" />
                        <Button x:Name="ReportExceptionButton" Text="Report Exception" Clicked="OnReportExceptionClicked" Style="{StaticResource SecondaryActionButton}" />
                    </VerticalStackLayout>

                    <Border x:Name="ExceptionReportedBanner" IsVisible="False" StrokeThickness="1" Stroke="{StaticResource StatusException}"
                            BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 10" Padding="12">
                        <Label x:Name="ExceptionReportedLabel" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusException}" />
                    </Border>

                    <Border x:Name="NoExceptionBanner" IsVisible="False" StrokeThickness="1" Stroke="{StaticResource CardBorderLight}"
                            BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 14" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                    StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Label Text="{x:Static services:IconGlyphs.CircleCheck}" FontFamily="FaSolid" FontSize="15"
                                       TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="No exceptions reported" FontFamily="PoppinsSemiBold" FontSize="13"
                                       TextColor="{StaticResource TextPrimaryLight}" />
                                <Label Text="This dispatch was completed without any exception notes."
                                       Style="{StaticResource MetaLabel}" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Dispatch readiness -->
            <VerticalStackLayout x:Name="DispatchReadySection" Grid.Row="2" Grid.Column="0" Spacing="8" IsVisible="False">
                <Button x:Name="ConfirmDispatchReadyButton" Text="Confirm Dispatch Ready" Clicked="OnConfirmDispatchReadyClicked"
                        Style="{StaticResource SecondaryActionButton}" CornerRadius="14" HeightRequest="50" />
                <Border x:Name="DispatchReadyConfirmedBanner" IsVisible="False" StrokeThickness="1" Stroke="{StaticResource StatusSuccess}"
                        BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 10" Padding="12">
                    <Label x:Name="DispatchReadyConfirmedLabel" FontSize="12" FontFamily="PoppinsSemiBold" TextColor="{StaticResource StatusSuccess}" />
                </Border>
            </VerticalStackLayout>

            <!-- Complete -->
            <VerticalStackLayout x:Name="CompletionSection" Grid.Row="3" Grid.Column="1" Spacing="6">
                <Button x:Name="CompleteButton" Text="Complete Loading" Clicked="OnCompleteClicked"
                        IsVisible="False" Style="{StaticResource PrimaryActionButton}"
                        BackgroundColor="{StaticResource StatusSuccess}" TextColor="White" CornerRadius="14" HeightRequest="50" />
                <Label x:Name="CompleteHintLabel" Style="{StaticResource MetaLabel}" IsVisible="False"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Dispatch note -->
            <Border x:Name="DispatchNoteBorder" Grid.Row="2" Grid.Column="1" IsVisible="False"
                    Stroke="#E4E9F1" StrokeThickness="1" BackgroundColor="White"
                    Padding="14,10" StrokeShape="RoundRectangle 14" HeightRequest="62">
                <Border.Shadow>
                    <Shadow Brush="#23344F" Opacity="0.05" Radius="10" Offset="0,3" />
                </Border.Shadow>
                <Grid x:Name="DispatchNoteGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid Grid.Column="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                        <Border x:Name="DispatchNoteIconBadge" StrokeThickness="0" BackgroundColor="#E8F8EF"
                                StrokeShape="RoundRectangle 12" />
                        <Label x:Name="DispatchNoteIconLabel" FontFamily="FaSolid" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="DispatchNoteTitleLabel" FontFamily="PoppinsSemiBold" FontSize="13"
                               TextColor="{StaticResource TextPrimaryLight}" />
                        <Label x:Name="DispatchNoteLabel" FontSize="10" Style="{StaticResource MetaLabel}"
                               LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.CircleCheck}" FontFamily="FaSolid"
                           FontSize="14" TextColor="{StaticResource StatusSuccess}"
                           VerticalOptions="Center" HorizontalOptions="End" />
                </Grid>
            </Border>

            </Grid>

            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
