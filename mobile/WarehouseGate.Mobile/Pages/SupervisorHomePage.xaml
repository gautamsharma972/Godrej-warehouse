<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SupervisorHomePage"
             Title="Supervisor"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="True"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <DataTemplate x:Key="InwardJobCardTemplate" x:DataType="models:InwardJob">
            <Border Stroke="#E4E9F1" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" BackgroundColor="White"
                    Padding="13" Margin="0,0,0,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnJobTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="8">
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 11" BackgroundColor="#EAF1FF" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                               FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Vehicle" TextTransform="Uppercase" Style="{StaticResource MetaLabel}" FontSize="9" />
                            <Label Text="{Binding VehicleNumber}" Style="{StaticResource CardTitleLabel}" FontSize="14" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center" JustifyContent="Start">
                            <Border Padding="8,4" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                    StrokeShape="RoundRectangle 10" Margin="0,0,6,4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="PO" TextTransform="Uppercase" FontSize="10" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Text="{Binding PONumber}" FontSize="10" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextPrimaryLight}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Padding="8,4" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                    StrokeShape="RoundRectangle 10" Margin="0,0,6,4">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static services:IconGlyphs.Building}" Style="{StaticResource IconLabel}"
                                           FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Text="{Binding SupplierName}" FontSize="10" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextPrimaryLight}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="12" VerticalOptions="Center" HorizontalOptions="End">
                        <Border Padding="10,5" StrokeThickness="0" HorizontalOptions="End"
                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                                   TextColor="White" FontSize="11" FontFamily="PoppinsSemiBold" />
                        </Border>
                        <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                               FontSize="12" TextColor="#A2ADBD" HorizontalOptions="End" />
                    </VerticalStackLayout>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 10" Padding="10,6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                <Label Text="{Binding WaitingCaption}" Style="{StaticResource MetaLabel}" FontSize="10" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#EAF1FF"
                                StrokeShape="RoundRectangle 12" Padding="12,8" IsVisible="{Binding HasTimeTrackingCaption}">
                            <Label Text="{Binding TimeTrackingCaption}" FontSize="12" FontFamily="PoppinsSemiBold"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutwardJobCardTemplate" x:DataType="models:OutwardJob">
            <Border Stroke="#E4E9F1" StrokeThickness="1"
                    StrokeShape="RoundRectangle 13" BackgroundColor="White"
                    Padding="13,11" Margin="0,0,0,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOutwardJobTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="11">
                    <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding DispatchOrderNumber}" TextColor="#172033"
                               FontFamily="PoppinsSemiBold" FontSize="13"
                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{x:Static services:IconGlyphs.Building}"
                                   Style="{StaticResource IconLabel}" FontSize="10"
                                   TextColor="#687387" VerticalOptions="Center" />
                            <Label Text="{Binding CustomerName}" FontSize="10"
                                   TextColor="#4D596D" LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center"
                                               IsVisible="{Binding HasTimeTrackingCaption}">
                                <Label Text="{x:Static services:IconGlyphs.Clock}"
                                       Style="{StaticResource IconLabel}" FontSize="10"
                                       TextColor="#687387" VerticalOptions="Center" />
                                <Label Text="{Binding TimeTrackingCaption}" FontSize="10"
                                       TextColor="#687387" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Border Padding="8,3" StrokeThickness="0"
                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                StrokeShape="RoundRectangle 9" VerticalOptions="Center">
                            <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                                   TextColor="White" FontSize="9" FontFamily="PoppinsSemiBold" />
                        </Border>
                        <Grid WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                            <controls:CircularProgressView Progress="{Binding LoadingCompletionProgress}"
                                                           ProgressColor="{StaticResource Primary}"
                                                           TrackColor="#DDECE9" StrokeWidth="4" />
                            <Label Text="{Binding LoadingCompletionPercentText}" FontSize="9"
                                   FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </HorizontalStackLayout>

                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}"
                           Style="{StaticResource IconLabel}" FontSize="11" TextColor="#A2ADBD"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" BackgroundColor="Transparent">
            <controls:BackHeaderView PageTitle="Jobs" Title="Review assigned dock work" ShowBackButton="False"
                                     BackRoute="//SupervisorTabs/SupervisorDashboardPage">
                <controls:BackHeaderView.TrailingContent>
                    <Border Padding="10,6" Stroke="#D4E2FF" StrokeThickness="1"
                            BackgroundColor="#F4F7FF" StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="7">
                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                     Color="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                            <Label x:Name="JobsCountLabel" Text="0 jobs" FontSize="11"
                                   FontFamily="PoppinsSemiBold" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </controls:BackHeaderView.TrailingContent>
            </controls:BackHeaderView>
        </Grid>
        <RefreshView Grid.Row="1" x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout x:Name="PageContent" Padding="14,12,14,24" Spacing="16">

                    <VerticalStackLayout Spacing="10" Margin="2,2,2,2">
                            <Border Padding="3" Stroke="#E4E9F1" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="White"
                                    HeightRequest="42" WidthRequest="250" HorizontalOptions="Start">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                    <Border x:Name="InwardTabPill" Grid.Column="0" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" Padding="10,6">
                                        <Label x:Name="InwardRadioLabel" Text="Inward" FontSize="12"
                                               FontFamily="PoppinsSemiBold" HorizontalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnInwardTabClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Border>
                                    <Border x:Name="OutwardTabPill" Grid.Column="1" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" Padding="10,6">
                                        <Label x:Name="OutwardRadioLabel" Text="Outward" FontSize="12"
                                               FontFamily="PoppinsSemiBold" HorizontalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnOutwardTabClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="InwardSection" Spacing="14">
                        <Border x:Name="InwardMineSection" Stroke="#E4E9F1"
                                StrokeThickness="0" BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 14" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="2,2,2,4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="Inbound jobs" Style="{StaticResource SectionTitleLabel}" FontSize="14" />
                                            <Label Text="Assigned unloading work" Style="{StaticResource MetaLabel}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Padding="10,5" StrokeThickness="0" BackgroundColor="#EAF1FF"
                                                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                            <Label x:Name="InwardMineCountLabel" Text="0" FontFamily="PoppinsSemiBold" FontSize="13"
                                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                </Grid>
                                <Border x:Name="NoMineLabel" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                        StrokeShape="RoundRectangle 12" Padding="16" IsVisible="False" Margin="0,8,0,0">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                               FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                        <Label Text="You have no unloading jobs in progress." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                    </HorizontalStackLayout>
                                </Border>

                                <CollectionView x:Name="MyJobsCollectionView"
                                                ItemTemplate="{StaticResource InwardJobCardTemplate}"
                                                Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="OutwardSection" Spacing="14" IsVisible="False">
                        <Border x:Name="OutwardMineSection" Stroke="#E4E9F1"
                                StrokeThickness="0" BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 14" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="2,2,2,4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="Outbound jobs" Style="{StaticResource SectionTitleLabel}" FontSize="14" />
                                            <Label Text="Assigned loading and dispatch work" Style="{StaticResource MetaLabel}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Padding="10,5" StrokeThickness="0" BackgroundColor="#EAF1FF"
                                                StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                            <Label x:Name="OutwardMineCountLabel" Text="0" FontFamily="PoppinsSemiBold" FontSize="13"
                                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                </Grid>
                                <Border x:Name="NoMineOutwardLabel" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                        StrokeShape="RoundRectangle 12" Padding="16" IsVisible="False" Margin="0,8,0,0">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                               FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                        <Label Text="You have no loading jobs in progress." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                    </HorizontalStackLayout>
                                </Border>

                                <CollectionView x:Name="MyOutwardJobsCollectionView"
                                                ItemTemplate="{StaticResource OutwardJobCardTemplate}"
                                                Margin="0,8,0,0">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout x:Name="OutwardJobsLayout"
                                                         Orientation="Vertical" Span="1"
                                                         HorizontalItemSpacing="0"
                                                         VerticalItemSpacing="12" />
                                    </CollectionView.ItemsLayout>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border Grid.Row="1" x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="16,12"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14">
            <Label x:Name="LiveBannerLabel" TextColor="{StaticResource PrimaryDarkText}" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
