<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WarehouseGate.Mobile.Models"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SupervisorHomePage"
             Title="Supervisor"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Locked">

    <ContentPage.Resources>
        <DataTemplate x:Key="InwardJobCardTemplate" x:DataType="models:InwardJob">
            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource CardLight}"
                    Padding="18" Margin="0,0,0,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnJobTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" RowSpacing="14">
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="72" HeightRequest="72" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource CardTint}" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                               FontSize="24" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="9" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Vehicle" TextTransform="Uppercase" Style="{StaticResource MetaLabel}" FontSize="11" />
                            <Label Text="{Binding VehicleNumber}" Style="{StaticResource CardTitleLabel}" FontSize="20" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center" JustifyContent="Start">
                            <Border Padding="10,5" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                    StrokeShape="RoundRectangle 13" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="PO" TextTransform="Uppercase" FontSize="10" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Text="{Binding PONumber}" FontSize="12" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextPrimaryLight}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Padding="10,5" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                    StrokeShape="RoundRectangle 13" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static services:IconGlyphs.Building}" Style="{StaticResource IconLabel}"
                                           FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Text="{Binding SupplierName}" FontSize="12" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextPrimaryLight}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="12" VerticalOptions="Center" HorizontalOptions="End">
                        <Border Padding="10,5" StrokeThickness="0" HorizontalOptions="End"
                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                                   TextColor="White" FontSize="11" FontFamily="PoppinsSemiBold" />
                        </Border>
                        <Border Padding="14,10" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 16" HorizontalOptions="End">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Open" FontSize="12" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                StrokeShape="RoundRectangle 16" Padding="12,9">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                <Label Text="{Binding WaitingCaption}" Style="{StaticResource MetaLabel}" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 16" Padding="12,9" IsVisible="{Binding HasTimeTrackingCaption}">
                            <Label Text="{Binding TimeTrackingCaption}" FontSize="12" FontFamily="PoppinsSemiBold"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutwardJobCardTemplate" x:DataType="models:OutwardJob">
            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource CardLight}"
                    Padding="18" Margin="0,0,0,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOutwardJobTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" RowSpacing="14">
                    <Border Grid.Row="0" Grid.Column="0" WidthRequest="72" HeightRequest="72" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource CardTint}" VerticalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                               FontSize="24" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="9" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Dispatch order" TextTransform="Uppercase" Style="{StaticResource MetaLabel}" FontSize="11" />
                            <Label Text="{Binding DispatchOrderNumber}" Style="{StaticResource CardTitleLabel}"
                                   FontSize="20" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center" JustifyContent="Start">
                            <Border Padding="10,5" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                    StrokeShape="RoundRectangle 13" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static services:IconGlyphs.Building}" Style="{StaticResource IconLabel}"
                                           FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label Text="{Binding CustomerName}" FontSize="12" FontFamily="PoppinsSemiBold"
                                           TextColor="{StaticResource TextPrimaryLight}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="12" VerticalOptions="Center" HorizontalOptions="End">
                        <Border Padding="10,5" StrokeThickness="0" HorizontalOptions="End"
                                BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{Binding Status, Converter={StaticResource StatusToDisplayTextConverter}}"
                                   TextColor="White" FontSize="11" FontFamily="PoppinsSemiBold" />
                        </Border>
                        <Border Padding="14,10" StrokeThickness="0"
                                BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 16" HorizontalOptions="End">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Open" FontSize="12" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                StrokeShape="RoundRectangle 16" Padding="12,9">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static services:IconGlyphs.Clock}" Style="{StaticResource IconLabel}"
                                       FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                <Label Text="{Binding TimeTrackingCaption}" Style="{StaticResource MetaLabel}"
                                       FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                StrokeShape="RoundRectangle 16" Padding="12,9">
                            <HorizontalStackLayout Spacing="8">
                                <ProgressBar Progress="{Binding LoadingCompletionProgress}" WidthRequest="86"
                                             HeightRequest="5" VerticalOptions="Center" />
                                <Label Text="{Binding LoadingCompletionPercentText}" FontSize="12" FontFamily="PoppinsSemiBold"
                                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <RefreshView x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="32,28,32,32" Spacing="20">

                    <controls:AppHeaderView AccountRoute="//SupervisorTabs/SupervisorAccountPage" />

                    <Border StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                            StrokeShape="RoundRectangle 28" Padding="22,20" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border Grid.Column="0" WidthRequest="64" HeightRequest="64" StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardLight}" StrokeShape="RoundRectangle 22">
                                <Label Text="{x:Static services:IconGlyphs.ListCheck}" Style="{StaticResource IconLabel}"
                                       FontSize="22" TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Dock Command" Style="{StaticResource PageTitleLabel}" FontSize="30" />
                                <Label x:Name="JobsSubtitleLabel"
                                       Text="Review the inward work assigned to you."
                                       Style="{StaticResource MetaLabel}" FontSize="13" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="End" VerticalOptions="Center">
                                <Border Padding="12,7" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                        StrokeShape="RoundRectangle 15" HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="8">
                                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4"
                                                 Color="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                                        <Label x:Name="JobsCountLabel" Text="0 jobs" FontSize="12" FontFamily="PoppinsBold"
                                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Padding="14,6" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource CardLight}"
                                        HeightRequest="44" VerticalOptions="Center" HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                        <Label x:Name="InwardRadioLabel" Text="Inward" FontSize="12"
                                               FontFamily="PoppinsBold" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnInwardTabClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Border WidthRequest="48" HeightRequest="28" Padding="3" StrokeThickness="0"
                                                BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnJobsModeSwitchTapped" />
                                            </Border.GestureRecognizers>
                                            <Border x:Name="JobsModeThumb" WidthRequest="22" HeightRequest="22"
                                                    StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                                    StrokeShape="RoundRectangle 11" HorizontalOptions="Start" />
                                        </Border>

                                        <Label x:Name="OutwardRadioLabel" Text="Outward" FontSize="12"
                                               FontFamily="PoppinsBold" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnOutwardTabClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout x:Name="InwardSection" Spacing="14">
                        <Border x:Name="InwardMineSection" Stroke="{StaticResource CardBorderLight}"
                                StrokeThickness="0" BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 0" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Border StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                        StrokeShape="RoundRectangle 26" Padding="22,20" Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource CardLight}">
                                            <Label Text="{x:Static services:IconGlyphs.Dolly}" Style="{StaticResource IconLabel}"
                                                   FontSize="19" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="Inbound work tray" Style="{StaticResource SectionTitleLabel}" FontSize="20" />
                                            <Label Text="Prioritized unloading work assigned to your dock" Style="{StaticResource MetaLabel}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Padding="16,9" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                                StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                            <Label x:Name="InwardMineCountLabel" Text="0" FontFamily="PoppinsBold" FontSize="15"
                                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border x:Name="NoMineLabel" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                        StrokeShape="RoundRectangle 18" Padding="18" IsVisible="False" Margin="16,16,16,18">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                               FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                        <Label Text="You have no unloading jobs in progress." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                    </HorizontalStackLayout>
                                </Border>

                                <CollectionView x:Name="MyJobsCollectionView"
                                                ItemTemplate="{StaticResource InwardJobCardTemplate}"
                                                Margin="0" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="OutwardSection" Spacing="14" IsVisible="False">
                        <Border x:Name="OutwardMineSection" Stroke="{StaticResource CardBorderLight}"
                                StrokeThickness="0" BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 0" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Border StrokeThickness="0" BackgroundColor="{StaticResource CardTint}"
                                        StrokeShape="RoundRectangle 26" Padding="22,20" Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource CardLight}">
                                            <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                                   FontSize="19" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="Outbound load tray" Style="{StaticResource SectionTitleLabel}" FontSize="20" />
                                            <Label Text="Loading and dispatch work assigned to your dock" Style="{StaticResource MetaLabel}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Padding="16,9" StrokeThickness="0" BackgroundColor="{StaticResource CardLight}"
                                                StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                                            <Label x:Name="OutwardMineCountLabel" Text="0" FontFamily="PoppinsBold" FontSize="15"
                                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border x:Name="NoMineOutwardLabel" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                        StrokeShape="RoundRectangle 18" Padding="18" IsVisible="False" Margin="16,16,16,18">
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{x:Static services:IconGlyphs.BoxesStacked}" Style="{StaticResource IconLabel}"
                                               FontSize="14" TextColor="{StaticResource TextSecondaryLight}" />
                                        <Label Text="You have no loading jobs in progress." Style="{StaticResource EmptyStateLabel}" Margin="0" />
                                    </HorizontalStackLayout>
                                </Border>

                                <CollectionView x:Name="MyOutwardJobsCollectionView"
                                                ItemTemplate="{StaticResource OutwardJobCardTemplate}"
                                                Margin="0" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Border x:Name="LiveBanner" IsVisible="False" Opacity="0" VerticalOptions="Start" Margin="16,12"
                Padding="14,10" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 14">
            <Label x:Name="LiveBannerLabel" TextColor="{StaticResource PrimaryDarkText}" FontFamily="PoppinsSemiBold"
                   FontSize="13" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
