<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.VehicleExitPage"
             Title="Outward"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Locked">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="32,28,32,32" Spacing="18">

                <controls:AppHeaderView AccountRoute="//SecurityTabs/SecurityAccountPage" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Outward" Style="{StaticResource PageTitleLabel}" FontSize="26" />
                        <Label Text="Record dispatch vehicle arrival and capture optional gate evidence."
                               Style="{StaticResource MetaLabel}" FontSize="13" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource StatusSuccessTint}" Stroke="Transparent"
                            StrokeShape="RoundRectangle 18" Padding="12,8" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" Style="{StaticResource IconLabel}"
                                   FontSize="12" TextColor="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                            <Label Text="Outbound gate" FontSize="12" FontFamily="PoppinsSemiBold"
                                   TextColor="{StaticResource StatusSuccess}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="GateInFormSection" Spacing="16" IsVisible="False">
                    <Grid x:Name="FormCardsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="16">

                        <Border x:Name="DispatchDetailsCard" Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 22" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="20,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource StatusSuccessTint}">
                                        <Label Text="{x:Static services:IconGlyphs.RightFromBracket}" Style="{StaticResource IconLabel}"
                                               FontSize="20" TextColor="{StaticResource StatusSuccess}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Dispatch details" Style="{StaticResource CardTitleLabel}" FontSize="18" />
                                        <Label Text="Dispatch order, vehicle, driver, transporter, and assigned gate."
                                               Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="{StaticResource CardTint}" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 16" Padding="11,6" VerticalOptions="Start">
                                        <Label Text="Security" FontSize="12" FontFamily="PoppinsSemiBold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                                <VerticalStackLayout Padding="20,18,20,20" Spacing="16">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="VEHICLE NUMBER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Border x:Name="OutwardVehicleNumberBorder" Grid.Column="0" Stroke="{StaticResource CardBorderLight}"
                                                    StrokeThickness="1.3" StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnOutwardVehicleFieldTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Truck}"
                                                           Style="{StaticResource IconLabel}" FontSize="14"
                                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                    <Label x:Name="OutwardVehicleNumberLabel" Grid.Column="1" Text="Select vehicle"
                                                           LineBreakMode="TailTruncation" TextColor="{StaticResource TextSecondaryLight}"
                                                           VerticalOptions="Center" />
                                                    <Entry x:Name="OutwardVehicleNumberEntry" Grid.Column="1" IsVisible="False"
                                                           TextChanged="OnUppercaseTextChanged" Unfocused="OnOutwardVehicleNumberUnfocused" />
                                                    <Label x:Name="OutwardVehicleNumberErrorIcon" Grid.Column="2"
                                                           Text="{x:Static services:IconGlyphs.TriangleExclamation}"
                                                           Style="{StaticResource IconLabel}" TextColor="{StaticResource StatusException}"
                                                           FontSize="14" VerticalOptions="Center" IsVisible="False" />
                                                    <Label x:Name="OutwardVehicleNumberChevron" Grid.Column="2"
                                                           Text="{x:Static services:IconGlyphs.ChevronRight}" Style="{StaticResource IconLabel}"
                                                           FontSize="12" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                            <Button x:Name="OutwardVehicleNumberMicButton" SemanticProperties.Description="Speak vehicle number"
                                                    Grid.Column="1" Clicked="OnOutwardVehicleNumberMicClicked"
                                                    Style="{StaticResource ChipButton}" WidthRequest="50" HeightRequest="50"
                                                    CornerRadius="18" Padding="0" IsVisible="False">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                                </Button.ImageSource>
                                            </Button>
                                        </Grid>
                                        <Label x:Name="OutwardVehicleNumberErrorLabel" Text="This field is required." FontSize="11"
                                               TextColor="{StaticResource StatusException}" IsVisible="False" />
                                        <Label x:Name="OutwardVehicleNumberNotFoundLabel" Text="Not found in vehicle master - enter details below." FontSize="11"
                                               TextColor="{StaticResource TextSecondaryLight}" IsVisible="False" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="DISPATCH ORDER NUMBER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <Border x:Name="DispatchOrderNumberBorder" Grid.Column="0" Stroke="{StaticResource CardBorderLight}"
                                                    StrokeThickness="1.3" StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.ClipboardList}"
                                                           Style="{StaticResource IconLabel}" FontSize="14"
                                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                    <Entry x:Name="DispatchOrderNumberEntry" Grid.Column="1"
                                                           Placeholder="e.g. DO-1001" TextChanged="OnUppercaseTextChanged" />
                                                    <Label x:Name="DispatchOrderNumberErrorIcon" Grid.Column="2"
                                                           Text="{x:Static services:IconGlyphs.TriangleExclamation}"
                                                           Style="{StaticResource IconLabel}" TextColor="{StaticResource StatusException}"
                                                           FontSize="14" VerticalOptions="Center" IsVisible="False" />
                                                </Grid>
                                            </Border>
                                            <Button x:Name="DispatchOrderNumberMicButton" SemanticProperties.Description="Speak dispatch order number"
                                                    Grid.Column="1" Clicked="OnDispatchOrderNumberMicClicked"
                                                    Style="{StaticResource ChipButton}" WidthRequest="50" HeightRequest="50" CornerRadius="18" Padding="0">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                                </Button.ImageSource>
                                            </Button>
                                            <Button x:Name="DispatchOrderNumberScanButton" SemanticProperties.Description="Scan dispatch order barcode"
                                                    Grid.Column="2" Clicked="OnScanDispatchOrderNumberClicked"
                                                    Style="{StaticResource ChipButton}" WidthRequest="50" HeightRequest="50" CornerRadius="18" Padding="0">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.QrCode}" Color="{StaticResource Primary}" Size="13" />
                                                </Button.ImageSource>
                                            </Button>
                                        </Grid>
                                        <Label x:Name="DispatchOrderNumberErrorLabel" Text="This field is required." FontSize="11"
                                               TextColor="{StaticResource StatusException}" IsVisible="False" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="14">
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <Label Text="DRIVER NAME" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Border x:Name="OutwardDriverNameEntryBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.3"
                                                        StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.User}"
                                                               Style="{StaticResource IconLabel}" FontSize="14"
                                                               TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                        <Entry x:Name="OutwardDriverNameEntry" Grid.Column="1"
                                                               Placeholder="e.g. Ramesh Kumar"
                                                               Focused="OnOutwardDriverFieldFocused" Unfocused="OnOutwardDriverFieldUnfocused" />
                                                    </Grid>
                                                </Border>
                                                <Button x:Name="OutwardDriverNameMicButton" SemanticProperties.Description="Speak driver name"
                                                        Grid.Column="1" Clicked="OnOutwardDriverNameMicClicked"
                                                        Style="{StaticResource ChipButton}" WidthRequest="50" HeightRequest="50"
                                                        CornerRadius="18" Padding="0">
                                                    <Button.ImageSource>
                                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                                    </Button.ImageSource>
                                                </Button>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <Label Text="DRIVER MOBILE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Border x:Name="OutwardDriverMobileEntryBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.3"
                                                        StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.IdCard}"
                                                               Style="{StaticResource IconLabel}" FontSize="14"
                                                               TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                        <Entry x:Name="OutwardDriverMobileEntry" Grid.Column="1"
                                                               Placeholder="e.g. 9876543210" Keyboard="Telephone"
                                                               Focused="OnOutwardDriverFieldFocused" Unfocused="OnOutwardDriverFieldUnfocused" />
                                                    </Grid>
                                                </Border>
                                                <Button x:Name="OutwardDriverMobileMicButton" SemanticProperties.Description="Speak driver mobile"
                                                        Grid.Column="1" Clicked="OnOutwardDriverMobileMicClicked"
                                                        Style="{StaticResource ChipButton}" WidthRequest="50" HeightRequest="50"
                                                        CornerRadius="18" Padding="0">
                                                    <Button.ImageSource>
                                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                                    </Button.ImageSource>
                                                </Button>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <Label Text="TRANSPORTER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.3"
                                                    StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnOutwardTransporterFieldTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Truck}"
                                                           Style="{StaticResource IconLabel}" FontSize="14"
                                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                    <Label x:Name="OutwardTransporterLabel" Grid.Column="1" Text="Select transporter"
                                                           LineBreakMode="TailTruncation" TextColor="{StaticResource TextSecondaryLight}"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronRight}"
                                                           Style="{StaticResource IconLabel}" FontSize="12"
                                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <Label Text="GATE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                            <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1.3"
                                                    StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="50">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Warehouse}"
                                                           Style="{StaticResource IconLabel}" FontSize="14"
                                                           TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                                    <Picker x:Name="OutwardGatePicker" Grid.Column="1" Title="Select gate" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="GatePhotoCard" Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 22" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="20,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource CardTint}">
                                        <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                               FontSize="19" TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Vehicle at gate photo" Style="{StaticResource CardTitleLabel}" FontSize="18" />
                                        <Label Text="Optional evidence before outbound processing." Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="{StaticResource CardTint}" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 16" Padding="11,6" VerticalOptions="Start">
                                        <Label Text="Optional" FontSize="12" FontFamily="PoppinsSemiBold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                                <VerticalStackLayout Padding="20" Spacing="14">
                                    <Border StrokeThickness="0" BackgroundColor="{StaticResource SurfaceLight}"
                                            StrokeShape="RoundRectangle 18" Padding="12" MinimumHeightRequest="220">
                                        <Grid>
                                            <Image x:Name="OutwardGatePhotoImage" Aspect="AspectFill"
                                                   HeightRequest="198" IsVisible="False" />
                                            <VerticalStackLayout x:Name="OutwardGatePhotoPlaceholder"
                                                                 Spacing="12" VerticalOptions="Center"
                                                                 HorizontalOptions="Center">
                                                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource CardLight}">
                                                    <Label Text="{x:Static services:IconGlyphs.Camera}" Style="{StaticResource IconLabel}"
                                                           FontSize="22" TextColor="{StaticResource TextSecondaryLight}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Label Text="No photo captured" FontSize="14" FontFamily="PoppinsSemiBold"
                                                           TextColor="{StaticResource TextPrimaryLight}" HorizontalOptions="Center" />
                                                    <Label Text="Capture vehicle, seal, or gate view if needed."
                                                           FontSize="12" TextColor="{StaticResource TextSecondaryLight}"
                                                           HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="OutwardGatePhotoButton" Text="Capture Photo"
                                            Clicked="OnOutwardGatePhotoTapped"
                                            Style="{StaticResource IconTextButton}" CornerRadius="16" HeightRequest="50">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Camera}" Color="{StaticResource Primary}" Size="13" />
                                        </Button.ImageSource>
                                    </Button>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button x:Name="GateInSubmitButton" Text="Gate-Out Vehicle" Clicked="OnGateInSubmitClicked"
                            Style="{StaticResource PrimaryActionButton}" BackgroundColor="{StaticResource StatusSuccess}"
                            TextColor="White" CornerRadius="14" HeightRequest="50"
                            WidthRequest="220" HorizontalOptions="End" />

                    <ActivityIndicator x:Name="GateInSpinner" IsRunning="False" IsVisible="False" />

                    <Border x:Name="GateInResultBorder" IsVisible="False" Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="GateInResultIconLabel" Style="{StaticResource IconLabel}" FontSize="16" VerticalOptions="Start" />
                            <Label x:Name="GateInResultLabel" LineBreakMode="WordWrap" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GateInSuccessSection" Spacing="14" IsVisible="False">
                    <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                                   FontSize="28" TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" />
                            <Label Text="Gate-out recorded" Style="{StaticResource SectionTitleLabel}" HorizontalOptions="Center" />
                            <Label x:Name="GateInSuccessDetailLabel" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextSecondaryLight}" />
                            <HorizontalStackLayout x:Name="GateInSuccessBadgesContainer" Spacing="8" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Done" Clicked="OnGateInDoneClicked" Style="{StaticResource PrimaryActionButton}" CornerRadius="14" HeightRequest="50" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
