<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:WarehouseGate.Mobile.Services"
             xmlns:controls="clr-namespace:WarehouseGate.Mobile.Controls"
             x:Class="WarehouseGate.Mobile.Pages.SecurityHomePage"
             Title="Gate Check-In"
             Shell.BackButtonBehavior="{x:Null}"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceLight}">
    <Grid Grid.Row="0" BackgroundColor="Transparent">
        <controls:BackHeaderView PageTitle="Gate Check-In" Title="Register vehicle arrival and evidence" ShowBackButton="False"
                                 BackRoute="//SecurityTabs/SecurityDashboardPage" />
    </Grid>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="14,10,14,22" Spacing="14">

            <!-- ============================ FORM ============================ -->
            <VerticalStackLayout x:Name="FormSection" Spacing="16">

            <VerticalStackLayout x:Name="InwardCheckInSection" Spacing="16">

            <!-- Step navigation belongs to the page flow; the card below contains only the
                 currently selected step's fields. -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,4">
                        <Border x:Name="VehicleTabPill" Grid.Column="0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 18" Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVehicleTabClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="VehicleTabLabel" Text="VEHICLE" FontFamily="PoppinsSemiBold"
                                       FontSize="10" VerticalOptions="Center" />
                                <Label x:Name="VehicleTabErrorIcon" Text="{x:Static services:IconGlyphs.TriangleExclamation}"
                                       Style="{StaticResource IconLabel}" FontSize="9" TextColor="{StaticResource StatusException}"
                                       VerticalOptions="Center" IsVisible="False" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border x:Name="DocumentsTabPill" Grid.Column="1" StrokeThickness="0"
                                StrokeShape="RoundRectangle 18" Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDocumentsTabClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="DocumentsTabLabel" Text="DOCUMENTS" FontFamily="PoppinsSemiBold"
                                       FontSize="10" VerticalOptions="Center" />
                                <Label x:Name="DocumentsTabErrorIcon" Text="{x:Static services:IconGlyphs.TriangleExclamation}"
                                       Style="{StaticResource IconLabel}" FontSize="9" TextColor="{StaticResource StatusException}"
                                       VerticalOptions="Center" IsVisible="False" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border x:Name="PhotosTabPill" Grid.Column="2" StrokeThickness="0"
                                StrokeShape="RoundRectangle 18" Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPhotosTabClicked" />
                            </Border.GestureRecognizers>
                            <Label x:Name="PhotosTabLabel" Text="PHOTOS" FontFamily="PoppinsSemiBold"
                                   FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 18" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="0">

                    <!-- ============================ TAB 1: VEHICLE & DRIVER ============================ -->
                    <VerticalStackLayout x:Name="VehicleTabSection" Spacing="0" Padding="0">
                        <VerticalStackLayout Padding="20,18,20,16" Spacing="4">
                            <Label Text="Vehicle &amp; driver details" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                            <Label Text="Select the vehicle and record driver, transporter, and gate details."
                                   Style="{StaticResource MetaLabel}" FontSize="11" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                        <VerticalStackLayout Padding="20,18,20,20" Spacing="18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="VEHICLE NUMBER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                            <Border x:Name="VehiclePickerBorder" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="44">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVehicleFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                           FontSize="13" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    <Label x:Name="SelectedVehicleLabel" Grid.Column="1" Text="Select from vehicle records"
                                           TextColor="{StaticResource TextSecondaryLight}" FontSize="13"
                                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronDown}" Style="{StaticResource IconLabel}"
                                           FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Hidden backing field preserves the existing validation/submission flow.
                                 Search and new-value entry now live in the vehicle picker. -->
                            <Border x:Name="VehicleNumberBorder" IsVisible="False" HeightRequest="0" Padding="0"
                                    StrokeThickness="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Entry x:Name="VehicleNumberEntry" Grid.Column="1" Placeholder="Search or enter a new vehicle number"
                                           VerticalOptions="Center" TextChanged="OnVehicleNumberTextChanged" Unfocused="OnVehicleNumberUnfocused" />
                                </Grid>
                            </Border>
                            <Label x:Name="VehicleNumberErrorLabel" Text="Enter or select a vehicle number." FontSize="11"
                                   TextColor="{StaticResource StatusException}" IsVisible="False" />
                        </VerticalStackLayout>

                        <Grid x:Name="DriverFieldsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="14">
                            <VerticalStackLayout x:Name="DriverNameSection" Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Label Text="DRIVER NAME" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Border x:Name="DriverNameEntryBorder" Grid.Column="0" Stroke="{StaticResource CardBorderLight}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="42">
                                        <Entry x:Name="DriverNameEntry" Placeholder="e.g. Ramesh Kumar" VerticalOptions="Center"
                                               TextChanged="OnDriverNameTextChanged"
                                               Focused="OnDriverFieldFocused" Unfocused="OnDriverFieldUnfocused" />
                                    </Border>
                                    <Button x:Name="DriverNameMicButton" SemanticProperties.Description="Speak driver name" Grid.Column="1" Clicked="OnDriverNameMicClicked"
                                            Style="{StaticResource ChipButton}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="DriverMobileSection" Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="DRIVER MOBILE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Border x:Name="DriverMobileEntryBorder" Grid.Column="0" Stroke="{StaticResource CardBorderLight}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="42">
                                        <Entry x:Name="DriverMobileEntry" Placeholder="e.g. 9876543210" Keyboard="Telephone" MaxLength="10" VerticalOptions="Center"
                                               TextChanged="OnDriverMobileTextChanged"
                                               Focused="OnDriverFieldFocused" Unfocused="OnDriverFieldUnfocused" />
                                    </Border>
                                    <Button x:Name="DriverMobileMicButton" SemanticProperties.Description="Speak driver mobile" Grid.Column="1" Clicked="OnDriverMobileMicClicked"
                                            Style="{StaticResource ChipButton}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                                <Label x:Name="DriverMobileErrorLabel" Text="Enter a 10-digit mobile number." FontSize="11"
                                       TextColor="{StaticResource StatusException}" IsVisible="False" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid x:Name="TransporterGateFieldsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="14">
                            <VerticalStackLayout x:Name="TransporterSection" Grid.Row="0" Grid.Column="0" Spacing="8">
                                <Label Text="TRANSPORTER" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                <Border Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="44">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTransporterFieldTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{x:Static services:IconGlyphs.Truck}" Style="{StaticResource IconLabel}"
                                               FontSize="13" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                        <Label x:Name="SelectedTransporterLabel" Grid.Column="1" Text="Select from transporter records"
                                               TextColor="{StaticResource TextSecondaryLight}" FontSize="13"
                                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{x:Static services:IconGlyphs.ChevronDown}" Style="{StaticResource IconLabel}"
                                               FontSize="11" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Hidden backing field; selection and free-text entry are handled by the modal. -->
                                <Entry x:Name="TransporterEntry" IsVisible="False" HeightRequest="0" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="GateSection" Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="GATE" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                                <Picker x:Name="GatePicker" Title="Select gate" HeightRequest="42" />
                            </VerticalStackLayout>
                        </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ============================ TAB 2: DOCUMENTS ============================ -->
                    <VerticalStackLayout x:Name="DocumentsTabSection" Spacing="0" Padding="0" IsVisible="False">
                        <VerticalStackLayout Padding="20,18,20,16" Spacing="4">
                            <Label Text="Purchase orders &amp; inward transactions" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                            <Label Text="Auto-filled from the expected shipment — swipe for more, or add another PO." Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                        <VerticalStackLayout Padding="20,18,20,20" Spacing="18">
                        <VerticalStackLayout Spacing="8">

                            <VerticalStackLayout x:Name="PoTxnPairsContainer" Spacing="12" />

                            <Label x:Name="PoTxnErrorLabel" Text="Fill in every PO and inward transaction number, or remove the row." FontSize="11"
                                   TextColor="{StaticResource StatusException}" IsVisible="False" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Document scan / upload" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                            <Label Text="Optional — attach the e-way bill, invoice, or LR copy" Style="{StaticResource MetaLabel}" />
                            <ScrollView Orientation="Horizontal">
                                <HorizontalStackLayout x:Name="DocumentStrip" Spacing="8" />
                            </ScrollView>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10" Padding="12,0" HeightRequest="44">
                                    <Picker x:Name="DocumentTypePicker" Title="Document type" VerticalOptions="Center" />
                                </Border>
                                <Button x:Name="CaptureDocumentButton" Grid.Column="1" Text="Capture" Clicked="OnCaptureDocumentClicked"
                                        Style="{StaticResource IconTextButton}" HeightRequest="44" Padding="14,0">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Camera}" Color="{StaticResource Primary}" Size="13" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ============================ TAB 3: PHOTOS ============================ -->
                    <VerticalStackLayout x:Name="PhotosTabSection" Spacing="0" Padding="0" IsVisible="False">
                        <VerticalStackLayout Padding="20,18,20,16" Spacing="4">
                            <Label Text="Vehicle photos" Style="{StaticResource CardTitleLabel}" FontSize="16" />
                            <Label Text="Optional — capture each angle, the seal, and any visible damage" Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />

                        <VerticalStackLayout Padding="20,18,20,20" Spacing="16">
                        <Grid x:Name="PhotoSlotsGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="REMARKS (OPTIONAL)" Style="{StaticResource MetaLabel}" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border x:Name="RemarksEditorBorder" Grid.Column="0" Stroke="{StaticResource CardBorderLight}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,6">
                                    <Editor x:Name="RemarksEditor" Placeholder="Any notes about the vehicle or delivery"
                                            AutoSize="TextChanges" HeightRequest="68"
                                            Focused="OnRemarksFocused" Unfocused="OnRemarksUnfocused" />
                                </Border>
                                <Button x:Name="RemarksMicButton" SemanticProperties.Description="Speak remarks" Grid.Column="1" Clicked="OnRemarksMicClicked"
                                        Style="{StaticResource ChipButton}" WidthRequest="44" VerticalOptions="Start">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FaSolid" Glyph="{x:Static services:IconGlyphs.Microphone}" Color="{StaticResource Primary}" Size="13" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button x:Name="SubmitButton" Text="Next" Clicked="OnSubmitClicked"
                    Style="{StaticResource PrimaryActionButton}" BackgroundColor="{StaticResource Primary}"
                    TextColor="White" CornerRadius="14" HeightRequest="50"
                    WidthRequest="190" HorizontalOptions="End" />

            </VerticalStackLayout>

            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

            <Border x:Name="RecentSection" IsVisible="False"
                    BackgroundColor="{StaticResource CardLight}"
                    Stroke="{StaticResource CardBorderLight}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="20,18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                BackgroundColor="{StaticResource Secondary}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="{x:Static services:IconGlyphs.ClockRotateLeft}"
                                   Style="{StaticResource IconLabel}" FontSize="17"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Completed this session" Style="{StaticResource SectionTitleLabel}"
                                   FontSize="16" />
                            <Label Text="Most recent gate check-ins from this device"
                                   Style="{StaticResource MetaLabel}" FontSize="11" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2" BackgroundColor="{StaticResource Secondary}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                Padding="11,5" VerticalOptions="Center">
                            <Label x:Name="RecentCountLabel" Text="0"
                                   FontFamily="PoppinsSemiBold" FontSize="12"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderLight}" />
                    <VerticalStackLayout x:Name="RecentCheckInsContainer" Spacing="10" />
                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>

            <!-- ============================ SUCCESS RESULT ============================ -->
            <VerticalStackLayout x:Name="SuccessSection" Spacing="14" IsVisible="False">
                <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource CardTint}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="{x:Static services:IconGlyphs.CircleCheck}" Style="{StaticResource IconLabel}"
                               FontSize="28" TextColor="{StaticResource StatusSuccess}" HorizontalOptions="Center" />
                        <Label Text="Gate-in recorded" Style="{StaticResource SectionTitleLabel}" HorizontalOptions="Center" />
                        <Label x:Name="SuccessDetailLabel" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondaryLight}" />
                        <HorizontalStackLayout x:Name="SuccessBadgesContainer" Spacing="8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Back to Home" Clicked="OnBackToHomeClicked" Style="{StaticResource PrimaryActionButton}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <controls:ToastView x:Name="Toast" Grid.Row="1" />
    </Grid>
</ContentPage>
