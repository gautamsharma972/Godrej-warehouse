<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP (cleartext) traffic by default since API 28. The API is
  intentionally HTTP-only for local dev (see AppConfig.cs - HTTPS would fail cert
  validation against a physical device anyway), so cleartext is allowed here, but only
  for the specific dev hosts, not the whole app / production traffic.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.68</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
