<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>WarehouseGate.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>LogiFlow</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.warehousegate.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>

		<!-- The app supplies its own field surfaces and password visibility control. MAUI 10's
		     Material 3 Entry handler always adds an outlined box, floating hint, and password eye,
		     creating duplicate controls that cannot be disabled per Entry in this version. -->
		<UseMaterial3 Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseMaterial3>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android36.0|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android36.0|AnyCPU'">
	  <DebugSymbols>True</DebugSymbols>
	  <AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
	  <!-- Keep managed assemblies inside the debug APK. Fast deployment stores them in
	       the app-data override directory; when that payload becomes stale or incomplete,
	       Android can sit on the native splash while Mono searches for every assembly. -->
	  <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Remove="Resources\AppIcon\appicon.svg" />
		<MauiIcon Remove="Resources\AppIcon\appiconfg.svg" />
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="1254,1254" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\logiflow_brand_lockup.png" Color="#F8FBFE" BaseSize="1200,600" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom fonts. Keep aliases in MSBuild metadata as well as MauiProgram so
		     Android Shell icons and XAML FontImageSource controls resolve them during
		     native resource packaging. A wildcard leaves Alias blank in mauifont.inputs. -->
		<MauiFont Include="Resources\Fonts\Poppins-Regular.ttf" Alias="PoppinsRegular" />
		<MauiFont Include="Resources\Fonts\Poppins-Medium.ttf" Alias="PoppinsMedium" />
		<MauiFont Include="Resources\Fonts\Poppins-SemiBold.ttf" Alias="PoppinsSemiBold" />
		<MauiFont Include="Resources\Fonts\Poppins-Bold.ttf" Alias="PoppinsBold" />
		<MauiFont Include="Resources\Fonts\FontAwesome-Solid.ttf" Alias="FaSolid" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
		<!-- Was pinned at 0.6.0, several releases behind - that old version's own AndroidX.Tracing.Ktx
		     dependency (1.2.0.x) conflicted with the newer AndroidX.Tracing (1.3.0.1) that
		     Microsoft.Maui.Controls 10.0.90 resolves elsewhere, producing a duplicate-class D8/R8
		     dexing failure ("Type androidx.tracing...TraceKt$traceAsync$1 is defined multiple
		     times"). Bumping to the latest release realigns its own AndroidX dependency graph with
		     net10.0-android36.0/MAUI 10 instead of pinning individual transitive packages by hand. -->
		<PackageReference Include="ZXing.Net.MAUI.Controls" Version="0.10.3" />
	</ItemGroup>

</Project>
